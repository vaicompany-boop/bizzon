{
  "name": "bizzon",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "graphify:src": "rm -rf graphify-out && graphify extract src --out . && graphify cluster-only . --no-label",
    "graphify:report": "test -f graphify-out/GRAPH_REPORT.md && sed -n '1,220p' graphify-out/GRAPH_REPORT.md",
    "graphify:tools": "graphify query \"how are tool pages connected to src/data/tools.ts and the homepage?\" --graph graphify-out/graph.json --budget 1600",
    "graphify:adding-tool": "graphify query \"which files are involved when adding a new utility tool?\" --graph graphify-out/graph.json --budget 1600",
    "test:character-counter": "npm run build && node scripts/verify-character-counter.mjs",
    "test:text-cleaner": "npm run build && node scripts/verify-text-cleaner.mjs",
    "test:home-tools": "npm run build && node scripts/verify-home-tools-polish.mjs",
    "test:tool-schema": "npm run build && node scripts/verify-tool-webapplication-schema.mjs",
    "test:tool-seo": "npm run build && node scripts/verify-tool-seo-content.mjs",
    "test:support-pages": "npm run build && node scripts/verify-support-pages.mjs",
    "test:slug-generator": "npm run build && node scripts/verify-slug-generator.mjs",
    "test:meta-checker": "npm run build && node scripts/verify-meta-checker.mjs",
    "test:password-generator": "npm run build && node scripts/verify-password-generator.mjs",
    "test:random-picker": "npm run build && node scripts/verify-random-picker.mjs",
    "test:unit-converter": "npm run build && node scripts/verify-unit-converter.mjs",
    "test:date-calculator": "npm run build && node scripts/verify-date-calculator.mjs",
    "test:percentage-calculator": "npm run build && node scripts/verify-percentage-calculator.mjs",
    "test:filename-cleaner": "npm run build && node scripts/verify-filename-cleaner.mjs",
    "test:tip-calculator": "npm run build && node scripts/verify-tip-calculator.mjs",
    "test:vat-sales-tax-calculator": "npm run build && node scripts/verify-vat-sales-tax-calculator.mjs",
    "test:qr-code-generator": "npm run build && node scripts/verify-qr-code-generator.mjs",
    "test:invoice-maker": "npm run build && node scripts/verify-invoice-maker.mjs",
    "gsc:status": "node scripts/gsc-bizzon-status.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.4.0",
    "astro": "^6.4.2",
    "jspdf": "^4.2.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.0"
  }
}
