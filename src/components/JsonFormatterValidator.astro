<section class="rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm md:p-8" aria-labelledby="json-formatter-app">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-700">Browser-only JSON tool</p>
      <h2 id="json-formatter-app" class="mt-2 text-2xl font-black tracking-tight text-slate-950 md:text-3xl">Format, minify, and validate JSON</h2>
      <p class="mt-2 text-slate-600">Paste JSON or open a local .json file to make it readable, compact it for configs, or find the exact parse error without uploading anything.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <button id="sampleJsonFormatter" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Sample</button>
      <button id="formatJson" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Format</button>
      <button id="minifyJson" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Minify</button>
      <button id="copyFormattedJson" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Copy</button>
      <button id="downloadFormattedJson" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Download .json</button>
      <button id="clearJsonFormatter" type="button" class="rounded-full bg-slate-950 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700">Clear</button>
    </div>
  </div>

  <div class="mt-6 grid gap-5 lg:grid-cols-2">
    <div>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <label for="jsonFormatterInput" class="text-sm font-bold text-slate-700">JSON input</label>
        <label class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-600">
          Indent
          <select id="jsonIndent" class="bg-transparent font-semibold text-slate-800 outline-none">
            <option value="2">2 spaces</option>
            <option value="4">4 spaces</option>
            <option value="tab">Tab</option>
          </select>
        </label>
      </div>
      <div class="mt-3 rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-4">
        <label for="jsonFile" class="text-sm font-bold text-slate-700">Or choose a local JSON/text file</label>
        <input
          id="jsonFile"
          type="file"
          accept=".json,.txt,application/json,text/plain"
          class="mt-3 block w-full cursor-pointer rounded-2xl border border-slate-200 bg-white p-3 text-sm text-slate-700 file:mr-4 file:rounded-full file:border-0 file:bg-slate-950 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-blue-700"
        />
        <p class="mt-2 text-xs font-semibold text-slate-500">The file is read by your browser only. It is not uploaded to Bizzon.</p>
      </div>
      <textarea
        id="jsonFormatterInput"
        class="mt-3 min-h-[24rem] w-full resize-y rounded-3xl border border-slate-200 bg-slate-50 p-5 font-mono text-sm leading-6 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-400 focus:bg-white focus:ring-4 focus:ring-blue-100"
        placeholder='{"name":"Bizzon","tools":["CSV to JSON","JSON Formatter"],"private":true}'
        spellcheck="false"
      ></textarea>
    </div>

    <div>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm font-bold text-slate-700">Formatted output</p>
        <p id="jsonFormatterSummary" class="text-sm font-semibold text-slate-500" aria-live="polite">Paste JSON to validate it.</p>
      </div>
      <pre class="mt-3 min-h-[28rem] overflow-auto rounded-3xl border border-slate-200 bg-slate-950 p-5 text-sm leading-6 text-slate-50"><code id="jsonFormatterOutput"></code></pre>
      <p id="jsonFormatterStatus" class="mt-3 min-h-6 text-sm font-semibold text-blue-700" role="status"></p>
    </div>
  </div>

  <div class="mt-6 grid gap-4 rounded-3xl border border-blue-100 bg-blue-50 p-5 text-sm text-blue-950 md:grid-cols-3">
    <p><strong>Private:</strong> pasted JSON and chosen files stay in your browser.</p>
    <p><strong>Helpful errors:</strong> invalid JSON shows the browser parser message and approximate line/column when available.</p>
    <p><strong>Clean output:</strong> use formatted JSON for reading or minified JSON for compact configs.</p>
  </div>
</section>

<script>
  const input = document.getElementById('jsonFormatterInput') as HTMLTextAreaElement | null;
  const output = document.getElementById('jsonFormatterOutput');
  const summary = document.getElementById('jsonFormatterSummary');
  const status = document.getElementById('jsonFormatterStatus');
  const indentSelect = document.getElementById('jsonIndent') as HTMLSelectElement | null;
  const jsonFile = document.getElementById('jsonFile') as HTMLInputElement | null;
  const sampleButton = document.getElementById('sampleJsonFormatter');
  const formatButton = document.getElementById('formatJson');
  const minifyButton = document.getElementById('minifyJson');
  const copyButton = document.getElementById('copyFormattedJson');
  const downloadButton = document.getElementById('downloadFormattedJson');
  const clearButton = document.getElementById('clearJsonFormatter');

  const sampleJson = JSON.stringify({
    name: 'Bizzon',
    private: true,
    tools: ['CSV to JSON', 'JSON to CSV', 'JSON Formatter'],
    meta: { version: 1, updatedBy: 'browser' },
    notes: 'Quotes, commas, arrays, and nested objects stay valid.',
  });

  function getIndent() {
    const value = indentSelect?.value || '2';
    return value === 'tab' ? '\t' : Number(value);
  }

  function countNodes(value: unknown): { objects: number; arrays: number; keys: number } {
    const totals = { objects: 0, arrays: 0, keys: 0 };
    function walk(item: unknown) {
      if (Array.isArray(item)) {
        totals.arrays += 1;
        item.forEach(walk);
        return;
      }
      if (item && typeof item === 'object') {
        totals.objects += 1;
        const keys = Object.keys(item as Record<string, unknown>);
        totals.keys += keys.length;
        keys.forEach((key) => walk((item as Record<string, unknown>)[key]));
      }
    }
    walk(value);
    return totals;
  }

  function getLineColumn(text: string, position: number) {
    const safePosition = Math.max(0, Math.min(position, text.length));
    const before = text.slice(0, safePosition);
    const lines = before.split('\n');
    return { line: lines.length, column: lines[lines.length - 1].length + 1 };
  }

  function explainParseError(text: string, error: unknown) {
    const message = error instanceof Error ? error.message : 'Invalid JSON.';
    const positionMatch = message.match(/position (\d+)/i);
    if (!positionMatch) return message;
    const location = getLineColumn(text, Number(positionMatch[1]));
    return `${message} Near line ${location.line}, column ${location.column}.`;
  }

  function renderJson(mode: 'format' | 'minify' = 'format') {
    if (!input || !output || !summary) return;
    const text = input.value.trim();
    if (!text) {
      output.textContent = '';
      summary.textContent = 'Paste JSON to validate it.';
      if (status) status.textContent = '';
      return;
    }

    try {
      const parsed = JSON.parse(text) as unknown;
      const rendered = mode === 'minify' ? JSON.stringify(parsed) : JSON.stringify(parsed, null, getIndent());
      output.textContent = rendered;
      const totals = countNodes(parsed);
      const bytes = new Blob([rendered]).size;
      summary.textContent = `Valid JSON · ${totals.objects} ${totals.objects === 1 ? 'object' : 'objects'} · ${totals.arrays} ${totals.arrays === 1 ? 'array' : 'arrays'} · ${totals.keys} ${totals.keys === 1 ? 'key' : 'keys'} · ${bytes} bytes`;
      if (status) status.textContent = mode === 'minify' ? 'JSON minified.' : 'JSON formatted.';
    } catch (error) {
      output.textContent = '';
      summary.textContent = 'Invalid JSON.';
      if (status) status.textContent = explainParseError(text, error);
    }
  }

  input?.addEventListener('input', () => renderJson('format'));
  indentSelect?.addEventListener('change', () => renderJson('format'));

  jsonFile?.addEventListener('change', async () => {
    if (!input || !jsonFile || !status) return;
    const file = jsonFile.files?.[0];
    if (!file) return;
    try {
      status.textContent = `Reading ${file.name} locally...`;
      input.value = await file.text();
      renderJson('format');
      if (status && output?.textContent) status.textContent = `Loaded ${file.name} locally.`;
      input.focus();
    } catch {
      status.textContent = 'Could not read that file. Try opening it and pasting the JSON text instead.';
    }
  });

  sampleButton?.addEventListener('click', () => {
    if (!input) return;
    input.value = sampleJson;
    renderJson('format');
    input.focus();
  });

  formatButton?.addEventListener('click', () => renderJson('format'));
  minifyButton?.addEventListener('click', () => renderJson('minify'));

  clearButton?.addEventListener('click', () => {
    if (!input) return;
    input.value = '';
    if (jsonFile) jsonFile.value = '';
    renderJson('format');
    input.focus();
  });

  copyButton?.addEventListener('click', async () => {
    if (!output || !status) return;
    const rendered = output.textContent || '';
    if (!rendered) {
      status.textContent = 'Nothing to copy yet.';
      return;
    }
    try {
      status.textContent = 'Copying JSON...';
      await navigator.clipboard.writeText(rendered);
      status.textContent = 'JSON copied.';
    } catch {
      status.textContent = 'Copy blocked by browser. Select the output and copy manually.';
    }
  });

  downloadButton?.addEventListener('click', () => {
    if (!output || !status) return;
    const rendered = output.textContent || '';
    if (!rendered) {
      status.textContent = 'Nothing to download yet.';
      return;
    }
    const blob = new Blob([rendered], { type: 'application/json;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = 'bizzon-formatted-json.json';
    document.body.append(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);
    status.textContent = 'JSON download started.';
  });

  renderJson('format');
</script>
