<section class="rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm md:p-8" aria-labelledby="case-converter-app">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-700">Browser-only utility</p>
      <h2 id="case-converter-app" class="mt-2 text-2xl font-black tracking-tight text-slate-950 md:text-3xl">Paste text and choose a case</h2>
      <p class="mt-2 text-slate-600">Convert text instantly without uploading it. Everything runs locally in your browser.</p>
    </div>
    <div class="flex gap-3">
      <button id="sampleCaseText" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Sample</button>
      <button id="clearCaseText" type="button" class="rounded-full bg-slate-950 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700">Clear</button>
    </div>
  </div>

  <div class="mt-6 grid gap-5 lg:grid-cols-2">
    <div>
      <label for="caseInput" class="text-sm font-bold text-slate-700">Input text</label>
      <textarea
        id="caseInput"
        class="mt-2 min-h-80 w-full resize-y rounded-3xl border border-slate-200 bg-slate-50 p-5 text-base text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-400 focus:bg-white focus:ring-4 focus:ring-blue-100"
        placeholder="Type or paste text to convert..."
        spellcheck="true"
      ></textarea>
    </div>
    <div>
      <div class="flex items-center justify-between gap-3">
        <label for="caseOutput" class="text-sm font-bold text-slate-700">Converted output</label>
        <button id="copyCaseOutput" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Copy output</button>
      </div>
      <textarea
        id="caseOutput"
        class="mt-2 min-h-80 w-full resize-y rounded-3xl border border-slate-200 bg-slate-950 p-5 text-base text-white outline-none placeholder:text-slate-400 focus:border-blue-300 focus:ring-4 focus:ring-blue-100"
        placeholder="Converted text appears here..."
        readonly
      ></textarea>
      <p id="copyStatus" class="mt-2 min-h-5 text-sm font-semibold text-blue-700" aria-live="polite"></p>
    </div>
  </div>

  <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" role="group" aria-label="Case conversion options">
    <button data-case="lower" type="button" class="case-option rounded-2xl bg-blue-600 px-4 py-3 text-left font-bold text-white shadow-sm transition hover:bg-blue-700">lowercase</button>
    <button data-case="upper" type="button" class="case-option rounded-2xl bg-slate-100 px-4 py-3 text-left font-bold text-slate-900 transition hover:bg-blue-50 hover:text-blue-700">UPPERCASE</button>
    <button data-case="title" type="button" class="case-option rounded-2xl bg-slate-100 px-4 py-3 text-left font-bold text-slate-900 transition hover:bg-blue-50 hover:text-blue-700">Title Case</button>
    <button data-case="sentence" type="button" class="case-option rounded-2xl bg-slate-100 px-4 py-3 text-left font-bold text-slate-900 transition hover:bg-blue-50 hover:text-blue-700">Sentence case</button>
    <button data-case="camel" type="button" class="case-option rounded-2xl bg-slate-100 px-4 py-3 text-left font-bold text-slate-900 transition hover:bg-blue-50 hover:text-blue-700">camelCase</button>
    <button data-case="pascal" type="button" class="case-option rounded-2xl bg-slate-100 px-4 py-3 text-left font-bold text-slate-900 transition hover:bg-blue-50 hover:text-blue-700">PascalCase</button>
    <button data-case="kebab" type="button" class="case-option rounded-2xl bg-slate-100 px-4 py-3 text-left font-bold text-slate-900 transition hover:bg-blue-50 hover:text-blue-700">kebab-case</button>
    <button data-case="snake" type="button" class="case-option rounded-2xl bg-slate-100 px-4 py-3 text-left font-bold text-slate-900 transition hover:bg-blue-50 hover:text-blue-700">snake_case</button>
  </div>
</section>

<script>
  const input = document.getElementById('caseInput') as HTMLTextAreaElement | null;
  const output = document.getElementById('caseOutput') as HTMLTextAreaElement | null;
  const sampleButton = document.getElementById('sampleCaseText');
  const clearButton = document.getElementById('clearCaseText');
  const copyButton = document.getElementById('copyCaseOutput');
  const copyStatus = document.getElementById('copyStatus');
  const optionButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.case-option'));
  const sample = 'Bizzon helps you convert messy text into clean formats for titles, URLs, code names, and everyday writing.';
  let activeCase = 'lower';

  function words(text: string) {
    return text
      .normalize('NFKD')
      .replace(/[\u0300-\u036f]/g, '')
      .match(/[\p{L}\p{N}]+/gu) ?? [];
  }

  function capitalizeWord(word: string) {
    if (!word) return '';
    return word.charAt(0).toLocaleUpperCase() + word.slice(1).toLocaleLowerCase();
  }

  function toTitleCase(text: string) {
    return text.toLocaleLowerCase().replace(/[\p{L}\p{N}]+(?:['’-][\p{L}\p{N}]+)*/gu, (match) => capitalizeWord(match));
  }

  function toSentenceCase(text: string) {
    const lower = text.toLocaleLowerCase();
    return lower.replace(/(^\s*[\p{L}\p{N}])|([.!?]\s+[\p{L}\p{N}])/gu, (match) => match.toLocaleUpperCase());
  }

  function toCamelCase(text: string) {
    const parts = words(text).map((part) => part.toLocaleLowerCase());
    return parts.map((part, index) => (index === 0 ? part : capitalizeWord(part))).join('');
  }

  function convert(text: string, mode: string) {
    switch (mode) {
      case 'upper': return text.toLocaleUpperCase();
      case 'title': return toTitleCase(text);
      case 'sentence': return toSentenceCase(text);
      case 'camel': return toCamelCase(text);
      case 'pascal': return words(text).map((part) => capitalizeWord(part)).join('');
      case 'kebab': return words(text).map((part) => part.toLocaleLowerCase()).join('-');
      case 'snake': return words(text).map((part) => part.toLocaleLowerCase()).join('_');
      case 'lower':
      default: return text.toLocaleLowerCase();
    }
  }

  function setStatus(message = '') {
    if (copyStatus) copyStatus.textContent = message;
  }

  function render() {
    if (!input || !output) return;
    output.value = convert(input.value, activeCase);
    setStatus();
  }

  function updateActiveButton() {
    optionButtons.forEach((button) => {
      const isActive = button.dataset.case === activeCase;
      button.classList.toggle('bg-blue-600', isActive);
      button.classList.toggle('text-white', isActive);
      button.classList.toggle('shadow-sm', isActive);
      button.classList.toggle('bg-slate-100', !isActive);
      button.classList.toggle('text-slate-900', !isActive);
      button.setAttribute('aria-pressed', String(isActive));
    });
  }

  input?.addEventListener('input', render);
  sampleButton?.addEventListener('click', () => { if (!input) return; input.value = sample; render(); input.focus(); });
  clearButton?.addEventListener('click', () => { if (!input || !output) return; input.value = ''; output.value = ''; setStatus(); input.focus(); });
  optionButtons.forEach((button) => {
    button.addEventListener('click', () => {
      activeCase = button.dataset.case ?? 'lower';
      updateActiveButton();
      render();
    });
  });
  copyButton?.addEventListener('click', async () => {
    if (!output) return;
    try {
      await navigator.clipboard.writeText(output.value);
      setStatus(output.value ? 'Copied to clipboard.' : 'Nothing to copy yet.');
    } catch {
      output.select();
      document.execCommand('copy');
      setStatus(output.value ? 'Copied to clipboard.' : 'Nothing to copy yet.');
    }
  });

  updateActiveButton();
  render();
</script>
