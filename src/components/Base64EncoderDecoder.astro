<section class="rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm md:p-8" aria-labelledby="base64-tool-app">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-700">Browser-only converter</p>
      <h2 id="base64-tool-app" class="mt-2 text-2xl font-black tracking-tight text-slate-950 md:text-3xl">Encode and decode Base64 text or files</h2>
      <p class="mt-2 text-slate-600">Convert plain text to Base64, decode Base64 back to readable text, load a small local text file, and download the result without sending anything to a server.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <button id="sampleBase64" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Sample</button>
      <button id="encodeBase64" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Encode</button>
      <button id="decodeBase64" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Decode</button>
      <button id="copyBase64Output" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Copy</button>
      <button id="downloadBase64Output" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Download .txt</button>
      <button id="clearBase64" type="button" class="rounded-full bg-slate-950 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700">Clear</button>
    </div>
  </div>

  <div class="mt-6 grid gap-5 lg:grid-cols-2">
    <div>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <label for="base64Input" class="text-sm font-bold text-slate-700">Input</label>
        <p class="text-sm font-semibold text-slate-500">Plain text or Base64</p>
      </div>
      <div class="mt-3 rounded-3xl border border-dashed border-blue-200 bg-blue-50/70 p-4">
        <label for="base64File" class="text-sm font-bold text-blue-950">Open a local text file</label>
        <input
          id="base64File"
          type="file"
          accept=".txt,.text,.md,.csv,.json,.xml,.html,.css,.js,.ts,.svg,text/*,application/json,application/xml"
          class="mt-2 block w-full text-sm text-slate-700 file:mr-4 file:rounded-full file:border-0 file:bg-blue-700 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-blue-800"
        />
        <p id="base64FileHelp" class="mt-2 text-xs font-semibold text-blue-900">Files are read locally in your browser. Best for small text files up to about 1 MB.</p>
      </div>
      <textarea
        id="base64Input"
        class="mt-3 min-h-[26rem] w-full resize-y rounded-3xl border border-slate-200 bg-slate-50 p-5 font-mono text-sm leading-6 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-400 focus:bg-white focus:ring-4 focus:ring-blue-100"
        placeholder="Paste text to encode, or Base64 to decode..."
        spellcheck="false"
      ></textarea>
    </div>

    <div>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm font-bold text-slate-700">Output</p>
        <p id="base64Summary" class="text-sm font-semibold text-slate-500" aria-live="polite">Choose Encode or Decode.</p>
      </div>
      <pre class="mt-3 min-h-[26rem] overflow-auto whitespace-pre-wrap break-words rounded-3xl border border-slate-200 bg-slate-950 p-5 text-sm leading-6 text-slate-50"><code id="base64Output"></code></pre>
      <p id="base64Status" class="mt-3 min-h-6 text-sm font-semibold text-blue-700" role="status"></p>
    </div>
  </div>

  <div class="mt-6 grid gap-4 rounded-3xl border border-blue-100 bg-blue-50 p-5 text-sm text-blue-950 md:grid-cols-3">
    <p><strong>Private:</strong> pasted text and opened files are processed locally in your browser; nothing is uploaded.</p>
    <p><strong>Unicode-safe:</strong> emojis and accented characters are encoded with UTF-8 instead of old ASCII-only shortcuts.</p>
    <p><strong>Exportable:</strong> copy the result or download it as a simple `.txt` file for notes, fixtures, or config snippets.</p>
  </div>
</section>

<script>
  const input = document.getElementById('base64Input') as HTMLTextAreaElement | null;
  const output = document.getElementById('base64Output');
  const summary = document.getElementById('base64Summary');
  const status = document.getElementById('base64Status');
  const fileInput = document.getElementById('base64File') as HTMLInputElement | null;
  const sampleButton = document.getElementById('sampleBase64');
  const encodeButton = document.getElementById('encodeBase64');
  const decodeButton = document.getElementById('decodeBase64');
  const copyButton = document.getElementById('copyBase64Output');
  const downloadButton = document.getElementById('downloadBase64Output');
  const clearButton = document.getElementById('clearBase64');

  const sampleText = 'Bizzon tools stay in your browser. Unicode works: café, Sarajevo, 🚀';
  const encoder = new TextEncoder();
  const maxFileBytes = 1024 * 1024;
  let lastAction: 'encode' | 'decode' | null = null;
  let lastLoadedFileName = '';

  function setStatus(message: string, tone: 'ok' | 'error' = 'ok') {
    if (!status) return;
    status.textContent = message;
    status.className = `mt-3 min-h-6 text-sm font-semibold ${tone === 'error' ? 'text-red-700' : 'text-blue-700'}`;
  }

  function setResult(result: string, message: string, tone: 'ok' | 'error' = 'ok', action: 'encode' | 'decode' | null = null) {
    if (output) output.textContent = result;
    if (summary) summary.textContent = message;
    lastAction = action;
    setStatus(tone === 'error' ? message : '', tone);
  }

  function bytesToBase64(bytes: Uint8Array) {
    let binary = '';
    const chunkSize = 0x8000;
    for (let index = 0; index < bytes.length; index += chunkSize) {
      const chunk = bytes.subarray(index, index + chunkSize);
      binary += String.fromCharCode(...chunk);
    }
    return btoa(binary);
  }

  function base64ToBytes(value: string) {
    const clean = value.replace(/\s+/g, '');
    if (!clean) return new Uint8Array();
    if (clean.length % 4 === 1 || !/^[A-Za-z0-9+/]*={0,2}$/.test(clean) || /=/.test(clean.slice(0, -2))) {
      throw new Error('Invalid Base64. Check for missing characters, extra padding, or non-Base64 symbols.');
    }
    const binary = atob(clean);
    const bytes = new Uint8Array(binary.length);
    for (let index = 0; index < binary.length; index += 1) {
      bytes[index] = binary.charCodeAt(index);
    }
    return bytes;
  }

  function describeBytes(label: string, byteCount: number, charCount?: number) {
    const bytesLabel = `${byteCount} ${byteCount === 1 ? 'byte' : 'bytes'}`;
    if (typeof charCount === 'number') {
      return `${label} · ${charCount} ${charCount === 1 ? 'character' : 'characters'} · ${bytesLabel}`;
    }
    return `${label} · ${bytesLabel}`;
  }

  function encodeText() {
    if (!input) return;
    const text = input.value;
    if (!text) {
      setResult('', 'Enter text to encode.', 'error');
      return;
    }
    const bytes = encoder.encode(text);
    const encoded = bytesToBase64(bytes);
    setResult(encoded, describeBytes('Encoded to Base64', bytes.length, text.length), 'ok', 'encode');
  }

  function decodeText() {
    if (!input) return;
    const value = input.value.trim();
    if (!value) {
      setResult('', 'Enter Base64 to decode.', 'error');
      return;
    }
    try {
      const bytes = base64ToBytes(value);
      const decoded = new TextDecoder('utf-8', { fatal: true }).decode(bytes);
      setResult(decoded, describeBytes('Decoded from Base64', bytes.length, decoded.length), 'ok', 'decode');
    } catch (error) {
      const message = error instanceof Error && error.message.includes('Base64')
        ? error.message
        : 'Decoded bytes are not valid UTF-8 text. This tool is for text Base64, not arbitrary binary files.';
      setResult('', message, 'error');
    }
  }

  function safeDownloadName() {
    const suffix = lastAction === 'decode' ? 'decoded' : 'base64';
    const source = lastLoadedFileName ? lastLoadedFileName.replace(/\.[^.]+$/, '') : 'bizzon';
    return `${source.replace(/[^a-z0-9_-]+/gi, '-').replace(/^-+|-+$/g, '').toLowerCase() || 'bizzon'}-${suffix}.txt`;
  }

  async function loadSelectedFile() {
    if (!fileInput || !input) return;
    const file = fileInput.files?.[0];
    if (!file) return;
    if (file.size > maxFileBytes) {
      setResult('', `File is too large for this lightweight text tool (${Math.ceil(file.size / 1024)} KB). Use a file under 1 MB.`, 'error');
      fileInput.value = '';
      return;
    }
    try {
      const text = await file.text();
      input.value = text;
      lastLoadedFileName = file.name;
      setResult('', `Loaded ${file.name} · ${text.length} characters. Choose Encode or Decode.`);
      input.focus();
    } catch {
      setResult('', 'Could not read that file as text. Try a .txt, .json, .csv, .md, or similar text file.', 'error');
    }
  }

  sampleButton?.addEventListener('click', () => {
    if (!input) return;
    input.value = sampleText;
    lastLoadedFileName = '';
    if (fileInput) fileInput.value = '';
    encodeText();
    input.focus();
  });

  encodeButton?.addEventListener('click', encodeText);
  decodeButton?.addEventListener('click', decodeText);
  fileInput?.addEventListener('change', loadSelectedFile);

  clearButton?.addEventListener('click', () => {
    if (!input) return;
    input.value = '';
    if (fileInput) fileInput.value = '';
    lastLoadedFileName = '';
    setResult('', 'Choose Encode or Decode.');
    input.focus();
  });

  copyButton?.addEventListener('click', async () => {
    if (!output || !status) return;
    const text = output.textContent || '';
    if (!text) {
      setStatus('Nothing to copy yet.', 'error');
      return;
    }
    try {
      setStatus('Copying output...');
      await navigator.clipboard.writeText(text);
      setStatus('Output copied.');
    } catch {
      setStatus('Copy blocked by browser. Select the output and copy manually.', 'error');
    }
  });

  downloadButton?.addEventListener('click', () => {
    if (!output) return;
    const text = output.textContent || '';
    if (!text) {
      setStatus('Nothing to download yet.', 'error');
      return;
    }
    const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = safeDownloadName();
    document.body.appendChild(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);
    setStatus('Text download started.');
  });
</script>
