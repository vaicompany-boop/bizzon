---
import type { Tool } from '../data/tools';

type Props = { tool: Tool };
const { tool } = Astro.props;
const isLive = tool.status === 'live';

const cardClasses = [
  'group block rounded-3xl border bg-white p-6 shadow-sm',
  isLive
    ? 'border-blue-100 transition hover:-translate-y-1 hover:border-blue-200 hover:shadow-md focus:outline-none focus-visible:ring-4 focus-visible:ring-blue-200'
    : 'border-slate-200 opacity-80',
];
const badgeClasses = [
  'shrink-0 whitespace-nowrap rounded-full px-3 py-1 text-xs font-semibold',
  isLive ? 'bg-blue-50 text-blue-700' : 'bg-slate-100 text-slate-500',
];
---

{
  isLive ? (
    <a href={tool.href} class:list={cardClasses}>
      <div class="flex items-start justify-between gap-4">
        <h3 class="min-w-0 text-lg font-bold leading-tight text-slate-950 group-hover:text-blue-700">{tool.title}</h3>
        <span class:list={badgeClasses}>Live</span>
      </div>
      <p class="mt-3 text-sm leading-6 text-slate-600">{tool.description}</p>
    </a>
  ) : (
    <article class:list={cardClasses}>
      <div class="flex items-start justify-between gap-4">
        <h3 class="min-w-0 text-lg font-bold leading-tight text-slate-950">{tool.title}</h3>
        <span class:list={badgeClasses}>Planned</span>
      </div>
      <p class="mt-3 text-sm leading-6 text-slate-600">{tool.description}</p>
      <p class="mt-4 text-sm font-semibold text-slate-500">Not live yet — included only as roadmap context.</p>
    </article>
  )
}
