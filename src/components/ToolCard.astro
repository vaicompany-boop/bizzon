---
import type { Tool } from '../data/tools';
type Props = { tool: Tool };
const { tool } = Astro.props;
const isLive = tool.status === 'live';
---

<a href={tool.href} class:list={['group orbit-cut relative block min-h-44 border border-[#9db8c7] bg-[#f8fbfd] p-5 transition hover:-translate-y-1 hover:border-[#007d7a] hover:bg-[#e7f3f4]', !isLive && 'opacity-65']} aria-disabled={!isLive ? 'true' : undefined}>
  <span class="orbit-mono text-[.65rem] font-bold uppercase tracking-[.1em] text-[#007d7a]">{isLive ? 'Local / ready' : 'On the board'}</span>
  <span class="mt-5 block pr-7"><span class="orbit-display block text-2xl leading-[.92] text-slate-950 group-hover:text-[#007d7a]">{tool.title}</span></span>
  <span class="mt-3 block max-w-lg text-sm leading-6 text-slate-600">{tool.description}</span>
  <span class="absolute bottom-4 right-4 grid h-8 w-8 place-items-center border border-[#183b5b] bg-[#f4bf4f] text-[#183b5b] transition group-hover:bg-[#007d7a] group-hover:text-white" aria-hidden="true">↗</span>
</a>
