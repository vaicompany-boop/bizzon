<section class="rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm md:p-8" aria-labelledby="password-generator-app">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-700">Browser-only utility</p>
      <h2 id="password-generator-app" class="mt-2 text-2xl font-black tracking-tight text-slate-950 md:text-3xl">Generate a strong password</h2>
      <p class="mt-2 text-slate-600">Your password stays in your browser. Bizzon does not upload, store, or process it on a server.</p>
    </div>
    <div class="flex gap-3">
      <button id="generatePassword" type="button" class="rounded-full bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700">Generate</button>
      <button id="copyPassword" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Copy</button>
    </div>
  </div>

  <div class="mt-6">
    <label for="passwordOutput" class="text-sm font-bold text-slate-700">Generated password</label>
    <textarea
      id="passwordOutput"
      class="mt-2 min-h-28 w-full resize-y rounded-3xl border border-slate-200 bg-slate-950 p-5 font-mono text-xl text-white outline-none placeholder:text-slate-400 focus:border-blue-300 focus:ring-4 focus:ring-blue-100"
      placeholder="Generated password appears here"
      readonly
    ></textarea>
    <p id="passwordCopyStatus" class="mt-2 min-h-5 text-sm font-semibold text-blue-700" aria-live="polite"></p>
  </div>

  <div class="mt-6 grid gap-5 lg:grid-cols-[1.1fr_0.9fr]">
    <div class="rounded-3xl bg-slate-50 p-5">
      <div class="flex items-center justify-between gap-4">
        <label for="passwordLength" class="text-sm font-bold text-slate-700">Password length</label>
        <span id="passwordLengthValue" class="rounded-full bg-blue-50 px-3 py-1 text-sm font-black text-blue-700">20</span>
      </div>
      <input id="passwordLength" type="range" min="8" max="64" value="20" class="mt-4 w-full accent-blue-600" />
      <div class="mt-2 flex justify-between text-xs font-semibold text-slate-500"><span>8</span><span>64</span></div>
    </div>

    <div class="rounded-3xl bg-blue-50 p-5">
      <p class="text-sm font-semibold text-blue-700">Strength note</p>
      <p id="passwordStrengthNote" class="mt-2 text-lg font-black text-slate-950">Strong default for most accounts.</p>
      <p class="mt-2 text-sm text-slate-600">Use a unique password for every account and save it in a password manager.</p>
    </div>
  </div>

  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <label class="flex items-center gap-3 rounded-3xl bg-slate-50 p-5 text-sm font-bold text-slate-700">
      <input id="includeUppercase" type="checkbox" checked class="h-5 w-5 rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
      Uppercase A-Z
    </label>
    <label class="flex items-center gap-3 rounded-3xl bg-slate-50 p-5 text-sm font-bold text-slate-700">
      <input id="includeLowercase" type="checkbox" checked class="h-5 w-5 rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
      Lowercase a-z
    </label>
    <label class="flex items-center gap-3 rounded-3xl bg-slate-50 p-5 text-sm font-bold text-slate-700">
      <input id="includeNumbers" type="checkbox" checked class="h-5 w-5 rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
      Numbers 0-9
    </label>
    <label class="flex items-center gap-3 rounded-3xl bg-slate-50 p-5 text-sm font-bold text-slate-700">
      <input id="includeSymbols" type="checkbox" checked class="h-5 w-5 rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
      Symbols !@#$
    </label>
    <label class="flex items-center gap-3 rounded-3xl bg-slate-50 p-5 text-sm font-bold text-slate-700">
      <input id="avoidAmbiguous" type="checkbox" checked class="h-5 w-5 rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
      Avoid ambiguous characters
    </label>
    <button id="copyPasswordAgain" type="button" class="rounded-3xl border border-slate-300 bg-white p-5 text-left text-sm font-bold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Copy password again</button>
  </div>
</section>

<script>
  const output = document.getElementById('passwordOutput') as HTMLTextAreaElement | null;
  const lengthInput = document.getElementById('passwordLength') as HTMLInputElement | null;
  const lengthValue = document.getElementById('passwordLengthValue');
  const strengthNote = document.getElementById('passwordStrengthNote');
  const generateButton = document.getElementById('generatePassword');
  const copyButtons = [document.getElementById('copyPassword'), document.getElementById('copyPasswordAgain')].filter(Boolean);
  const copyStatus = document.getElementById('passwordCopyStatus');
  const options = {
    uppercase: document.getElementById('includeUppercase') as HTMLInputElement | null,
    lowercase: document.getElementById('includeLowercase') as HTMLInputElement | null,
    numbers: document.getElementById('includeNumbers') as HTMLInputElement | null,
    symbols: document.getElementById('includeSymbols') as HTMLInputElement | null,
    avoidAmbiguous: document.getElementById('avoidAmbiguous') as HTMLInputElement | null,
  };

  const sets = {
    uppercase: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
    lowercase: 'abcdefghijklmnopqrstuvwxyz',
    numbers: '0123456789',
    symbols: '!@#$%^&*()-_=+[]{};:,.?/',
  };
  const ambiguous = new Set('O0oIl1|`\'"'.split(''));

  function setStatus(message = '') {
    if (copyStatus) copyStatus.textContent = message;
  }

  function filterAmbiguous(chars: string) {
    if (!options.avoidAmbiguous?.checked) return chars;
    return chars.split('').filter((char) => !ambiguous.has(char)).join('');
  }

  function enabledSets() {
    const active = [] as string[];
    if (options.uppercase?.checked) active.push(filterAmbiguous(sets.uppercase));
    if (options.lowercase?.checked) active.push(filterAmbiguous(sets.lowercase));
    if (options.numbers?.checked) active.push(filterAmbiguous(sets.numbers));
    if (options.symbols?.checked) active.push(filterAmbiguous(sets.symbols));
    return active.filter(Boolean);
  }

  function randomIndex(max: number) {
    const values = new Uint32Array(1);
    window.crypto.getRandomValues(values);
    return values[0] % max;
  }

  function pick(chars: string) {
    return chars[randomIndex(chars.length)];
  }

  function shuffle(chars: string[]) {
    for (let index = chars.length - 1; index > 0; index -= 1) {
      const swapIndex = randomIndex(index + 1);
      [chars[index], chars[swapIndex]] = [chars[swapIndex], chars[index]];
    }
    return chars;
  }

  function updateStrength(length: number, setCount: number) {
    if (lengthValue) lengthValue.textContent = String(length);
    if (!strengthNote) return;
    if (setCount === 0) strengthNote.textContent = 'Choose at least one character type.';
    else if (length < 12) strengthNote.textContent = 'Short. Use at least 12 characters when possible.';
    else if (length < 16 || setCount < 3) strengthNote.textContent = 'Good, but longer with more character types is stronger.';
    else strengthNote.textContent = 'Strong default for most accounts.';
  }

  function generate() {
    if (!output || !lengthInput) return;
    const length = Number(lengthInput.value || 20);
    const activeSets = enabledSets();
    updateStrength(length, activeSets.length);
    if (!activeSets.length) {
      output.value = '';
      setStatus('Choose at least one character type.');
      return;
    }

    const allChars = activeSets.join('');
    const password = activeSets.map((chars) => pick(chars));
    while (password.length < length) password.push(pick(allChars));
    output.value = shuffle(password).join('');
    setStatus();
  }

  async function copyPassword() {
    if (!output) return;
    try {
      await navigator.clipboard.writeText(output.value);
      setStatus(output.value ? 'Copied to clipboard.' : 'Nothing to copy yet.');
    } catch {
      output.select();
      document.execCommand('copy');
      setStatus(output.value ? 'Copied to clipboard.' : 'Nothing to copy yet.');
    }
  }

  lengthInput?.addEventListener('input', generate);
  Object.values(options).forEach((checkbox) => checkbox?.addEventListener('change', generate));
  generateButton?.addEventListener('click', generate);
  copyButtons.forEach((button) => button?.addEventListener('click', copyPassword));
  generate();
</script>
