<section class="rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm md:p-8" aria-labelledby="unit-converter-app">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-700">Browser-only utility</p>
      <h2 id="unit-converter-app" class="mt-2 text-2xl font-black tracking-tight text-slate-950 md:text-3xl">Convert length, weight, and temperature</h2>
      <p class="mt-2 text-slate-600">Every conversion happens locally in your browser. No account, upload, or server processing.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <button id="sampleConverter" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Sample</button>
      <button id="clearConverter" type="button" class="rounded-full bg-slate-950 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700">Clear</button>
    </div>
  </div>

  <div class="mt-6 grid gap-5 lg:grid-cols-[1fr_auto_1fr] lg:items-end">
    <div>
      <label for="converterCategory" class="text-sm font-bold text-slate-700">Category</label>
      <select id="converterCategory" class="mt-2 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100">
        <option value="length">Length</option>
        <option value="weight">Weight</option>
        <option value="temperature">Temperature</option>
      </select>
    </div>
    <div class="hidden lg:block"></div>
    <div class="rounded-2xl bg-blue-50 px-4 py-3 text-sm font-semibold text-blue-800" id="converterHint" aria-live="polite">Length conversions use meters as the base unit.</div>
  </div>

  <div class="mt-5 grid gap-5 lg:grid-cols-[1fr_auto_1fr] lg:items-center">
    <div class="rounded-3xl bg-slate-50 p-5">
      <label for="converterInput" class="text-sm font-bold text-slate-700">From</label>
      <input id="converterInput" type="number" step="any" inputmode="decimal" value="1" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-2xl font-black text-slate-950 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100" />
      <select id="fromUnit" class="mt-3 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100"></select>
    </div>

    <button id="swapUnits" type="button" class="mx-auto rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-700 shadow-sm transition hover:border-blue-300 hover:text-blue-700" aria-label="Swap units">⇄ Swap</button>

    <div class="rounded-3xl bg-slate-950 p-5 text-white">
      <label for="converterOutput" class="text-sm font-bold text-slate-300">To</label>
      <input id="converterOutput" type="text" readonly class="mt-2 w-full rounded-2xl border border-slate-700 bg-slate-900 px-4 py-3 text-2xl font-black text-white outline-none" />
      <select id="toUnit" class="mt-3 w-full rounded-2xl border border-slate-700 bg-slate-900 px-4 py-3 font-semibold text-white outline-none transition focus:border-blue-300 focus:ring-4 focus:ring-blue-900"></select>
    </div>
  </div>

  <div class="mt-6 grid gap-4 md:grid-cols-3" aria-live="polite">
    <div class="rounded-3xl bg-blue-600 p-5 text-white"><p class="text-sm font-semibold text-blue-100">Current category</p><p id="currentCategory" class="mt-2 text-2xl font-black">Length</p></div>
    <div class="rounded-3xl bg-slate-100 p-5"><p class="text-sm font-semibold text-slate-500">Formula</p><p id="formulaNote" class="mt-2 text-lg font-black text-slate-950">1 meter = 3.28084 feet</p></div>
    <div class="rounded-3xl bg-amber-100 p-5"><p class="text-sm font-semibold text-amber-700">Precision</p><p class="mt-2 text-lg font-black text-slate-950">Rounded to 6 useful decimals</p></div>
  </div>
</section>

<script>
  type Unit = { label: string; value: string; factor?: number };
  const categories: Record<string, { label: string; hint: string; formula: string; units: Unit[] }> = {
    length: {
      label: 'Length',
      hint: 'Length conversions use meters as the base unit.',
      formula: '1 meter = 3.28084 feet',
      units: [
        { label: 'meters', value: 'meters', factor: 1 },
        { label: 'kilometers', value: 'kilometers', factor: 1000 },
        { label: 'centimeters', value: 'centimeters', factor: 0.01 },
        { label: 'millimeters', value: 'millimeters', factor: 0.001 },
        { label: 'feet', value: 'feet', factor: 0.3048 },
        { label: 'inches', value: 'inches', factor: 0.0254 },
        { label: 'miles', value: 'miles', factor: 1609.344 },
      ],
    },
    weight: {
      label: 'Weight',
      hint: 'Weight conversions use kilograms as the base unit.',
      formula: '1 kilogram = 2.20462 pounds',
      units: [
        { label: 'kilograms', value: 'kilograms', factor: 1 },
        { label: 'grams', value: 'grams', factor: 0.001 },
        { label: 'milligrams', value: 'milligrams', factor: 0.000001 },
        { label: 'pounds', value: 'pounds', factor: 0.45359237 },
        { label: 'ounces', value: 'ounces', factor: 0.028349523125 },
      ],
    },
    temperature: {
      label: 'Temperature',
      hint: 'Temperature conversions use direct Celsius, Fahrenheit, and Kelvin formulas.',
      formula: '°F = °C × 9/5 + 32',
      units: [
        { label: 'celsius', value: 'celsius' },
        { label: 'fahrenheit', value: 'fahrenheit' },
        { label: 'kelvin', value: 'kelvin' },
      ],
    },
  };

  const categorySelect = document.getElementById('converterCategory') as HTMLSelectElement | null;
  const input = document.getElementById('converterInput') as HTMLInputElement | null;
  const output = document.getElementById('converterOutput') as HTMLInputElement | null;
  const fromUnit = document.getElementById('fromUnit') as HTMLSelectElement | null;
  const toUnit = document.getElementById('toUnit') as HTMLSelectElement | null;
  const swapButton = document.getElementById('swapUnits');
  const clearButton = document.getElementById('clearConverter');
  const sampleButton = document.getElementById('sampleConverter');
  const hint = document.getElementById('converterHint');
  const currentCategory = document.getElementById('currentCategory');
  const formulaNote = document.getElementById('formulaNote');

  function round(value: number) {
    if (!Number.isFinite(value)) return '';
    return Number.parseFloat(value.toFixed(6)).toString();
  }

  function toCelsius(value: number, unit: string) {
    if (unit === 'fahrenheit') return (value - 32) * 5 / 9;
    if (unit === 'kelvin') return value - 273.15;
    return value;
  }

  function fromCelsius(value: number, unit: string) {
    if (unit === 'fahrenheit') return value * 9 / 5 + 32;
    if (unit === 'kelvin') return value + 273.15;
    return value;
  }

  function populateUnits(previousFrom?: string, previousTo?: string) {
    if (!categorySelect || !fromUnit || !toUnit) return;
    const config = categories[categorySelect.value];
    const options = config.units.map((unit) => `<option value="${unit.value}">${unit.label}</option>`).join('');
    fromUnit.innerHTML = options;
    toUnit.innerHTML = options;
    fromUnit.value = previousFrom && config.units.some((unit) => unit.value === previousFrom) ? previousFrom : config.units[0].value;
    toUnit.value = previousTo && config.units.some((unit) => unit.value === previousTo) ? previousTo : config.units[Math.min(1, config.units.length - 1)].value;
    if (hint) hint.textContent = config.hint;
    if (currentCategory) currentCategory.textContent = config.label;
    if (formulaNote) formulaNote.textContent = config.formula;
  }

  function convert() {
    if (!categorySelect || !input || !output || !fromUnit || !toUnit) return;
    const value = Number(input.value);
    if (!Number.isFinite(value)) { output.value = ''; return; }
    const config = categories[categorySelect.value];
    if (categorySelect.value === 'temperature') {
      output.value = round(fromCelsius(toCelsius(value, fromUnit.value), toUnit.value));
      return;
    }
    const from = config.units.find((unit) => unit.value === fromUnit.value);
    const to = config.units.find((unit) => unit.value === toUnit.value);
    if (!from?.factor || !to?.factor) { output.value = ''; return; }
    output.value = round((value * from.factor) / to.factor);
  }

  categorySelect?.addEventListener('change', () => { populateUnits(); convert(); });
  input?.addEventListener('input', convert);
  fromUnit?.addEventListener('change', convert);
  toUnit?.addEventListener('change', convert);
  swapButton?.addEventListener('click', () => {
    if (!fromUnit || !toUnit || !input || !output) return;
    const oldFrom = fromUnit.value;
    fromUnit.value = toUnit.value;
    toUnit.value = oldFrom;
    input.value = output.value || input.value;
    convert();
  });
  sampleButton?.addEventListener('click', () => {
    if (!categorySelect || !input) return;
    categorySelect.value = 'temperature';
    populateUnits('celsius', 'fahrenheit');
    input.value = '25';
    convert();
  });
  clearButton?.addEventListener('click', () => { if (!input || !output) return; input.value = ''; output.value = ''; input.focus(); });

  populateUnits();
  convert();
</script>
