---
const navItems = [
  { href: '/tools', label: 'Tools' },
  { href: '/tools#categories-heading', label: 'Categories' },
  { href: '/private-browser-tools', label: 'Privacy' },
];
---

<header class="sticky top-0 z-30 border-b border-[#101a33]/15 bg-[#faf5ea]/92 backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-5 sm:py-4">
    <a href="/" class="flex items-center font-serif text-3xl font-black leading-none text-[#07132d] sm:text-4xl" aria-label="Bizzon home">
      Bizzon
    </a>
    <nav class="hidden items-center gap-8 text-base font-medium text-[#07132d] md:flex" aria-label="Main navigation">
      {navItems.map((item) => (
        <a class="transition hover:text-[#df2b1f]" href={item.href}>{item.label}</a>
      ))}
    </nav>
    <a class="rounded-md border border-[#07132d]/20 bg-[#df2b1f] px-3 py-2 text-sm font-semibold text-white shadow-[3px_3px_0_#07132d] transition hover:-translate-y-0.5 hover:bg-[#c72218] hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1267c9] sm:px-4" href="/tools">
      Browse tools
    </a>
  </div>
  <nav class="mx-auto flex max-w-6xl gap-2 overflow-x-auto px-4 pb-3 text-sm font-semibold text-[#07132d] md:hidden" aria-label="Mobile navigation">
    {navItems.map((item) => (
      <a class="shrink-0 rounded-md border border-[#07132d]/20 bg-white/70 px-3 py-1.5 transition hover:border-[#df2b1f] hover:text-[#df2b1f]" href={item.href}>{item.label}</a>
    ))}
  </nav>
</header>
