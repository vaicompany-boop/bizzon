---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/tools', label: 'Tools' },
  { href: '/text-cleaner', label: 'Text Cleaner' },
  { href: '/password-generator', label: 'Passwords' },
  { href: '/qr-code-generator', label: 'QR Codes' },
  { href: '/vat-sales-tax-calculator', label: 'VAT' },
];
---

<header class="sticky top-0 z-30 border-b border-slate-200/80 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4">
    <a href="/" class="flex items-center font-semibold text-slate-950" aria-label="Bizzon home">
      <img src="/logo-wordmark.png" alt="Bizzon.app" class="h-9 w-auto max-w-[13rem] object-contain sm:h-10 sm:max-w-[15rem]" width="1020" height="246" loading="eager" decoding="async" />
    </a>
    <nav class="hidden items-center gap-5 text-sm font-medium text-slate-600 lg:flex" aria-label="Main navigation">
      {navItems.map((item) => (
        <a class="transition hover:text-blue-700" href={item.href}>{item.label}</a>
      ))}
    </nav>
    <a class="rounded-full bg-slate-950 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 hover:text-white" href="/tools">
      Open tools
    </a>
  </div>
  <nav class="mx-auto flex max-w-6xl gap-2 overflow-x-auto px-5 pb-3 text-sm font-semibold text-slate-600 lg:hidden" aria-label="Mobile navigation">
    {navItems.map((item) => (
      <a class="shrink-0 rounded-full border border-slate-200 bg-white px-3 py-1.5 transition hover:border-blue-200 hover:text-blue-700" href={item.href}>{item.label}</a>
    ))}
  </nav>
</header>
