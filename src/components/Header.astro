---
const navItems = [
  { href: '/tools', label: 'All tools' },
  { href: '/word-counter', label: 'Text' },
  { href: '/vat-sales-tax-calculator', label: 'Numbers' },
  { href: '/qr-code-generator', label: 'Make' },
];
---

<header class="border-b border-[#9db8c7] bg-[#f8fbfd]">
  <div class="mx-auto grid max-w-6xl gap-3 px-5 py-4 md:grid-cols-[auto_1fr_auto] md:items-center">
    <a href="/" class="flex items-center" aria-label="Bizzon home">
      <img src="/logo-wordmark.png" alt="Bizzon.app" class="h-8 w-auto max-w-[10rem] object-contain sm:h-9" width="1020" height="246" loading="eager" decoding="async" />
    </a>
    <nav class="flex gap-x-5 overflow-x-auto border-y border-[#9db8c7] py-2 text-xs font-bold uppercase tracking-[.08em] text-slate-800 md:justify-center md:border-y-0 md:py-0" aria-label="Main navigation">
      {navItems.map((item, index) => <a class="shrink-0 transition hover:text-[#007d7a]" href={item.href}><span class="mr-1 orbit-mono text-[.62rem] text-[#007d7a]">0{index + 1}</span>{item.label}</a>)}
    </nav>
    <a class="orbit-pill justify-self-start bg-[#f4bf4f] px-4 py-2 text-sm font-bold text-slate-950 transition hover:bg-[#b9d8d4] md:justify-self-end" href="/tools">Open library <span aria-hidden="true">↗</span></a>
  </div>
</header>
