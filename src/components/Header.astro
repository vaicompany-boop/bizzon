---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/tools', label: 'Tools' },
  { href: '/word-counter', label: 'Word Counter' },
];
---

<header class="border-b border-slate-200/80 bg-white/85 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
    <a href="/" class="flex items-center gap-3 font-semibold text-slate-950" aria-label="Bizzon home">
      <span class="grid size-10 place-items-center rounded-2xl bg-blue-600 text-lg font-black text-white shadow-sm">B</span>
      <span class="text-xl tracking-tight">Bizzon</span>
    </a>
    <nav class="hidden items-center gap-6 text-sm font-medium text-slate-600 sm:flex" aria-label="Main navigation">
      {navItems.map((item) => (
        <a class="transition hover:text-blue-700" href={item.href}>{item.label}</a>
      ))}
    </nav>
    <a class="rounded-full bg-slate-950 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 hover:text-white" href="/tools">
      Open tools
    </a>
  </div>
</header>
