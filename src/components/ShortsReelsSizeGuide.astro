<section class="rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm md:p-8" aria-labelledby="shorts-size-guide-app">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-700">Browser-only creator guide</p>
      <h2 id="shorts-size-guide-app" class="mt-2 text-2xl font-black tracking-tight text-slate-950 md:text-3xl">Check vertical video size</h2>
      <p class="mt-2 text-slate-600">Compare your Shorts, Reels, or TikTok export against common 9:16 dimensions before posting.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <button id="sampleShortsSize" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Sample 1080 × 1920</button>
      <button id="copyShortsSize" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Copy checklist</button>
      <button id="clearShortsSize" type="button" class="rounded-full bg-slate-950 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700">Clear</button>
    </div>
  </div>

  <div class="mt-6 grid gap-5 lg:grid-cols-[1fr_1.2fr]">
    <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="text-sm font-bold text-slate-700" for="shortsWidth">
          Width (px)
          <input id="shortsWidth" type="number" min="1" inputmode="numeric" placeholder="1080" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100" />
        </label>
        <label class="text-sm font-bold text-slate-700" for="shortsHeight">
          Height (px)
          <input id="shortsHeight" type="number" min="1" inputmode="numeric" placeholder="1920" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100" />
        </label>
      </div>

      <label class="mt-4 block text-sm font-bold text-slate-700" for="shortsPreset">
        Platform preset
        <select id="shortsPreset" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100">
          <option value="shorts">YouTube Shorts</option>
          <option value="reels">Instagram Reels</option>
          <option value="tiktok">TikTok</option>
        </select>
      </label>

      <label class="mt-4 block text-sm font-bold text-slate-700" for="shortsDuration">
        Duration (seconds, optional)
        <input id="shortsDuration" type="number" min="0" inputmode="numeric" placeholder="30" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100" />
      </label>

      <p id="shortsSizeStatus" class="mt-4 min-h-6 text-sm font-semibold text-blue-700" role="status" aria-live="polite">Enter a width and height to check the aspect ratio locally.</p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div id="ratioCard" class="rounded-3xl bg-blue-600 p-5 text-white">
        <p class="text-sm font-semibold text-blue-100">Result</p>
        <p id="ratioResult" class="mt-2 text-3xl font-black">Ready</p>
        <p id="ratioDetail" class="mt-2 text-sm text-blue-50">Ideal vertical exports are 9:16.</p>
      </div>
      <div class="rounded-3xl bg-slate-100 p-5">
        <p class="text-sm font-semibold text-slate-500">Aspect ratio</p>
        <p id="aspectRatioValue" class="mt-2 text-3xl font-black text-slate-950">—</p>
        <p id="aspectRatioDecimal" class="mt-2 text-sm text-slate-600">Width ÷ height</p>
      </div>
      <div class="rounded-3xl bg-slate-100 p-5">
        <p class="text-sm font-semibold text-slate-500">Recommended size</p>
        <p class="mt-2 text-3xl font-black text-slate-950">1080×1920</p>
        <p class="mt-2 text-sm text-slate-600">9:16 vertical, also exportable at 720×1280 or 2160×3840.</p>
      </div>
      <div class="rounded-3xl bg-slate-100 p-5">
        <p class="text-sm font-semibold text-slate-500">Safe area reminder</p>
        <p id="safeAreaValue" class="mt-2 text-3xl font-black text-slate-950">10%</p>
        <p class="mt-2 text-sm text-slate-600">Keep captions, logos, and faces away from the edges and bottom UI area.</p>
      </div>
    </div>
  </div>

  <div class="mt-6 rounded-3xl border border-slate-200 bg-slate-50 p-5">
    <p class="text-sm font-bold text-slate-700">Copy-ready checklist</p>
    <textarea id="shortsChecklist" class="mt-3 min-h-40 w-full resize-y rounded-3xl border border-slate-200 bg-white p-5 font-mono text-sm leading-7 text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100" readonly placeholder="Checklist appears here..."></textarea>
  </div>

  <div class="mt-6 grid gap-4 rounded-3xl border border-blue-100 bg-blue-50 p-5 text-sm text-blue-950 md:grid-cols-3">
    <p><strong>Size:</strong> use 1080 × 1920 px for a clean 9:16 vertical export.</p>
    <p><strong>Format:</strong> MP4/H.264 is a safe default for most editors and platforms.</p>
    <p><strong>Safe area:</strong> keep important text away from app buttons, captions, and crop edges.</p>
  </div>
</section>

<script>
  const widthInput = document.getElementById('shortsWidth') as HTMLInputElement | null;
  const heightInput = document.getElementById('shortsHeight') as HTMLInputElement | null;
  const durationInput = document.getElementById('shortsDuration') as HTMLInputElement | null;
  const presetInput = document.getElementById('shortsPreset') as HTMLSelectElement | null;
  const sampleButton = document.getElementById('sampleShortsSize');
  const copyButton = document.getElementById('copyShortsSize');
  const clearButton = document.getElementById('clearShortsSize');
  const status = document.getElementById('shortsSizeStatus');
  const ratioCard = document.getElementById('ratioCard');
  const ratioResult = document.getElementById('ratioResult');
  const ratioDetail = document.getElementById('ratioDetail');
  const aspectRatioValue = document.getElementById('aspectRatioValue');
  const aspectRatioDecimal = document.getElementById('aspectRatioDecimal');
  const safeAreaValue = document.getElementById('safeAreaValue');
  const checklist = document.getElementById('shortsChecklist') as HTMLTextAreaElement | null;

  const platformNotes: Record<string, { label: string; duration: string; safeArea: string }> = {
    shorts: { label: 'YouTube Shorts', duration: 'Short vertical clips commonly perform best when they get to the point quickly; YouTube supports Shorts up to its current platform limit.', safeArea: '10%' },
    reels: { label: 'Instagram Reels', duration: 'Keep on-screen text readable and test the cover crop for profile/grid previews.', safeArea: '12%' },
    tiktok: { label: 'TikTok', duration: 'Avoid putting key text under the right-side action rail or lower caption area.', safeArea: '14%' },
  };

  function gcd(a: number, b: number): number {
    while (b) {
      const next = a % b;
      a = b;
      b = next;
    }
    return a;
  }

  function numberValue(input: HTMLInputElement | null) {
    const value = Number(input?.value ?? 0);
    return Number.isFinite(value) && value > 0 ? Math.round(value) : 0;
  }

  function setCard(state: 'ready' | 'good' | 'warn' | 'bad') {
    if (!ratioCard) return;
    const classes = {
      ready: 'rounded-3xl bg-blue-600 p-5 text-white',
      good: 'rounded-3xl bg-emerald-600 p-5 text-white',
      warn: 'rounded-3xl bg-amber-500 p-5 text-white',
      bad: 'rounded-3xl bg-red-600 p-5 text-white',
    };
    ratioCard.className = classes[state];
  }

  function render() {
    const width = numberValue(widthInput);
    const height = numberValue(heightInput);
    const duration = numberValue(durationInput);
    const preset = platformNotes[presetInput?.value ?? 'shorts'] ?? platformNotes.shorts;
    if (safeAreaValue) safeAreaValue.textContent = preset.safeArea;

    if (!width || !height) {
      if (ratioResult) ratioResult.textContent = 'Ready';
      if (ratioDetail) ratioDetail.textContent = 'Ideal vertical exports are 9:16.';
      if (aspectRatioValue) aspectRatioValue.textContent = '—';
      if (aspectRatioDecimal) aspectRatioDecimal.textContent = 'Width ÷ height';
      if (checklist) checklist.value = '';
      if (status) status.textContent = 'Enter a width and height to check the aspect ratio locally.';
      setCard('ready');
      return;
    }

    const divisor = gcd(width, height);
    const simplified = `${width / divisor}:${height / divisor}`;
    const decimal = width / height;
    const target = 9 / 16;
    const diffPercent = Math.abs(decimal - target) / target * 100;
    const isVertical = height > width;
    const isIdealRatio = diffPercent <= 1;
    const isRecommendedPixels = width >= 1080 && height >= 1920;
    const label = isIdealRatio && isVertical ? '9:16 match' : isVertical ? 'Vertical, check crop' : 'Not vertical';
    const detail = !isVertical
      ? 'Use a taller canvas for Shorts/Reels/TikTok: 1080 × 1920 is the practical default.'
      : isIdealRatio
        ? isRecommendedPixels
          ? 'Great: this is a vertical 9:16 export at or above the common 1080p recommendation.'
          : 'The ratio is right, but consider exporting at 1080 × 1920 for sharper uploads.'
        : 'This is vertical but not exactly 9:16. It may be cropped or padded by the platform.';

    if (ratioResult) ratioResult.textContent = label;
    if (ratioDetail) ratioDetail.textContent = detail;
    if (aspectRatioValue) aspectRatioValue.textContent = simplified;
    if (aspectRatioDecimal) aspectRatioDecimal.textContent = `${decimal.toFixed(4)} ratio · ${diffPercent.toFixed(1)}% from 9:16`;
    if (status) status.textContent = `${preset.label}: ${detail}`;
    setCard(!isVertical ? 'bad' : isIdealRatio && isRecommendedPixels ? 'good' : 'warn');

    if (checklist) {
      checklist.value = [
        `${preset.label} vertical video checklist`,
        `Canvas: ${width} × ${height} px (${simplified}, ${decimal.toFixed(4)})`,
        `Recommended target: 1080 × 1920 px, 9:16 vertical`,
        `Status: ${label}`,
        `Duration: ${duration ? `${duration} seconds entered` : 'not entered'}`,
        `Safe area: keep important text/faces inside the center area; leave about ${preset.safeArea} edge padding.`,
        `Format: export MP4/H.264 when possible.`,
        `Note: ${preset.duration}`,
      ].join('\n');
    }
  }

  widthInput?.addEventListener('input', render);
  heightInput?.addEventListener('input', render);
  durationInput?.addEventListener('input', render);
  presetInput?.addEventListener('change', render);
  sampleButton?.addEventListener('click', () => {
    if (!widthInput || !heightInput || !durationInput) return;
    widthInput.value = '1080';
    heightInput.value = '1920';
    durationInput.value = '30';
    render();
    widthInput.focus();
  });
  clearButton?.addEventListener('click', () => {
    if (widthInput) widthInput.value = '';
    if (heightInput) heightInput.value = '';
    if (durationInput) durationInput.value = '';
    render();
    widthInput?.focus();
  });
  copyButton?.addEventListener('click', async () => {
    if (!status || !checklist) return;
    if (!checklist.value.trim()) {
      status.textContent = 'Nothing to copy yet. Enter dimensions or load the sample first.';
      return;
    }
    try {
      await navigator.clipboard.writeText(checklist.value);
      status.textContent = 'Vertical video checklist copied.';
    } catch {
      status.textContent = 'Copy blocked by browser. You can still select and copy the checklist.';
    }
  });
  render();
</script>
