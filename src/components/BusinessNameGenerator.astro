<section class="rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm md:p-8" aria-labelledby="business-name-generator-app">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"><div><p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-700">Browser-only utility</p><h2 id="business-name-generator-app" class="mt-2 text-2xl font-black tracking-tight text-slate-950 md:text-3xl">Generate practical business-name ideas</h2><p class="mt-2 text-slate-600">Start with a few words that describe your business, project, product, or audience. Check trademark and domain availability before using a name.</p></div><div class="flex flex-wrap gap-3"><button id="sampleBusinessNames" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:border-blue-300 hover:text-blue-700">Sample</button><button id="clearBusinessNames" type="button" class="rounded-full bg-slate-950 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700">Clear</button></div></div>
  <div class="mt-6 grid gap-5 lg:grid-cols-[1fr_1fr]"><div class="rounded-3xl bg-slate-50 p-5"><label for="businessKeywords" class="text-sm font-bold text-slate-700">Keywords</label><textarea id="businessKeywords" class="mt-2 min-h-36 w-full resize-y rounded-2xl border border-slate-200 bg-white p-4 text-slate-900 outline-none focus:border-blue-400 focus:ring-4 focus:ring-blue-100" placeholder="e.g. coffee, local, morning"></textarea><p class="mt-2 text-sm text-slate-600">Separate ideas with commas, spaces, or new lines.</p><label for="businessStyle" class="mt-5 block text-sm font-bold text-slate-700">Name style</label><select id="businessStyle" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none focus:border-blue-400 focus:ring-4 focus:ring-blue-100"><option value="balanced">Balanced</option><option value="modern">Modern</option><option value="local">Local and friendly</option><option value="professional">Professional</option></select><button id="generateBusinessNames" type="button" class="mt-5 w-full rounded-2xl bg-blue-600 px-5 py-3 font-bold text-white hover:bg-blue-700">Generate ideas</button></div><div class="rounded-3xl bg-slate-950 p-5 text-white"><div class="flex items-center justify-between gap-3"><h3 class="text-sm font-bold text-slate-300">Name ideas</h3><button id="copyBusinessNames" type="button" class="rounded-full border border-slate-600 px-4 py-2 text-sm font-semibold text-slate-200 hover:border-blue-300 hover:text-white">Copy</button></div><div id="businessNameResults" class="mt-4 grid gap-3" aria-live="polite"><p class="rounded-2xl border border-slate-700 bg-slate-900 p-4 text-slate-300">Add a few keywords, then generate ideas.</p></div><p id="businessNameStatus" class="mt-3 min-h-5 text-sm font-semibold text-blue-200" aria-live="polite"></p></div></div>
</section>
<script>
  const keywordsInput = document.getElementById('businessKeywords') as HTMLTextAreaElement | null; const styleInput = document.getElementById('businessStyle') as HTMLSelectElement | null; const results = document.getElementById('businessNameResults'); const status = document.getElementById('businessNameStatus'); let names: string[] = [];
  const titleCase = (word: string) => word.replace(/\b\w/g, (letter) => letter.toUpperCase());
  const options = { balanced: ['Studio', 'Works', 'Co.', 'Collective'], modern: ['Labs', 'Flow', 'Spark', 'Loop'], local: ['Corner', 'House', 'Market', 'Neighbourhood'], professional: ['Partners', 'Group', 'Advisory', 'Solutions'] } as const;
  function setStatus(message = '') { if (status) status.textContent = message; }
  function generate() { const words = [...new Set((keywordsInput?.value ?? '').toLowerCase().split(/[^a-z0-9]+/i).filter((word) => word.length > 1))].slice(0, 5); if (!words.length) { names = []; if (results) results.innerHTML = '<p class="rounded-2xl border border-slate-700 bg-slate-900 p-4 text-slate-300">Add at least one keyword first.</p>'; setStatus('Enter a keyword to generate ideas.'); return; } const suffixes = options[(styleInput?.value ?? 'balanced') as keyof typeof options]; const first = words[0]; const second = words[1] ?? words[0]; const roots = [first, second, words.slice(0, 2).join(' '), words.slice(1, 3).join(' ') || first]; names = [...new Set(roots.flatMap((root, index) => [titleCase(`${root} ${suffixes[index % suffixes.length]}`), titleCase(`${suffixes[(index + 1) % suffixes.length]} ${root}`)]))].slice(0, 8); if (results) results.innerHTML = names.map((name) => `<button type="button" class="rounded-2xl border border-slate-700 bg-slate-900 px-4 py-3 text-left font-bold text-white hover:border-blue-300 hover:bg-slate-800" data-name="${name}">${name}</button>`).join(''); results?.querySelectorAll<HTMLButtonElement>('[data-name]').forEach((button) => button.addEventListener('click', async () => { try { await navigator.clipboard.writeText(button.dataset.name ?? ''); } catch { } setStatus(`${button.dataset.name} copied.`); })); setStatus(`${names.length} ideas generated. Check availability before choosing one.`); }
  document.getElementById('generateBusinessNames')?.addEventListener('click', generate); styleInput?.addEventListener('change', () => { if (keywordsInput?.value.trim()) generate(); }); document.getElementById('sampleBusinessNames')?.addEventListener('click', () => { if (keywordsInput) keywordsInput.value = 'coffee local morning'; if (styleInput) styleInput.value = 'local'; generate(); }); document.getElementById('clearBusinessNames')?.addEventListener('click', () => { if (keywordsInput) keywordsInput.value = ''; names = []; if (results) results.innerHTML = '<p class="rounded-2xl border border-slate-700 bg-slate-900 p-4 text-slate-300">Add a few keywords, then generate ideas.</p>'; setStatus(); }); document.getElementById('copyBusinessNames')?.addEventListener('click', async () => { const text = names.join('\n'); try { await navigator.clipboard.writeText(text); } catch { } setStatus(text ? 'All ideas copied to clipboard.' : 'Generate ideas first.'); });
</script>
