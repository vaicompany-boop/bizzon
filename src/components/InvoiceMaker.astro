<section class="rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm md:p-8" aria-labelledby="invoice-maker-app">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-700">Browser-only pro utility</p>
      <h2 id="invoice-maker-app" class="mt-2 text-2xl font-black tracking-tight text-slate-950 md:text-3xl">Create and download invoices as PDF</h2>
      <p class="mt-2 text-slate-600">Enter your business details, client details, invoice items, tax, discount, payment terms, logo, and notes. The invoice is prepared in your browser and downloaded as a PDF.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <button id="sampleInvoice" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Sample</button>
      <button id="autoInvoiceNumber" type="button" class="rounded-full border border-blue-200 bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700 transition hover:bg-blue-100">Auto number</button>
      <button id="saveInvoiceTemplate" type="button" class="rounded-full border border-blue-200 bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700 transition hover:bg-blue-100">Save template</button>
      <button id="loadInvoiceTemplate" type="button" class="rounded-full border border-blue-200 bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700 transition hover:bg-blue-100">Load template</button>
      <button id="downloadInvoiceJson" type="button" class="rounded-full border border-blue-200 bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700 transition hover:bg-blue-100">Download JSON backup</button>
      <button id="importInvoiceJson" type="button" class="rounded-full border border-blue-200 bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700 transition hover:bg-blue-100">Import JSON backup</button>
      <input id="importInvoiceFile" type="file" accept="application/json,.json" class="hidden" />
      <button id="emailInvoiceDraft" type="button" class="rounded-full border border-blue-200 bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700 transition hover:bg-blue-100">Email draft</button>
      <button id="clearInvoice" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Clear</button>
      <button id="downloadInvoicePdf" type="button" data-pdf-engine="jsPDF" class="rounded-full bg-blue-600 px-5 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-blue-700">Download PDF</button>
    </div>
  </div>

  <div class="mt-6 rounded-3xl border border-blue-100 bg-blue-50 p-5">
    <h3 class="text-lg font-black text-slate-950">Pro options</h3>
    <p class="mt-1 text-sm text-blue-900">Add a logo, choose a PDF style, set payment terms, apply discount, select language, choose VAT / tax mode, add a signature, configure recurring invoice notes, and save a reusable browser-only template with localStorage.</p>
    <div class="mt-4 grid gap-4 md:grid-cols-4">
      <div>
        <label for="invoiceLogo" class="text-sm font-bold text-slate-700">Logo upload</label>
        <input id="invoiceLogo" type="file" accept="image/png,image/jpeg,image/webp" class="mt-2 block w-full text-sm text-slate-700 file:mr-3 file:rounded-full file:border-0 file:bg-white file:px-4 file:py-2 file:text-sm file:font-bold file:text-blue-700" />
        <div id="logoPreview" class="mt-3 flex h-16 items-center justify-center rounded-2xl border border-dashed border-blue-200 bg-white text-xs font-semibold text-slate-500">No logo selected</div>
      </div>
      <div>
        <label for="invoiceStyle" class="text-sm font-bold text-slate-700">PDF style</label>
        <select id="invoiceStyle" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100">
          <option value="modern">Modern blue</option>
          <option value="classic">Classic black</option>
          <option value="minimal">Minimal clean</option>
        </select>
      </div>
      <div>
        <label for="paymentTerms" class="text-sm font-bold text-slate-700">Payment terms</label>
        <select id="paymentTerms" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100">
          <option value="0">Due on receipt</option>
          <option value="7">Net 7</option>
          <option value="14" selected>Net 14</option>
          <option value="30">Net 30</option>
          <option value="custom">Custom due date</option>
        </select>
      </div>
      <div>
        <label for="invoiceDiscountValue" class="text-sm font-bold text-slate-700">Discount</label>
        <div class="mt-2 grid grid-cols-[1fr_6rem] gap-2">
          <input id="invoiceDiscountValue" type="number" inputmode="decimal" min="0" step="0.01" value="0" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100" />
          <select id="invoiceDiscountType" class="rounded-2xl border border-slate-200 bg-white px-3 py-3 font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100">
            <option value="percent">%</option>
            <option value="fixed">Fixed</option>
          </select>
        </div>
      </div>
    </div>
    <div class="mt-4 grid gap-4 md:grid-cols-4">
      <div>
        <label for="invoiceLanguage" class="text-sm font-bold text-slate-700">Language</label>
        <select id="invoiceLanguage" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100">
          <option value="en">English</option>
          <option value="de">Deutsch</option>
          <option value="bs">Bosanski</option>
        </select>
      </div>
      <div>
        <label for="taxMode" class="text-sm font-bold text-slate-700">VAT / tax mode</label>
        <select id="taxMode" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100">
          <option value="standard">Standard tax</option>
          <option value="reverse">Reverse charge</option>
          <option value="exempt">Tax exempt</option>
        </select>
      </div>
      <div>
        <label for="signatureName" class="text-sm font-bold text-slate-700">Signature</label>
        <input id="signatureName" placeholder="Name shown under signature line" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100" />
      </div>
      <div>
        <label for="recurringPreset" class="text-sm font-bold text-slate-700">Recurring invoice</label>
        <select id="recurringPreset" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100">
          <option value="none">One-time invoice</option>
          <option value="monthly">Monthly recurring</option>
          <option value="quarterly">Quarterly recurring</option>
          <option value="yearly">Yearly recurring</option>
        </select>
      </div>
    </div>
  </div>

  <div class="mt-6 grid gap-6 xl:grid-cols-[1.05fr_0.95fr]">
    <div class="grid gap-5">
      <div class="grid gap-5 md:grid-cols-3">
        <div class="rounded-3xl bg-slate-50 p-5">
          <label for="invoiceNumber" class="text-sm font-bold text-slate-700">Invoice number</label>
          <input id="invoiceNumber" value="INV-001" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100" />
        </div>
        <div class="rounded-3xl bg-slate-50 p-5">
          <label for="invoiceDate" class="text-sm font-bold text-slate-700">Invoice date</label>
          <input id="invoiceDate" type="date" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100" />
        </div>
        <div class="rounded-3xl bg-slate-50 p-5">
          <label for="invoiceDueDate" class="text-sm font-bold text-slate-700">Due date</label>
          <input id="invoiceDueDate" type="date" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100" />
        </div>
      </div>

      <div class="grid gap-5 md:grid-cols-2">
        <div class="rounded-3xl bg-slate-50 p-5">
          <h3 class="text-lg font-black text-slate-950">Your details</h3>
          <label for="sellerName" class="mt-4 block text-sm font-bold text-slate-700">Business / freelancer name</label>
          <input id="sellerName" value="Your Business Name" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100" />
          <label for="sellerDetails" class="mt-4 block text-sm font-bold text-slate-700">Address, email, tax ID, payment details</label>
          <textarea id="sellerDetails" rows="5" class="mt-2 w-full resize-y rounded-2xl border border-slate-200 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100">Street 1
City, Country
email@example.com
IBAN / payment details</textarea>
        </div>
        <div class="rounded-3xl bg-slate-50 p-5">
          <h3 class="text-lg font-black text-slate-950">Client details</h3>
          <label for="clientName" class="mt-4 block text-sm font-bold text-slate-700">Client name</label>
          <input id="clientName" value="Client Company" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100" />
          <label for="clientEmail" class="mt-4 block text-sm font-bold text-slate-700">Client email</label>
          <input id="clientEmail" type="email" value="client@example.com" placeholder="client@example.com" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100" />
          <label for="clientDetails" class="mt-4 block text-sm font-bold text-slate-700">Client address and notes</label>
          <textarea id="clientDetails" rows="5" class="mt-2 w-full resize-y rounded-2xl border border-slate-200 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100">Client street 2
Client city, country</textarea>
        </div>
      </div>

      <div class="rounded-3xl bg-slate-50 p-5">
        <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <div>
            <h3 class="text-lg font-black text-slate-950">Invoice items</h3>
            <p class="mt-1 text-sm text-slate-600">Add services or products with quantity and unit price. The preview shows Subtotal, Discount, Tax, and Total automatically.</p>
          </div>
          <button id="addInvoiceItem" type="button" class="rounded-full bg-slate-950 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700">Add item</button>
        </div>
        <div class="mt-4 overflow-x-auto">
          <table class="min-w-full text-left text-sm">
            <thead class="text-slate-600">
              <tr>
                <th class="pb-2 pr-3">Description</th>
                <th class="pb-2 pr-3">Qty</th>
                <th class="pb-2 pr-3">Unit price</th>
                <th class="pb-2 pr-3">Line total</th>
                <th class="pb-2">Remove</th>
              </tr>
            </thead>
            <tbody id="invoiceItems" class="align-top"></tbody>
          </table>
        </div>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        <div class="rounded-3xl bg-slate-50 p-5">
          <label for="invoiceCurrency" class="text-sm font-bold text-slate-700">Currency</label>
          <select id="invoiceCurrency" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100">
            <option value="€">€ Euro</option>
            <option value="$">$ Dollar</option>
            <option value="£">£ Pound</option>
            <option value="KM">KM Mark</option>
          </select>
        </div>
        <div class="rounded-3xl bg-slate-50 p-5">
          <label for="invoiceTaxRate" class="text-sm font-bold text-slate-700">Tax rate</label>
          <input id="invoiceTaxRate" type="number" inputmode="decimal" min="0" step="0.1" value="19" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100" />
        </div>
        <div class="rounded-3xl bg-slate-50 p-5">
          <label for="invoiceNotes" class="text-sm font-bold text-slate-700">Notes</label>
          <textarea id="invoiceNotes" rows="4" class="mt-2 w-full resize-y rounded-2xl border border-slate-200 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100">Thank you for your business.</textarea>
        </div>
      </div>
      <p id="invoiceStatus" class="min-h-5 text-sm font-semibold text-blue-700" aria-live="polite"></p>
    </div>

    <aside class="rounded-[2rem] border border-slate-200 bg-slate-50 p-5 md:p-6">
      <div class="flex items-center justify-between gap-3">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-700">Live preview</p>
          <h3 class="mt-2 text-2xl font-black text-slate-950">Invoice preview</h3>
        </div>
        <p class="rounded-full bg-white px-3 py-1.5 text-sm font-bold text-slate-700 ring-1 ring-slate-200">PDF-ready</p>
      </div>
      <div id="invoicePreview" class="mt-5 rounded-3xl bg-white p-6 text-slate-800 shadow-sm ring-1 ring-slate-200"></div>
    </aside>
  </div>
</section>

<script>
  import { jsPDF } from 'jspdf';

  type InvoiceItem = { description: string; quantity: number; unitPrice: number };
  type InvoiceTemplate = {
    invoiceNumber: string;
    invoiceDate: string;
    invoiceDueDate: string;
    sellerName: string;
    sellerDetails: string;
    clientName: string;
    clientEmail: string;
    clientDetails: string;
    currency: string;
    taxRate: string;
    discountType: string;
    discountValue: string;
    paymentTerms: string;
    invoiceLanguage: string;
    taxMode: string;
    signatureName: string;
    recurringPreset: string;
    invoiceStyle: string;
    notes: string;
    logoDataUrl: string;
    items: InvoiceItem[];
  };

  const STORAGE_KEY = 'bizzonInvoiceMakerTemplate';
  const COUNTER_KEY = 'bizzonInvoiceMakerCounter';
  let logoDataUrl = '';

  const ids = {
    invoiceNumber: document.getElementById('invoiceNumber') as HTMLInputElement | null,
    invoiceDate: document.getElementById('invoiceDate') as HTMLInputElement | null,
    invoiceDueDate: document.getElementById('invoiceDueDate') as HTMLInputElement | null,
    sellerName: document.getElementById('sellerName') as HTMLInputElement | null,
    sellerDetails: document.getElementById('sellerDetails') as HTMLTextAreaElement | null,
    clientName: document.getElementById('clientName') as HTMLInputElement | null,
    clientEmail: document.getElementById('clientEmail') as HTMLInputElement | null,
    clientDetails: document.getElementById('clientDetails') as HTMLTextAreaElement | null,
    currency: document.getElementById('invoiceCurrency') as HTMLSelectElement | null,
    taxRate: document.getElementById('invoiceTaxRate') as HTMLInputElement | null,
    discountType: document.getElementById('invoiceDiscountType') as HTMLSelectElement | null,
    discountValue: document.getElementById('invoiceDiscountValue') as HTMLInputElement | null,
    paymentTerms: document.getElementById('paymentTerms') as HTMLSelectElement | null,
    invoiceLanguage: document.getElementById('invoiceLanguage') as HTMLSelectElement | null,
    taxMode: document.getElementById('taxMode') as HTMLSelectElement | null,
    signatureName: document.getElementById('signatureName') as HTMLInputElement | null,
    recurringPreset: document.getElementById('recurringPreset') as HTMLSelectElement | null,
    invoiceStyle: document.getElementById('invoiceStyle') as HTMLSelectElement | null,
    logo: document.getElementById('invoiceLogo') as HTMLInputElement | null,
    logoPreview: document.getElementById('logoPreview'),
    notes: document.getElementById('invoiceNotes') as HTMLTextAreaElement | null,
    items: document.getElementById('invoiceItems') as HTMLTableSectionElement | null,
    preview: document.getElementById('invoicePreview'),
    status: document.getElementById('invoiceStatus'),
    add: document.getElementById('addInvoiceItem'),
    sample: document.getElementById('sampleInvoice'),
    autoNumber: document.getElementById('autoInvoiceNumber'),
    save: document.getElementById('saveInvoiceTemplate'),
    load: document.getElementById('loadInvoiceTemplate'),
    exportJson: document.getElementById('downloadInvoiceJson'),
    importJson: document.getElementById('importInvoiceJson'),
    importFile: document.getElementById('importInvoiceFile') as HTMLInputElement | null,
    clear: document.getElementById('clearInvoice'),
    email: document.getElementById('emailInvoiceDraft'),
    download: document.getElementById('downloadInvoicePdf'),
  };

  function today(offsetDays = 0) {
    const date = new Date();
    date.setDate(date.getDate() + offsetDays);
    return date.toISOString().slice(0, 10);
  }

  function addDays(dateValue: string, offsetDays: number) {
    const date = dateValue ? new Date(`${dateValue}T12:00:00`) : new Date();
    date.setDate(date.getDate() + offsetDays);
    return date.toISOString().slice(0, 10);
  }

  function escapeHtml(value: string) {
    return value.replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[char] || char));
  }

  function money(value: number) {
    const symbol = ids.currency?.value || '€';
    const formatted = Number.isFinite(value) ? value.toFixed(2) : '0.00';
    return symbol === 'KM' ? `${formatted} KM` : `${symbol}${formatted}`;
  }

  function setStatus(message = '') {
    if (ids.status) ids.status.textContent = message;
  }

  function itemRows() {
    return Array.from(ids.items?.querySelectorAll('tr') || []);
  }

  function getItems(): InvoiceItem[] {
    return itemRows().map((row) => {
      const description = (row.querySelector('.invoice-item-description') as HTMLInputElement | null)?.value || '';
      const quantity = Math.max(0, Number((row.querySelector('.invoice-item-quantity') as HTMLInputElement | null)?.value || 0));
      const unitPrice = Math.max(0, Number((row.querySelector('.invoice-item-price') as HTMLInputElement | null)?.value || 0));
      return { description, quantity, unitPrice };
    }).filter((item) => item.description.trim() || item.quantity || item.unitPrice);
  }

  function totals() {
    const items = getItems();
    const subtotal = items.reduce((sum, item) => sum + item.quantity * item.unitPrice, 0);
    const discountInput = Math.max(0, Number(ids.discountValue?.value || 0));
    const discount = ids.discountType?.value === 'fixed' ? Math.min(subtotal, discountInput) : Math.min(subtotal, subtotal * (discountInput / 100));
    const taxableSubtotal = Math.max(0, subtotal - discount);
    const taxMode = ids.taxMode?.value || 'standard';
    const rate = taxMode === 'standard' ? Math.max(0, Number(ids.taxRate?.value || 0)) : 0;
    const tax = taxableSubtotal * (rate / 100);
    return { items, subtotal, discount, taxableSubtotal, rate, tax, total: taxableSubtotal + tax, taxMode };
  }

  const labels = {
    en: { invoice: 'Invoice', date: 'Date', due: 'Due', terms: 'Terms', from: 'From', billTo: 'Bill to', description: 'Description', qty: 'Qty', unit: 'Unit', total: 'Total', subtotal: 'Subtotal', discount: 'Discount', taxableSubtotal: 'Taxable subtotal', tax: 'Tax', notes: 'Notes', signature: 'Signature', reverseCharge: 'Reverse charge', taxExempt: 'Tax exempt', recurring: 'Recurring invoice' },
    de: { invoice: 'Rechnung', date: 'Datum', due: 'Fällig', terms: 'Zahlungsziel', from: 'Von', billTo: 'Rechnung an', description: 'Beschreibung', qty: 'Menge', unit: 'Preis', total: 'Summe', subtotal: 'Zwischensumme', discount: 'Rabatt', taxableSubtotal: 'Steuerbasis', tax: 'MwSt.', notes: 'Notizen', signature: 'Unterschrift', reverseCharge: 'Reverse Charge', taxExempt: 'Steuerbefreit', recurring: 'Wiederkehrende Rechnung' },
    bs: { invoice: 'Faktura', date: 'Datum', due: 'Rok plaćanja', terms: 'Uslovi plaćanja', from: 'Od', billTo: 'Za klijenta', description: 'Opis', qty: 'Kol.', unit: 'Cijena', total: 'Ukupno', subtotal: 'Međuzbir', discount: 'Popust', taxableSubtotal: 'Osnovica', tax: 'Porez', notes: 'Napomene', signature: 'Potpis', reverseCharge: 'Reverse charge', taxExempt: 'Oslobođeno poreza', recurring: 'Ponavljajuća faktura' },
  } as const;

  function t() {
    return labels[(ids.invoiceLanguage?.value || 'en') as keyof typeof labels] || labels.en;
  }

  function taxModeNote() {
    const l = t();
    if (ids.taxMode?.value === 'reverse') return l.reverseCharge;
    if (ids.taxMode?.value === 'exempt') return l.taxExempt;
    return '';
  }

  function recurringNote() {
    const value = ids.recurringPreset?.value || 'none';
    if (value === 'none') return '';
    const label = ids.recurringPreset?.selectedOptions?.[0]?.textContent || value;
    return `${t().recurring}: ${label}`;
  }

  function updateLogoPreview() {
    if (!ids.logoPreview) return;
    ids.logoPreview.innerHTML = logoDataUrl
      ? `<img src="${logoDataUrl}" alt="Invoice logo preview" class="max-h-14 max-w-full object-contain" />`
      : 'No logo selected';
  }

  function addItem(item: InvoiceItem = { description: '', quantity: 1, unitPrice: 0 }) {
    if (!ids.items) return;
    const row = document.createElement('tr');
    row.className = 'invoice-row border-t border-slate-200';
    row.innerHTML = `
      <td class="py-3 pr-3"><input class="invoice-item-description w-64 rounded-2xl border border-slate-200 bg-white px-3 py-2 outline-none focus:border-blue-400" value="${escapeHtml(item.description)}" placeholder="Service or product" /></td>
      <td class="py-3 pr-3"><input class="invoice-item-quantity w-20 rounded-2xl border border-slate-200 bg-white px-3 py-2 outline-none focus:border-blue-400" type="number" min="0" step="0.01" value="${item.quantity}" /></td>
      <td class="py-3 pr-3"><input class="invoice-item-price w-28 rounded-2xl border border-slate-200 bg-white px-3 py-2 outline-none focus:border-blue-400" type="number" min="0" step="0.01" value="${item.unitPrice}" /></td>
      <td class="line-total py-3 pr-3 font-bold text-slate-950">${money(item.quantity * item.unitPrice)}</td>
      <td class="py-3"><button type="button" class="remove-invoice-item rounded-full border border-slate-300 px-3 py-1.5 text-xs font-bold text-slate-600 hover:border-red-300 hover:text-red-700">Remove</button></td>
    `;
    row.querySelectorAll('input').forEach((input) => input.addEventListener('input', update));
    row.querySelector('.remove-invoice-item')?.addEventListener('click', () => {
      row.remove();
      if (!itemRows().length) addItem({ description: 'Consulting service', quantity: 1, unitPrice: 100 });
      update();
    });
    ids.items.appendChild(row);
    update();
  }

  function updateLineTotals() {
    itemRows().forEach((row) => {
      const quantity = Math.max(0, Number((row.querySelector('.invoice-item-quantity') as HTMLInputElement | null)?.value || 0));
      const unitPrice = Math.max(0, Number((row.querySelector('.invoice-item-price') as HTMLInputElement | null)?.value || 0));
      const lineTotal = row.querySelector('.line-total');
      if (lineTotal) lineTotal.textContent = money(quantity * unitPrice);
    });
  }

  function getTemplate(): InvoiceTemplate {
    return {
      invoiceNumber: ids.invoiceNumber?.value || '',
      invoiceDate: ids.invoiceDate?.value || '',
      invoiceDueDate: ids.invoiceDueDate?.value || '',
      sellerName: ids.sellerName?.value || '',
      sellerDetails: ids.sellerDetails?.value || '',
      clientName: ids.clientName?.value || '',
      clientEmail: ids.clientEmail?.value || '',
      clientDetails: ids.clientDetails?.value || '',
      currency: ids.currency?.value || '€',
      taxRate: ids.taxRate?.value || '0',
      discountType: ids.discountType?.value || 'percent',
      discountValue: ids.discountValue?.value || '0',
      paymentTerms: ids.paymentTerms?.value || 'custom',
      invoiceLanguage: ids.invoiceLanguage?.value || 'en',
      taxMode: ids.taxMode?.value || 'standard',
      signatureName: ids.signatureName?.value || '',
      recurringPreset: ids.recurringPreset?.value || 'none',
      invoiceStyle: ids.invoiceStyle?.value || 'modern',
      notes: ids.notes?.value || '',
      logoDataUrl,
      items: getItems(),
    };
  }

  function applyTemplate(template: Partial<InvoiceTemplate>) {
    if (ids.invoiceNumber) ids.invoiceNumber.value = template.invoiceNumber || 'INV-001';
    if (ids.invoiceDate) ids.invoiceDate.value = template.invoiceDate || today();
    if (ids.invoiceDueDate) ids.invoiceDueDate.value = template.invoiceDueDate || today(14);
    if (ids.sellerName) ids.sellerName.value = template.sellerName || '';
    if (ids.sellerDetails) ids.sellerDetails.value = template.sellerDetails || '';
    if (ids.clientName) ids.clientName.value = template.clientName || '';
    if (ids.clientEmail) ids.clientEmail.value = template.clientEmail || '';
    if (ids.clientDetails) ids.clientDetails.value = template.clientDetails || '';
    if (ids.currency) ids.currency.value = template.currency || '€';
    if (ids.taxRate) ids.taxRate.value = template.taxRate || '0';
    if (ids.discountType) ids.discountType.value = template.discountType || 'percent';
    if (ids.discountValue) ids.discountValue.value = template.discountValue || '0';
    if (ids.paymentTerms) ids.paymentTerms.value = template.paymentTerms || 'custom';
    if (ids.invoiceLanguage) ids.invoiceLanguage.value = template.invoiceLanguage || 'en';
    if (ids.taxMode) ids.taxMode.value = template.taxMode || 'standard';
    if (ids.signatureName) ids.signatureName.value = template.signatureName || '';
    if (ids.recurringPreset) ids.recurringPreset.value = template.recurringPreset || 'none';
    if (ids.invoiceStyle) ids.invoiceStyle.value = template.invoiceStyle || 'modern';
    if (ids.notes) ids.notes.value = template.notes || '';
    logoDataUrl = template.logoDataUrl || '';
    updateLogoPreview();
    if (ids.items) ids.items.innerHTML = '';
    (template.items?.length ? template.items : [{ description: 'Service', quantity: 1, unitPrice: 0 }]).forEach((item) => addItem(item));
    update();
  }

  function saveTemplate() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(getTemplate()));
      setStatus('Template saved in this browser.');
    } catch {
      setStatus('Could not save template in this browser.');
    }
  }

  function loadTemplate() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) { setStatus('No saved template found in this browser.'); return; }
      applyTemplate(JSON.parse(raw));
      setStatus('Template loaded.');
    } catch {
      setStatus('Could not load the saved template.');
    }
  }

  function nextInvoiceNumber() {
    const datePart = (ids.invoiceDate?.value || today()).replaceAll('-', '');
    let next = 1;
    try {
      next = Number(localStorage.getItem(COUNTER_KEY) || '0') + 1;
      localStorage.setItem(COUNTER_KEY, String(next));
    } catch {
      next = Math.max(1, Math.floor(Date.now() / 1000) % 10000);
    }
    if (ids.invoiceNumber) ids.invoiceNumber.value = `INV-${datePart}-${String(next).padStart(3, '0')}`;
    update();
    setStatus('Auto invoice number generated.');
  }

  function downloadJsonBackup() {
    const blob = new Blob([JSON.stringify(getTemplate(), null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    const safeNumber = (ids.invoiceNumber?.value || 'invoice').replace(/[^a-z0-9-_]+/gi, '-').replace(/^-|-$/g, '').toLowerCase() || 'invoice';
    link.href = url;
    link.download = `${safeNumber}.json`;
    document.body.appendChild(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);
    setStatus('JSON backup downloaded.');
  }

  function importJsonBackup() {
    ids.importFile?.click();
  }

  function handleJsonImport() {
    const file = ids.importFile?.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      try {
        applyTemplate(JSON.parse(String(reader.result || '{}')));
        setStatus('JSON backup imported.');
      } catch {
        setStatus('Could not import JSON backup.');
      } finally {
        if (ids.importFile) ids.importFile.value = '';
      }
    };
    reader.readAsText(file);
  }

  function updateDueDateFromTerms() {
    const terms = ids.paymentTerms?.value || 'custom';
    if (terms === 'custom' || !ids.invoiceDueDate) return;
    ids.invoiceDueDate.value = addDays(ids.invoiceDate?.value || today(), Number(terms));
    update();
  }

  function update() {
    if (!ids.preview) return;
    updateLineTotals();
    const result = totals();
    const l = t();
    const style = ids.invoiceStyle?.value || 'modern';
    const accentClass = style === 'classic' ? 'text-slate-950' : style === 'minimal' ? 'text-slate-600' : 'text-blue-700';
    const logoHtml = logoDataUrl ? `<img src="${logoDataUrl}" alt="Invoice logo" class="max-h-16 max-w-40 object-contain" />` : '';
    const discountLabel = ids.discountType?.value === 'fixed' ? l.discount : `${l.discount} (${Number(ids.discountValue?.value || 0)}%)`;
    const taxNote = taxModeNote();
    const recurring = recurringNote();
    const signature = ids.signatureName?.value || '';
    const itemHtml = result.items.map((item) => `
      <tr class="border-t border-slate-200">
        <td class="py-2 pr-3">${escapeHtml(item.description || 'Item')}</td>
        <td class="py-2 pr-3 text-right">${item.quantity}</td>
        <td class="py-2 pr-3 text-right">${money(item.unitPrice)}</td>
        <td class="py-2 text-right font-bold">${money(item.quantity * item.unitPrice)}</td>
      </tr>
    `).join('');

    ids.preview.innerHTML = `
      <div class="flex items-start justify-between gap-4">
        <div>${logoHtml}<p class="mt-3 text-sm font-bold uppercase tracking-[0.2em] ${accentClass}">${l.invoice}</p><h4 class="mt-2 text-2xl font-black text-slate-950">${escapeHtml(ids.invoiceNumber?.value || 'INV-001')}</h4></div>
        <div class="text-right text-sm text-slate-600"><p>${l.date}: ${escapeHtml(ids.invoiceDate?.value || '')}</p><p>${l.due}: ${escapeHtml(ids.invoiceDueDate?.value || '')}</p><p>${l.terms}: ${escapeHtml(ids.paymentTerms?.selectedOptions?.[0]?.textContent || '')}</p></div>
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        <div><p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">${l.from}</p><p class="mt-2 font-black text-slate-950">${escapeHtml(ids.sellerName?.value || '')}</p><p class="mt-1 whitespace-pre-line text-sm text-slate-600">${escapeHtml(ids.sellerDetails?.value || '')}</p></div>
        <div><p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">${l.billTo}</p><p class="mt-2 font-black text-slate-950">${escapeHtml(ids.clientName?.value || '')}</p>${ids.clientEmail?.value ? `<p class="mt-1 text-sm font-semibold text-blue-700">${escapeHtml(ids.clientEmail.value)}</p>` : ''}<p class="mt-1 whitespace-pre-line text-sm text-slate-600">${escapeHtml(ids.clientDetails?.value || '')}</p></div>
      </div>
      <div class="mt-6 overflow-x-auto"><table class="w-full text-sm"><thead><tr class="text-slate-500"><th class="pb-2 pr-3 text-left">${l.description}</th><th class="pb-2 pr-3 text-right">${l.qty}</th><th class="pb-2 pr-3 text-right">${l.unit}</th><th class="pb-2 text-right">${l.total}</th></tr></thead><tbody>${itemHtml}</tbody></table></div>
      <div class="mt-6 ml-auto grid max-w-xs gap-2 text-sm"><div class="flex justify-between"><span>${l.subtotal}</span><strong>${money(result.subtotal)}</strong></div><div class="flex justify-between"><span>${discountLabel}</span><strong>-${money(result.discount)}</strong></div><div class="flex justify-between"><span>${l.taxableSubtotal}</span><strong>${money(result.taxableSubtotal)}</strong></div><div class="flex justify-between"><span>${l.tax} (${result.rate}%)</span><strong>${money(result.tax)}</strong></div><div class="flex justify-between border-t border-slate-200 pt-3 text-lg"><span>${l.total}</span><strong>${money(result.total)}</strong></div></div>
      ${taxNote ? `<p class="mt-4 rounded-2xl bg-amber-50 p-3 text-sm font-semibold text-amber-900">${escapeHtml(taxNote)}</p>` : ''}
      ${recurring ? `<p class="mt-3 rounded-2xl bg-blue-50 p-3 text-sm font-semibold text-blue-900">${escapeHtml(recurring)}</p>` : ''}
      <p class="mt-6 whitespace-pre-line rounded-2xl bg-slate-50 p-4 text-sm text-slate-600">${escapeHtml(ids.notes?.value || '')}</p>
      ${signature ? `<div class="mt-8 max-w-xs"><div class="border-t border-slate-300 pt-2 text-sm font-semibold text-slate-700">${l.signature}: ${escapeHtml(signature)}</div></div>` : ''}
    `;
  }

  function addText(doc: jsPDF, text: string, x: number, y: number, maxWidth = 80, lineHeight = 5) {
    const lines = doc.splitTextToSize(text || '', maxWidth);
    doc.text(lines, x, y);
    return y + lines.length * lineHeight;
  }

  function setPdfAccent(doc: jsPDF) {
    const style = ids.invoiceStyle?.value || 'modern';
    if (style === 'classic') doc.setTextColor(15, 23, 42);
    else if (style === 'minimal') doc.setTextColor(71, 85, 105);
    else doc.setTextColor(37, 99, 235);
  }

  function resetPdfColor(doc: jsPDF) {
    doc.setTextColor(15, 23, 42);
  }

  function downloadPdf() {
    const result = totals();
    const doc = new jsPDF({ unit: 'mm', format: 'a4' });
    const style = ids.invoiceStyle?.value || 'modern';
    let y = 18;

    if (style === 'modern') {
      doc.setFillColor(239, 246, 255);
      doc.rect(0, 0, 210, 42, 'F');
    }

    if (logoDataUrl) {
      try { doc.addImage(logoDataUrl, undefined as unknown as string, 14, y - 4, 32, 18); } catch { /* ignore unsupported logo formats */ }
    }

    doc.setFont('helvetica', 'bold');
    doc.setFontSize(24);
    setPdfAccent(doc);
    doc.text(t().invoice.toUpperCase(), logoDataUrl ? 52 : 14, y);
    resetPdfColor(doc);
    doc.setFontSize(11);
    doc.text(ids.invoiceNumber?.value || 'INV-001', 150, y);
    y += 10;
    doc.setFont('helvetica', 'normal');
    doc.text(`${t().date}: ${ids.invoiceDate?.value || ''}`, 150, y);
    y += 6;
    doc.text(`${t().due}: ${ids.invoiceDueDate?.value || ''}`, 150, y);
    y += 6;
    doc.text(`${t().terms}: ${ids.paymentTerms?.selectedOptions?.[0]?.textContent || ''}`, 150, y);
    y += 14;

    doc.setFont('helvetica', 'bold');
    doc.text(t().from, 14, y);
    doc.text(t().billTo, 110, y);
    y += 6;
    doc.setFont('helvetica', 'normal');
    const sellerBlock = `${ids.sellerName?.value || ''}\n${ids.sellerDetails?.value || ''}`;
    const clientBlock = `${ids.clientName?.value || ''}\n${ids.clientEmail?.value || ''}\n${ids.clientDetails?.value || ''}`;
    const sellerY = addText(doc, sellerBlock, 14, y, 80);
    const clientY = addText(doc, clientBlock, 110, y, 80);
    y = Math.max(sellerY, clientY) + 8;

    doc.setFont('helvetica', 'bold');
    doc.text(t().description, 14, y);
    doc.text(t().qty, 118, y, { align: 'right' });
    doc.text(t().unit, 150, y, { align: 'right' });
    doc.text(t().total, 196, y, { align: 'right' });
    y += 3;
    doc.line(14, y, 196, y);
    y += 7;
    doc.setFont('helvetica', 'normal');

    result.items.forEach((item) => {
      if (y > 260) { doc.addPage(); y = 20; }
      const descriptionLines = doc.splitTextToSize(item.description || 'Item', 88);
      doc.text(descriptionLines, 14, y);
      doc.text(String(item.quantity), 118, y, { align: 'right' });
      doc.text(money(item.unitPrice), 150, y, { align: 'right' });
      doc.text(money(item.quantity * item.unitPrice), 196, y, { align: 'right' });
      y += Math.max(7, descriptionLines.length * 5);
    });

    y += 5;
    doc.line(120, y, 196, y);
    y += 7;
    doc.setFont('helvetica', 'bold');
    doc.text(t().subtotal, 132, y);
    doc.text(money(result.subtotal), 196, y, { align: 'right' });
    y += 7;
    doc.text(t().discount, 132, y);
    doc.text(`-${money(result.discount)}`, 196, y, { align: 'right' });
    y += 7;
    doc.text(`${t().tax} (${result.rate}%)`, 132, y);
    doc.text(money(result.tax), 196, y, { align: 'right' });
    y += 8;
    doc.setFontSize(14);
    doc.text(t().total, 132, y);
    setPdfAccent(doc);
    doc.text(money(result.total), 196, y, { align: 'right' });
    resetPdfColor(doc);

    const notes = ids.notes?.value || '';
    const extraNotes = [taxModeNote(), recurringNote()].filter(Boolean).join('\n');
    const finalNotes = [notes, extraNotes].filter((part) => part.trim()).join('\n\n');
    if (finalNotes.trim()) {
      y += 14;
      doc.setFontSize(11);
      doc.setFont('helvetica', 'bold');
      doc.text(t().notes, 14, y);
      y += 6;
      doc.setFont('helvetica', 'normal');
      y = addText(doc, finalNotes, 14, y, 180);
    }

    if (ids.signatureName?.value.trim()) {
      y += 18;
      if (y > 270) { doc.addPage(); y = 30; }
      doc.line(14, y, 84, y);
      y += 6;
      doc.text(`${t().signature}: ${ids.signatureName.value.trim()}`, 14, y);
    }

    const safeNumber = (ids.invoiceNumber?.value || 'invoice').replace(/[^a-z0-9-_]+/gi, '-').replace(/^-|-$/g, '').toLowerCase() || 'invoice';
    doc.save(`${safeNumber}.pdf`);
    setStatus('PDF downloaded.');
  }

  function sample() {
    applyTemplate({
      invoiceNumber: 'INV-2026-001',
      invoiceDate: today(),
      invoiceDueDate: today(14),
      sellerName: 'Bizzon Studio',
      sellerDetails: 'Example Street 1\n46446 Emmerich am Rhein\nhello@example.com\nVAT ID: DE123456789\nIBAN: DE00 0000 0000 0000 0000 00',
      clientName: 'Client Company GmbH',
      clientEmail: 'client@example.com',
      clientDetails: 'Client Street 2\nBerlin, Germany',
      currency: '€',
      taxRate: '19',
      discountType: 'percent',
      discountValue: '5',
      paymentTerms: '14',
      invoiceLanguage: 'en',
      taxMode: 'standard',
      signatureName: 'Bizzon Studio',
      recurringPreset: 'monthly',
      invoiceStyle: 'modern',
      notes: 'Payment due within 14 days. Thank you for your business.',
      logoDataUrl: '',
      items: [
        { description: 'Website update package', quantity: 1, unitPrice: 450 },
        { description: 'Monthly support', quantity: 2, unitPrice: 75 },
      ],
    });
  }

  function clear() {
    applyTemplate({
      invoiceNumber: 'INV-001',
      invoiceDate: today(),
      invoiceDueDate: today(14),
      sellerName: '',
      sellerDetails: '',
      clientName: '',
      clientEmail: '',
      clientDetails: '',
      currency: '€',
      taxRate: '0',
      discountType: 'percent',
      discountValue: '0',
      paymentTerms: '14',
      invoiceLanguage: 'en',
      taxMode: 'standard',
      signatureName: '',
      recurringPreset: 'none',
      invoiceStyle: 'modern',
      notes: '',
      logoDataUrl: '',
      items: [{ description: 'Service', quantity: 1, unitPrice: 0 }],
    });
    setStatus('Invoice cleared.');
  }

  function handleLogoUpload() {
    const file = ids.logo?.files?.[0];
    if (!file) { logoDataUrl = ''; updateLogoPreview(); update(); return; }
    if (file.size > 1_500_000) { setStatus('Logo is too large. Use an image under 1.5 MB.'); return; }
    const reader = new FileReader();
    reader.onload = () => {
      logoDataUrl = String(reader.result || '');
      updateLogoPreview();
      update();
      setStatus('Logo added to preview and PDF.');
    };
    reader.readAsDataURL(file);
  }

  function emailDraft() {
    const result = totals();
    const lang = ids.invoiceLanguage?.value || 'en';
    const copy = {
      en: { hello: 'Hello,', intro: 'Please find invoice', for: 'for', attach: 'Attach the downloaded PDF before sending.' },
      de: { hello: 'Hallo,', intro: 'anbei erhalten Sie die Rechnung', for: 'über', attach: 'Bitte hängen Sie das heruntergeladene PDF vor dem Versand an.' },
      bs: { hello: 'Poštovani,', intro: 'u prilogu je faktura', for: 'u iznosu', attach: 'Prije slanja priložite preuzeti PDF.' },
    } as const;
    const c = copy[lang as keyof typeof copy] || copy.en;
    const subject = `${t().invoice} ${ids.invoiceNumber?.value || ''}`.trim();
    const body = [
      c.hello,
      '',
      `${c.intro} ${ids.invoiceNumber?.value || ''} ${c.for} ${money(result.total)}.`,
      `${t().date}: ${ids.invoiceDate?.value || ''}`,
      `${t().due}: ${ids.invoiceDueDate?.value || ''}`,
      taxModeNote(),
      recurringNote(),
      '',
      ids.notes?.value || '',
    ].filter((line) => line !== '').join('\n');
    const recipient = ids.clientEmail?.value.trim() || '';
    window.location.href = `mailto:${encodeURIComponent(recipient)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    setStatus(`Email draft opened. ${c.attach}`);
  }

  [ids.invoiceNumber, ids.invoiceDate, ids.invoiceDueDate, ids.sellerName, ids.sellerDetails, ids.clientName, ids.clientEmail, ids.clientDetails, ids.currency, ids.taxRate, ids.discountType, ids.discountValue, ids.paymentTerms, ids.invoiceLanguage, ids.taxMode, ids.signatureName, ids.recurringPreset, ids.invoiceStyle, ids.notes]
    .forEach((element) => element?.addEventListener('input', update));
  [ids.currency, ids.discountType, ids.paymentTerms, ids.invoiceLanguage, ids.taxMode, ids.recurringPreset, ids.invoiceStyle].forEach((element) => element?.addEventListener('change', update));
  ids.paymentTerms?.addEventListener('change', updateDueDateFromTerms);
  ids.invoiceDate?.addEventListener('change', updateDueDateFromTerms);
  ids.logo?.addEventListener('change', handleLogoUpload);
  ids.add?.addEventListener('click', () => addItem({ description: 'New item', quantity: 1, unitPrice: 0 }));
  ids.sample?.addEventListener('click', sample);
  ids.autoNumber?.addEventListener('click', nextInvoiceNumber);
  ids.save?.addEventListener('click', saveTemplate);
  ids.load?.addEventListener('click', loadTemplate);
  ids.exportJson?.addEventListener('click', downloadJsonBackup);
  ids.importJson?.addEventListener('click', importJsonBackup);
  ids.importFile?.addEventListener('change', handleJsonImport);
  ids.clear?.addEventListener('click', clear);
  ids.email?.addEventListener('click', emailDraft);
  ids.download?.addEventListener('click', downloadPdf);

  if (ids.invoiceDate) ids.invoiceDate.value = today();
  if (ids.invoiceDueDate) ids.invoiceDueDate.value = today(14);
  sample();
</script>
