<section class="rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm md:p-8" aria-labelledby="vat-calculator-app">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-700">Browser-only utility</p>
      <h2 id="vat-calculator-app" class="mt-2 text-2xl font-black tracking-tight text-slate-950 md:text-3xl">Add or remove VAT and sales tax</h2>
      <p class="mt-2 text-slate-600">Enter a price, tax rate, and mode to calculate tax-exclusive, tax amount, and tax-inclusive totals.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <button id="sampleVat" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Sample</button>
      <button id="clearVat" type="button" class="rounded-full bg-slate-950 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700">Clear</button>
    </div>
  </div>

  <div class="mt-6 grid gap-5 lg:grid-cols-[1fr_1fr]">
    <div class="grid gap-5">
      <div class="rounded-3xl bg-slate-50 p-5">
        <label for="vatMode" class="text-sm font-bold text-slate-700">Calculation mode</label>
        <select id="vatMode" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100">
          <option value="add">Add tax to net price</option>
          <option value="remove">Remove tax from gross price</option>
        </select>
        <p id="vatModeHint" class="mt-3 text-sm text-slate-500">Use this when you know the price before tax and want the final price.</p>
      </div>

      <div class="grid gap-5 md:grid-cols-2">
        <div class="rounded-3xl bg-slate-50 p-5">
          <label id="priceLabel" for="vatPrice" class="text-sm font-bold text-slate-700">Net price before tax</label>
          <input id="vatPrice" type="number" inputmode="decimal" step="0.01" min="0" value="100" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-xl font-black text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100" />
        </div>
        <div class="rounded-3xl bg-slate-50 p-5">
          <label for="vatRate" class="text-sm font-bold text-slate-700">Tax rate</label>
          <input id="vatRate" type="number" inputmode="decimal" step="0.1" min="0" value="19" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100" />
          <div class="mt-3 flex flex-wrap gap-2" aria-label="Common tax rates">
            <button data-rate="5" type="button" class="quick-vat rounded-full bg-white px-3 py-1.5 text-sm font-bold text-slate-700 ring-1 ring-slate-200 transition hover:text-blue-700 hover:ring-blue-300">5%</button>
            <button data-rate="7" type="button" class="quick-vat rounded-full bg-white px-3 py-1.5 text-sm font-bold text-slate-700 ring-1 ring-slate-200 transition hover:text-blue-700 hover:ring-blue-300">7%</button>
            <button data-rate="17" type="button" class="quick-vat rounded-full bg-white px-3 py-1.5 text-sm font-bold text-slate-700 ring-1 ring-slate-200 transition hover:text-blue-700 hover:ring-blue-300">17%</button>
            <button data-rate="19" type="button" class="quick-vat rounded-full bg-blue-600 px-3 py-1.5 text-sm font-bold text-white transition hover:bg-blue-700">19%</button>
            <button data-rate="20" type="button" class="quick-vat rounded-full bg-white px-3 py-1.5 text-sm font-bold text-slate-700 ring-1 ring-slate-200 transition hover:text-blue-700 hover:ring-blue-300">20%</button>
          </div>
        </div>
      </div>

      <div class="grid gap-5 md:grid-cols-2">
        <div class="rounded-3xl bg-slate-50 p-5">
          <label for="vatCurrency" class="text-sm font-bold text-slate-700">Currency symbol</label>
          <select id="vatCurrency" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100">
            <option value="€">€ Euro</option>
            <option value="$">$ Dollar</option>
            <option value="£">£ Pound</option>
            <option value="KM">KM Mark</option>
          </select>
        </div>
        <div class="rounded-3xl bg-slate-50 p-5">
          <p class="text-sm font-bold text-slate-700">Formula</p>
          <p id="vatFormula" class="mt-2 rounded-2xl bg-white px-4 py-3 font-mono text-sm text-slate-700">Gross = Net × (1 + rate)</p>
        </div>
      </div>
    </div>

    <div class="rounded-3xl bg-slate-950 p-5 text-white">
      <div class="flex items-center justify-between gap-3">
        <label for="vatResult" class="text-sm font-bold text-slate-300">Result</label>
        <button id="copyVatResult" type="button" class="rounded-full border border-slate-600 px-4 py-2 text-sm font-semibold text-slate-200 transition hover:border-blue-300 hover:text-white">Copy</button>
      </div>
      <textarea id="vatResult" readonly class="mt-2 min-h-72 w-full resize-y rounded-2xl border border-slate-700 bg-slate-900 p-4 font-mono text-base text-white outline-none" placeholder="VAT or sales tax calculation appears here"></textarea>
      <p id="vatStatus" class="mt-2 min-h-5 text-sm font-semibold text-blue-200" aria-live="polite"></p>
    </div>
  </div>

  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-live="polite">
    <div class="rounded-3xl bg-slate-100 p-5"><p class="text-sm font-semibold text-slate-500">Net price</p><p id="netDisplay" class="mt-2 text-3xl font-black text-slate-950">€100.00</p></div>
    <div class="rounded-3xl bg-blue-600 p-5 text-white"><p class="text-sm font-semibold text-blue-100">Tax amount</p><p id="taxDisplay" class="mt-2 text-3xl font-black">€19.00</p></div>
    <div class="rounded-3xl bg-emerald-100 p-5"><p class="text-sm font-semibold text-emerald-700">Gross price</p><p id="grossDisplay" class="mt-2 text-3xl font-black text-slate-950">€119.00</p></div>
    <div class="rounded-3xl bg-amber-100 p-5"><p class="text-sm font-semibold text-amber-700">Privacy</p><p class="mt-2 text-lg font-black text-slate-950">Runs in browser</p></div>
  </div>
</section>

<script>
  const modeInput = document.getElementById('vatMode') as HTMLSelectElement | null;
  const priceInput = document.getElementById('vatPrice') as HTMLInputElement | null;
  const rateInput = document.getElementById('vatRate') as HTMLInputElement | null;
  const currencyInput = document.getElementById('vatCurrency') as HTMLSelectElement | null;
  const result = document.getElementById('vatResult') as HTMLTextAreaElement | null;
  const status = document.getElementById('vatStatus');
  const priceLabel = document.getElementById('priceLabel');
  const modeHint = document.getElementById('vatModeHint');
  const formula = document.getElementById('vatFormula');
  const netDisplay = document.getElementById('netDisplay');
  const taxDisplay = document.getElementById('taxDisplay');
  const grossDisplay = document.getElementById('grossDisplay');
  const sampleButton = document.getElementById('sampleVat');
  const clearButton = document.getElementById('clearVat');
  const copyButton = document.getElementById('copyVatResult');
  const quickRateButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.quick-vat'));

  function roundMoney(value: number) {
    return Math.round((value + Number.EPSILON) * 100) / 100;
  }

  function money(value: number) {
    const symbol = currencyInput?.value || '€';
    const formatted = Number.isFinite(value) ? value.toFixed(2) : '0.00';
    return symbol === 'KM' ? `${formatted} KM` : `${symbol}${formatted}`;
  }

  function setStatus(message = '') {
    if (status) status.textContent = message;
  }

  function rateLabel(rate: number) {
    return `${rate.toFixed(rate % 1 === 0 ? 0 : 1)}%`;
  }

  function updateQuickButtons() {
    const active = Number(rateInput?.value || 0);
    quickRateButtons.forEach((button) => {
      const isActive = Number(button.dataset.rate) === active;
      button.classList.toggle('bg-blue-600', isActive);
      button.classList.toggle('text-white', isActive);
      button.classList.toggle('bg-white', !isActive);
      button.classList.toggle('text-slate-700', !isActive);
      button.classList.toggle('ring-1', !isActive);
      button.classList.toggle('ring-slate-200', !isActive);
    });
  }

  function calculate() {
    if (!modeInput || !priceInput || !rateInput || !result) return;
    const mode = modeInput.value;
    const price = Math.max(0, Number(priceInput.value || 0));
    const rate = Math.max(0, Number(rateInput.value || 0));
    const multiplier = 1 + rate / 100;
    let net = 0;
    let tax = 0;
    let gross = 0;

    if (mode === 'remove') {
      gross = roundMoney(price);
      net = roundMoney(gross / multiplier);
      tax = roundMoney(gross - net);
      if (priceLabel) priceLabel.textContent = 'Gross price including tax';
      if (modeHint) modeHint.textContent = 'Use this when you know the final price and want the price before tax.';
      if (formula) formula.textContent = 'Net = Gross ÷ (1 + rate)';
    } else {
      net = roundMoney(price);
      tax = roundMoney(net * (rate / 100));
      gross = roundMoney(net + tax);
      if (priceLabel) priceLabel.textContent = 'Net price before tax';
      if (modeHint) modeHint.textContent = 'Use this when you know the price before tax and want the final price.';
      if (formula) formula.textContent = 'Gross = Net × (1 + rate)';
    }

    if (netDisplay) netDisplay.textContent = money(net);
    if (taxDisplay) taxDisplay.textContent = money(tax);
    if (grossDisplay) grossDisplay.textContent = money(gross);

    result.value = [
      `Mode: ${mode === 'remove' ? 'Remove tax from gross price' : 'Add tax to net price'}`,
      `Tax rate: ${rateLabel(rate)}`,
      `Net price: ${money(net)}`,
      `Tax amount: ${money(tax)}`,
      `Gross price: ${money(gross)}`,
    ].join('\n');
    setStatus('Calculated VAT / sales tax.');
    updateQuickButtons();
  }

  [modeInput, priceInput, rateInput, currencyInput].forEach((element) => element?.addEventListener('input', calculate));
  [modeInput, currencyInput].forEach((element) => element?.addEventListener('change', calculate));
  quickRateButtons.forEach((button) => {
    button.addEventListener('click', () => {
      if (!rateInput) return;
      rateInput.value = button.dataset.rate || '19';
      calculate();
    });
  });
  sampleButton?.addEventListener('click', () => {
    if (!modeInput || !priceInput || !rateInput || !currencyInput) return;
    modeInput.value = 'add';
    priceInput.value = '100';
    rateInput.value = '19';
    currencyInput.value = '€';
    calculate();
  });
  clearButton?.addEventListener('click', () => {
    if (!modeInput || !priceInput || !rateInput || !currencyInput || !result) return;
    modeInput.value = 'add';
    priceInput.value = '';
    rateInput.value = '19';
    currencyInput.value = '€';
    result.value = '';
    calculate();
  });
  copyButton?.addEventListener('click', async () => {
    if (!result) return;
    try {
      await navigator.clipboard.writeText(result.value);
      setStatus(result.value ? 'Copied to clipboard.' : 'Nothing to copy yet.');
    } catch {
      result.select();
      document.execCommand('copy');
      setStatus(result.value ? 'Copied to clipboard.' : 'Nothing to copy yet.');
    }
  });

  calculate();
</script>
