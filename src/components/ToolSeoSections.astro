---
import { toolSeoEntries } from '../data/toolSeo';

type Props = { slug: string };
const { slug } = Astro.props;
const entry = toolSeoEntries[slug];

if (!entry) {
  throw new Error(`Missing SEO entry for tool slug: ${slug}`);
}

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: entry.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<section class="mt-14 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm md:p-8" aria-labelledby={`${slug}-guide-heading`}>
  <p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-700">Tool guide</p>
  <h2 id={`${slug}-guide-heading`} class="mt-3 text-3xl font-black tracking-tight text-slate-950">
    How to use the {entry.toolName}
  </h2>
  <p class="mt-4 max-w-3xl text-slate-600">{entry.summary}</p>

  <div class="mt-8 grid gap-6 lg:grid-cols-[1fr_1fr]">
    <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
      <h3 class="text-xl font-bold text-slate-950">Quick steps</h3>
      <ol class="mt-4 grid gap-3 text-slate-700">
        {entry.steps.map((step, index) => <li><strong>{index + 1}.</strong> {step}</li>)}
      </ol>
    </div>

    <div class="rounded-3xl border border-slate-200 bg-blue-50 p-6">
      <h3 class="text-xl font-bold text-slate-950">Common use cases</h3>
      <ul class="mt-4 grid gap-3 text-slate-700">
        {entry.useCases.map((item) => <li>• {item}</li>)}
      </ul>
    </div>
  </div>
</section>

<section class="mt-10 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm md:p-8" aria-labelledby={`${slug}-faq-heading`}>
  <p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-700">FAQ</p>
  <h2 id={`${slug}-faq-heading`} class="mt-3 text-3xl font-black tracking-tight text-slate-950">
    {entry.toolName} questions
  </h2>
  <div class="mt-6 grid gap-4">
    {
      entry.faqs.map((faq) => (
        <details class="group rounded-3xl border border-slate-200 bg-slate-50 p-5 open:bg-blue-50">
          <summary class="cursor-pointer list-none font-bold text-slate-950 group-open:text-blue-700">
            {faq.question}
          </summary>
          <p class="mt-3 leading-7 text-slate-700">{faq.answer}</p>
        </details>
      ))
    }
  </div>
</section>

<section class="mt-10 rounded-[2rem] border border-blue-100 bg-blue-50 p-6 md:p-8" aria-labelledby={`${slug}-related-heading`}>
  <p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-700">More Bizzon tools</p>
  <h2 id={`${slug}-related-heading`} class="mt-3 text-3xl font-black tracking-tight text-slate-950">
    Related tools to try next
  </h2>
  <div class="mt-6 grid gap-4 md:grid-cols-3">
    {
      entry.related.map((tool) => (
        <a class="rounded-3xl border border-blue-100 bg-white p-5 transition hover:-translate-y-1 hover:border-blue-200 hover:shadow-sm" href={tool.href}>
          <h3 class="font-bold text-slate-950">{tool.label}</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">Useful {tool.reason}.</p>
          <p class="mt-4 text-sm font-bold text-blue-700">Open tool →</p>
        </a>
      ))
    }
  </div>
  <p class="mt-6 text-sm text-slate-600">
    Primary topic: <span class="font-semibold text-slate-950">{entry.primaryKeyword}</span>.
  </p>
</section>

{
  entry.relatedGuides && entry.relatedGuides.length > 0 && (
    <section class="mt-10 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm md:p-8" aria-labelledby={`${slug}-guide-links-heading`}>
      <p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-700">Related guides</p>
      <h2 id={`${slug}-guide-links-heading`} class="mt-3 text-3xl font-black tracking-tight text-slate-950">
        Learn more about this workflow
      </h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {entry.relatedGuides.map((guide) => (
          <a class="rounded-3xl border border-slate-200 bg-slate-50 p-5 transition hover:-translate-y-1 hover:border-blue-200 hover:bg-blue-50" href={guide.href}>
            <h3 class="font-bold text-slate-950">{guide.label}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">Use this guide to {guide.reason}.</p>
            <p class="mt-4 text-sm font-bold text-blue-700">Read guide →</p>
          </a>
        ))}
      </div>
    </section>
  )
}

<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
