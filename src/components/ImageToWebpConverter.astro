<section class="rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm md:p-8" aria-labelledby="image-webp-tool-app">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-700">Browser-only image converter</p>
      <h2 id="image-webp-tool-app" class="mt-2 text-2xl font-black tracking-tight text-slate-950 md:text-3xl">Convert images to WebP</h2>
      <p class="mt-2 text-slate-600">Choose a PNG, JPG, GIF frame, or other browser-readable image and export a smaller WebP copy locally.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <button id="sampleImage" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Sample</button>
      <button id="downloadWebp" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Download WebP</button>
      <button id="clearImage" type="button" class="rounded-full bg-slate-950 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700">Clear</button>
    </div>
  </div>

  <div class="mt-6 grid gap-5 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
    <div class="space-y-5">
      <div>
        <label for="imageInput" class="text-sm font-bold text-slate-700">Image file</label>
        <input
          id="imageInput"
          type="file"
          accept="image/png,image/jpeg,image/webp,image/gif,image/bmp,image/svg+xml,image/*"
          class="mt-3 block w-full cursor-pointer rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-5 text-sm text-slate-700 file:mr-4 file:rounded-full file:border-0 file:bg-blue-600 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:border-blue-300 focus:outline-none focus:ring-4 focus:ring-blue-100"
        />
        <p class="mt-2 text-sm text-slate-500">Your image stays in this browser. No upload or server conversion is used.</p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <div class="flex items-center justify-between gap-4">
          <label for="qualityInput" class="text-sm font-bold text-slate-700">WebP quality</label>
          <output id="qualityOutput" for="qualityInput" class="rounded-full bg-white px-3 py-1 text-sm font-bold text-slate-700">82%</output>
        </div>
        <input id="qualityInput" type="range" min="10" max="100" value="82" step="1" class="mt-4 w-full accent-blue-600" />
        <p class="mt-2 text-sm text-slate-500">Lower quality usually means smaller files. 75–85% is a good starting point for web images.</p>
      </div>

      <div class="grid gap-3 rounded-3xl border border-slate-200 bg-white p-5 text-sm text-slate-600 sm:grid-cols-2">
        <div>
          <p class="font-bold text-slate-950">Original</p>
          <p id="originalMeta" class="mt-1">No image selected.</p>
        </div>
        <div>
          <p class="font-bold text-slate-950">WebP output</p>
          <p id="webpMeta" class="mt-1">Convert an image to see size.</p>
        </div>
      </div>

      <p id="imageWebpStatus" class="min-h-6 text-sm font-semibold text-blue-700" role="status" aria-live="polite"></p>
    </div>

    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
      <div>
        <div class="flex items-center justify-between gap-3">
          <p class="text-sm font-bold text-slate-700">Original preview</p>
          <p id="imageDimensions" class="text-sm font-semibold text-slate-500">—</p>
        </div>
        <div class="mt-3 grid min-h-80 place-items-center overflow-hidden rounded-3xl border border-slate-200 bg-slate-100 p-3">
          <img id="originalPreview" alt="Original image preview" class="hidden max-h-[26rem] max-w-full rounded-2xl object-contain" />
          <p id="originalEmpty" class="px-6 text-center text-sm font-semibold text-slate-500">Choose an image or use the sample to preview it here.</p>
        </div>
      </div>
      <div>
        <div class="flex items-center justify-between gap-3">
          <p class="text-sm font-bold text-slate-700">WebP preview</p>
          <p id="savingsMeta" class="text-sm font-semibold text-slate-500">—</p>
        </div>
        <div class="mt-3 grid min-h-80 place-items-center overflow-hidden rounded-3xl border border-slate-200 bg-slate-950 p-3">
          <img id="webpPreview" alt="Converted WebP preview" class="hidden max-h-[26rem] max-w-full rounded-2xl object-contain" />
          <p id="webpEmpty" class="px-6 text-center text-sm font-semibold text-slate-300">Converted WebP preview will appear here.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-6 grid gap-4 rounded-3xl border border-blue-100 bg-blue-50 p-5 text-sm text-blue-950 md:grid-cols-3">
    <p><strong>Private:</strong> conversion uses a canvas in your browser; selected images are not uploaded.</p>
    <p><strong>Useful for web:</strong> WebP often creates lighter site images while keeping visual quality acceptable.</p>
    <p><strong>Browser limits:</strong> very large images may be slow or fail if your device cannot draw them to canvas.</p>
  </div>
</section>

<script>
  const input = document.getElementById('imageInput') as HTMLInputElement | null;
  const qualityInput = document.getElementById('qualityInput') as HTMLInputElement | null;
  const qualityOutput = document.getElementById('qualityOutput');
  const sampleButton = document.getElementById('sampleImage');
  const downloadButton = document.getElementById('downloadWebp') as HTMLButtonElement | null;
  const clearButton = document.getElementById('clearImage');
  const originalPreview = document.getElementById('originalPreview') as HTMLImageElement | null;
  const webpPreview = document.getElementById('webpPreview') as HTMLImageElement | null;
  const originalEmpty = document.getElementById('originalEmpty');
  const webpEmpty = document.getElementById('webpEmpty');
  const originalMeta = document.getElementById('originalMeta');
  const webpMeta = document.getElementById('webpMeta');
  const imageDimensions = document.getElementById('imageDimensions');
  const savingsMeta = document.getElementById('savingsMeta');
  const status = document.getElementById('imageWebpStatus');

  let originalObjectUrl = '';
  let webpObjectUrl = '';
  let outputBlob: Blob | null = null;
  let outputName = 'bizzon-image.webp';
  let currentFile: File | null = null;

  function setStatus(message: string, tone: 'ok' | 'error' = 'ok') {
    if (!status) return;
    status.textContent = message;
    status.className = `min-h-6 text-sm font-semibold ${tone === 'error' ? 'text-red-700' : 'text-blue-700'}`;
  }

  function formatBytes(bytes: number) {
    if (!Number.isFinite(bytes) || bytes <= 0) return '0 B';
    const units = ['B', 'KB', 'MB', 'GB'];
    const index = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1);
    return `${(bytes / Math.pow(1024, index)).toFixed(index === 0 ? 0 : 1)} ${units[index]}`;
  }

  function safeBaseName(name: string) {
    return (name.replace(/\.[^.]+$/, '').replace(/[^a-z0-9-]+/gi, '-').replace(/^-+|-+$/g, '').toLowerCase() || 'bizzon-image') + '.webp';
  }

  function revokeUrls() {
    if (originalObjectUrl) URL.revokeObjectURL(originalObjectUrl);
    if (webpObjectUrl) URL.revokeObjectURL(webpObjectUrl);
    originalObjectUrl = '';
    webpObjectUrl = '';
  }

  function resetOutput() {
    outputBlob = null;
    if (webpPreview) {
      webpPreview.removeAttribute('src');
      webpPreview.classList.add('hidden');
    }
    webpEmpty?.classList.remove('hidden');
    if (webpMeta) webpMeta.textContent = 'Convert an image to see size.';
    if (savingsMeta) savingsMeta.textContent = '—';
    if (downloadButton) downloadButton.disabled = true;
  }

  function updateQualityLabel() {
    if (qualityOutput && qualityInput) qualityOutput.textContent = `${qualityInput.value}%`;
  }

  function drawImageToCanvas(image: HTMLImageElement) {
    const canvas = document.createElement('canvas');
    canvas.width = image.naturalWidth;
    canvas.height = image.naturalHeight;
    const context = canvas.getContext('2d');
    if (!context) throw new Error('Canvas is not available in this browser.');
    context.drawImage(image, 0, 0);
    return canvas;
  }

  function canvasToBlob(canvas: HTMLCanvasElement, quality: number) {
    return new Promise<Blob>((resolve, reject) => {
      canvas.toBlob((blob) => {
        if (blob) resolve(blob);
        else reject(new Error('This browser could not create a WebP file from the selected image.'));
      }, 'image/webp', quality);
    });
  }

  async function convertFile(file: File) {
    if (!file.type.startsWith('image/')) {
      setStatus('Choose an image file such as PNG, JPG, GIF, WebP, BMP, or SVG.', 'error');
      return;
    }

    currentFile = file;
    resetOutput();
    if (originalObjectUrl) URL.revokeObjectURL(originalObjectUrl);
    originalObjectUrl = URL.createObjectURL(file);
    outputName = safeBaseName(file.name);

    if (!originalPreview) return;
    originalPreview.src = originalObjectUrl;
    originalPreview.classList.remove('hidden');
    originalEmpty?.classList.add('hidden');
    if (originalMeta) originalMeta.textContent = `${file.name} · ${formatBytes(file.size)} · ${file.type || 'image'}`;
    setStatus('Loading image...');

    try {
      await originalPreview.decode();
      if (!originalPreview.naturalWidth || !originalPreview.naturalHeight) throw new Error('The image loaded but has no readable dimensions.');
      if (imageDimensions) imageDimensions.textContent = `${originalPreview.naturalWidth} × ${originalPreview.naturalHeight}px`;
      const canvas = drawImageToCanvas(originalPreview);
      const quality = Math.max(0.1, Math.min(1, Number(qualityInput?.value || 82) / 100));
      const blob = await canvasToBlob(canvas, quality);
      outputBlob = blob;
      if (webpObjectUrl) URL.revokeObjectURL(webpObjectUrl);
      webpObjectUrl = URL.createObjectURL(blob);
      if (webpPreview) {
        webpPreview.src = webpObjectUrl;
        webpPreview.classList.remove('hidden');
      }
      webpEmpty?.classList.add('hidden');
      if (webpMeta) webpMeta.textContent = `${outputName} · ${formatBytes(blob.size)} · image/webp`;
      const savings = file.size > 0 ? Math.round((1 - blob.size / file.size) * 100) : 0;
      if (savingsMeta) savingsMeta.textContent = savings > 0 ? `${savings}% smaller` : savings < 0 ? `${Math.abs(savings)}% larger` : 'Same size';
      if (downloadButton) downloadButton.disabled = false;
      setStatus(`Converted to WebP at ${Math.round(quality * 100)}% quality.`);
    } catch (error) {
      resetOutput();
      setStatus(error instanceof Error ? error.message : 'Could not convert this image.', 'error');
    }
  }

  async function makeSampleFile() {
    const canvas = document.createElement('canvas');
    canvas.width = 960;
    canvas.height = 540;
    const context = canvas.getContext('2d');
    if (!context) throw new Error('Canvas is not available in this browser.');
    const gradient = context.createLinearGradient(0, 0, 960, 540);
    gradient.addColorStop(0, '#1d4ed8');
    gradient.addColorStop(1, '#0f172a');
    context.fillStyle = gradient;
    context.fillRect(0, 0, 960, 540);
    context.fillStyle = 'rgba(255,255,255,0.14)';
    for (let i = 0; i < 8; i += 1) {
      context.beginPath();
      context.arc(120 + i * 110, 110 + (i % 3) * 110, 72, 0, Math.PI * 2);
      context.fill();
    }
    context.fillStyle = '#ffffff';
    context.font = '700 54px system-ui, sans-serif';
    context.fillText('Bizzon WebP sample', 70, 260);
    context.font = '500 28px system-ui, sans-serif';
    context.fillText('Browser-only image conversion', 74, 312);
    const blob = await canvasToBlob(canvas, 0.92);
    return new File([blob], 'bizzon-webp-sample.png', { type: 'image/png' });
  }

  input?.addEventListener('change', () => {
    const file = input.files?.[0];
    if (file) convertFile(file);
    else setStatus('Choose an image to convert.');
  });

  qualityInput?.addEventListener('input', () => {
    updateQualityLabel();
    if (currentFile) convertFile(currentFile);
  });

  sampleButton?.addEventListener('click', async () => {
    try {
      setStatus('Creating sample image...');
      const file = await makeSampleFile();
      await convertFile(file);
    } catch (error) {
      setStatus(error instanceof Error ? error.message : 'Could not create the sample image.', 'error');
    }
  });

  downloadButton?.addEventListener('click', () => {
    if (!outputBlob || !webpObjectUrl) {
      setStatus('Nothing to download yet.', 'error');
      return;
    }
    const link = document.createElement('a');
    link.href = webpObjectUrl;
    link.download = outputName;
    document.body.appendChild(link);
    link.click();
    link.remove();
    setStatus('WebP download started.');
  });

  clearButton?.addEventListener('click', () => {
    currentFile = null;
    revokeUrls();
    if (input) input.value = '';
    if (originalPreview) {
      originalPreview.removeAttribute('src');
      originalPreview.classList.add('hidden');
    }
    originalEmpty?.classList.remove('hidden');
    resetOutput();
    if (originalMeta) originalMeta.textContent = 'No image selected.';
    if (imageDimensions) imageDimensions.textContent = '—';
    setStatus('Choose an image to convert.');
  });

  updateQualityLabel();
  if (downloadButton) downloadButton.disabled = true;
</script>
