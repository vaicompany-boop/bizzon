<section class="rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm md:p-8" aria-labelledby="word-counter-app">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-700">Browser-only utility</p>
      <h2 id="word-counter-app" class="mt-2 text-2xl font-black tracking-tight text-slate-950 md:text-3xl">Paste or type your text</h2>
      <p class="mt-2 text-slate-600">Your text stays in your browser. Bizzon does not upload or store it.</p>
    </div>
    <div class="flex gap-3">
      <button id="sampleText" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Sample</button>
      <button id="clearText" type="button" class="rounded-full bg-slate-950 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700">Clear</button>
    </div>
  </div>

  <textarea
    id="textInput"
    class="mt-6 min-h-72 w-full resize-y rounded-3xl border border-slate-200 bg-slate-50 p-5 text-base text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-400 focus:bg-white focus:ring-4 focus:ring-blue-100"
    placeholder="Start typing or paste your text here..."
    spellcheck="true"
  ></textarea>

  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-live="polite">
    <div class="rounded-3xl bg-blue-600 p-5 text-white shadow-sm">
      <p class="text-sm font-semibold text-blue-100">Words</p>
      <p id="wordCount" class="mt-2 text-4xl font-black">0</p>
    </div>
    <div class="rounded-3xl bg-slate-100 p-5"><p class="text-sm font-semibold text-slate-500">Characters</p><p id="charCount" class="mt-2 text-3xl font-black text-slate-950">0</p></div>
    <div class="rounded-3xl bg-slate-100 p-5"><p class="text-sm font-semibold text-slate-500">Characters without spaces</p><p id="charNoSpacesCount" class="mt-2 text-3xl font-black text-slate-950">0</p></div>
    <div class="rounded-3xl bg-slate-100 p-5"><p class="text-sm font-semibold text-slate-500">Sentences</p><p id="sentenceCount" class="mt-2 text-3xl font-black text-slate-950">0</p></div>
    <div class="rounded-3xl bg-slate-100 p-5"><p class="text-sm font-semibold text-slate-500">Paragraphs</p><p id="paragraphCount" class="mt-2 text-3xl font-black text-slate-950">0</p></div>
    <div class="rounded-3xl bg-amber-100 p-5"><p class="text-sm font-semibold text-amber-700">Reading time</p><p id="readingTime" class="mt-2 text-3xl font-black text-slate-950">0 min</p></div>
  </div>
</section>

<script>
  const input = document.getElementById('textInput') as HTMLTextAreaElement | null;
  const sampleButton = document.getElementById('sampleText');
  const clearButton = document.getElementById('clearText');
  const fields = {
    words: document.getElementById('wordCount'),
    chars: document.getElementById('charCount'),
    charsNoSpaces: document.getElementById('charNoSpacesCount'),
    sentences: document.getElementById('sentenceCount'),
    paragraphs: document.getElementById('paragraphCount'),
    readingTime: document.getElementById('readingTime'),
  };
  const sample = `Bizzon is a small collection of simple tools that just work.

Paste text, clean it up, count it, convert it, or prepare it for publishing. The goal is speed, privacy, and zero clutter.`;
  function countWords(text: string) {
    const matches = text.trim().match(/[\p{L}\p{N}]+(?:['’-][\p{L}\p{N}]+)*/gu);
    return matches ? matches.length : 0;
  }
  function countSentences(text: string) {
    const trimmed = text.trim();
    if (!trimmed) return 0;
    const matches = trimmed.match(/[^.!?]+[.!?]+(?:\s|$)/g);
    return matches ? matches.length : 1;
  }
  function countParagraphs(text: string) {
    return text.split(/\n+/).map((part) => part.trim()).filter(Boolean).length;
  }
  function updateCounts() {
    if (!input) return;
    const text = input.value;
    const words = countWords(text);
    const minutes = words === 0 ? 0 : Math.max(1, Math.ceil(words / 200));
    if (fields.words) fields.words.textContent = String(words);
    if (fields.chars) fields.chars.textContent = String(text.length);
    if (fields.charsNoSpaces) fields.charsNoSpaces.textContent = String(text.replace(/\s/g, '').length);
    if (fields.sentences) fields.sentences.textContent = String(countSentences(text));
    if (fields.paragraphs) fields.paragraphs.textContent = String(countParagraphs(text));
    if (fields.readingTime) fields.readingTime.textContent = minutes === 1 ? '1 min' : `${minutes} min`;
  }
  input?.addEventListener('input', updateCounts);
  sampleButton?.addEventListener('click', () => { if (!input) return; input.value = sample; updateCounts(); input.focus(); });
  clearButton?.addEventListener('click', () => { if (!input) return; input.value = ''; updateCounts(); input.focus(); });
  updateCounts();
</script>
