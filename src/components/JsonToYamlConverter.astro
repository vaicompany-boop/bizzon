<section class="rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm md:p-8" aria-labelledby="json-yaml-app">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-700">Browser-only JSON tool</p>
      <h2 id="json-yaml-app" class="mt-2 text-2xl font-black tracking-tight text-slate-950 md:text-3xl">Convert JSON to YAML</h2>
      <p class="mt-2 text-slate-600">Paste valid JSON and turn it into readable YAML locally. Useful for config snippets, docs, and front matter drafts.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <button id="sampleJsonYaml" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Sample</button>
      <button id="convertJsonYaml" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Convert</button>
      <button id="copyJsonYaml" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Copy YAML</button>
      <button id="clearJsonYaml" type="button" class="rounded-full bg-slate-950 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700">Clear</button>
    </div>
  </div>

  <div class="mt-6 grid gap-5 lg:grid-cols-2">
    <div>
      <label for="jsonYamlInput" class="text-sm font-bold text-slate-700">JSON input</label>
      <textarea
        id="jsonYamlInput"
        class="mt-3 min-h-[30rem] w-full resize-y rounded-3xl border border-slate-200 bg-slate-50 p-5 font-mono text-sm leading-6 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-400 focus:bg-white focus:ring-4 focus:ring-blue-100"
        placeholder='{"site":"Bizzon","private":true,"tools":[{"name":"JSON to YAML","status":"live"}]}'
        spellcheck="false"
      ></textarea>
    </div>

    <div>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm font-bold text-slate-700">YAML output</p>
        <p id="jsonYamlSummary" class="text-sm font-semibold text-slate-500" aria-live="polite">Paste JSON to convert it.</p>
      </div>
      <pre class="mt-3 min-h-[30rem] overflow-auto rounded-3xl border border-slate-200 bg-slate-950 p-5 text-sm leading-6 text-slate-50"><code id="jsonYamlOutput"></code></pre>
      <p id="jsonYamlStatus" class="mt-3 min-h-6 text-sm font-semibold text-blue-700" role="status"></p>
    </div>
  </div>

  <div class="mt-6 grid gap-4 rounded-3xl border border-blue-100 bg-blue-50 p-5 text-sm text-blue-950 md:grid-cols-3">
    <p><strong>Private:</strong> the JSON text is parsed and converted in your browser only.</p>
    <p><strong>Readable output:</strong> objects, arrays, strings, numbers, booleans, and nulls are written as clean YAML.</p>
    <p><strong>Strict input:</strong> the input must be valid JSON. Comments, trailing commas, and JavaScript objects are rejected with a helpful parser error.</p>
  </div>
</section>

<script>
  const input = document.getElementById('jsonYamlInput') as HTMLTextAreaElement | null;
  const output = document.getElementById('jsonYamlOutput');
  const summary = document.getElementById('jsonYamlSummary');
  const status = document.getElementById('jsonYamlStatus');
  const sampleButton = document.getElementById('sampleJsonYaml');
  const convertButton = document.getElementById('convertJsonYaml');
  const copyButton = document.getElementById('copyJsonYaml');
  const clearButton = document.getElementById('clearJsonYaml');

  const sampleJson = JSON.stringify(
    {
      site: 'Bizzon',
      private: true,
      tags: ['converter', 'browser-only', 'yaml'],
      tools: [
        {
          name: 'JSON to YAML',
          status: 'live',
          checks: ['objects', 'arrays', 'quoted strings'],
        },
        {
          name: 'YAML to JSON',
          status: 'live',
        },
      ],
      limits: {
        uploadRequired: false,
        maxPasteSize: 'browser-friendly',
      },
      notes: 'Quotes, colons, and line breaks stay safe.',
    },
    null,
    2,
  );

  function countNodes(value: unknown) {
    const totals = { objects: 0, arrays: 0, keys: 0 };
    function walk(item: unknown) {
      if (Array.isArray(item)) {
        totals.arrays += 1;
        item.forEach(walk);
        return;
      }
      if (item && typeof item === 'object') {
        totals.objects += 1;
        const keys = Object.keys(item as Record<string, unknown>);
        totals.keys += keys.length;
        keys.forEach((key) => walk((item as Record<string, unknown>)[key]));
      }
    }
    walk(value);
    return totals;
  }

  function needsQuotedString(value: string) {
    if (value === '') return true;
    if (/^\s|\s$/.test(value)) return true;
    if (/^(true|false|null|~|yes|no|on|off)$/i.test(value)) return true;
    if (/^-?(?:\d+\.?\d*|\.\d+)(?:e[+-]?\d+)?$/i.test(value)) return true;
    if (/[:#{}[\],&*?!|>'"%@`\n\r\t]/.test(value)) return true;
    return false;
  }

  function formatScalar(value: unknown) {
    if (value === null) return 'null';
    if (typeof value === 'boolean') return value ? 'true' : 'false';
    if (typeof value === 'number') {
      if (!Number.isFinite(value)) throw new Error('JSON contains a non-finite number, which cannot be written as plain YAML.');
      return String(value);
    }
    if (typeof value === 'string') {
      if (!needsQuotedString(value)) return value;
      return JSON.stringify(value);
    }
    throw new Error('Unsupported JSON value found while formatting YAML.');
  }

  function isScalar(value: unknown) {
    return value === null || ['string', 'number', 'boolean'].includes(typeof value);
  }

  function toYaml(value: unknown, indent = 0): string {
    const pad = ' '.repeat(indent);
    if (isScalar(value)) return `${pad}${formatScalar(value)}`;

    if (Array.isArray(value)) {
      if (value.length === 0) return `${pad}[]`;
      return value
        .map((item) => {
          if (isScalar(item)) return `${pad}- ${formatScalar(item)}`;
          const nested = toYaml(item, indent + 2);
          return `${pad}-\n${nested}`;
        })
        .join('\n');
    }

    if (value && typeof value === 'object') {
      const entries = Object.entries(value as Record<string, unknown>);
      if (entries.length === 0) return `${pad}{}`;
      return entries
        .map(([key, item]) => {
          const safeKey = /^[A-Za-z0-9_-]+$/.test(key) ? key : JSON.stringify(key);
          if (isScalar(item)) return `${pad}${safeKey}: ${formatScalar(item)}`;
          if (Array.isArray(item) && item.length === 0) return `${pad}${safeKey}: []`;
          if (item && typeof item === 'object' && !Array.isArray(item) && Object.keys(item as Record<string, unknown>).length === 0) return `${pad}${safeKey}: {}`;
          return `${pad}${safeKey}:\n${toYaml(item, indent + 2)}`;
        })
        .join('\n');
    }

    throw new Error('Unsupported JSON value found while formatting YAML.');
  }

  function convertJson() {
    if (!input || !output || !summary) return;
    const text = input.value.trim();
    if (!text) {
      output.textContent = '';
      summary.textContent = 'Paste JSON to convert it.';
      if (status) status.textContent = '';
      return;
    }

    try {
      const parsed = JSON.parse(text) as unknown;
      const rendered = `${toYaml(parsed)}\n`;
      output.textContent = rendered;
      const totals = countNodes(parsed);
      summary.textContent = `Converted JSON · ${totals.objects} ${totals.objects === 1 ? 'object' : 'objects'} · ${totals.arrays} ${totals.arrays === 1 ? 'array' : 'arrays'} · ${totals.keys} ${totals.keys === 1 ? 'key' : 'keys'} · ${new Blob([rendered]).size} bytes`;
      if (status) status.textContent = 'JSON converted to YAML.';
    } catch (error) {
      output.textContent = '';
      summary.textContent = 'JSON could not be converted.';
      if (status) status.textContent = error instanceof Error ? error.message : 'Check the JSON format and try again.';
    }
  }

  input?.addEventListener('input', convertJson);
  convertButton?.addEventListener('click', convertJson);

  sampleButton?.addEventListener('click', () => {
    if (!input) return;
    input.value = sampleJson;
    convertJson();
    input.focus();
  });

  clearButton?.addEventListener('click', () => {
    if (!input) return;
    input.value = '';
    convertJson();
    input.focus();
  });

  copyButton?.addEventListener('click', async () => {
    if (!output || !status) return;
    const rendered = output.textContent || '';
    if (!rendered) {
      status.textContent = 'Nothing to copy yet.';
      return;
    }
    try {
      status.textContent = 'Copying YAML...';
      await navigator.clipboard.writeText(rendered);
      status.textContent = 'YAML copied.';
    } catch {
      status.textContent = 'Copy blocked by browser. Select the output and copy manually.';
    }
  });

  convertJson();
</script>
