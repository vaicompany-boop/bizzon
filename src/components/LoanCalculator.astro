<section class="rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm md:p-8" aria-labelledby="loan-calculator-app">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div><p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-700">Browser-only utility</p><h2 id="loan-calculator-app" class="mt-2 text-2xl font-black tracking-tight text-slate-950 md:text-3xl">Estimate a monthly loan payment</h2><p class="mt-2 text-slate-600">Enter the loan amount, interest rate, and term to estimate a fixed monthly repayment. This is an estimate, not a lending offer.</p></div>
    <div class="flex flex-wrap gap-3"><button id="sampleLoan" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Sample</button><button id="clearLoan" type="button" class="rounded-full bg-slate-950 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700">Clear</button></div>
  </div>
  <div class="mt-6 grid gap-5 lg:grid-cols-[1fr_1fr]">
    <div class="grid gap-5 rounded-3xl bg-slate-50 p-5">
      <div><label for="loanAmount" class="text-sm font-bold text-slate-700">Loan amount</label><input id="loanAmount" type="number" inputmode="decimal" min="0" step="any" value="10000" placeholder="e.g. 10000" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none focus:border-blue-400 focus:ring-4 focus:ring-blue-100" /></div>
      <div><label for="loanRate" class="text-sm font-bold text-slate-700">Annual interest rate (%)</label><input id="loanRate" type="number" inputmode="decimal" min="0" step="any" value="6.5" placeholder="e.g. 6.5" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none focus:border-blue-400 focus:ring-4 focus:ring-blue-100" /></div>
      <div><label for="loanYears" class="text-sm font-bold text-slate-700">Loan term (years)</label><input id="loanYears" type="number" inputmode="numeric" min="1" step="1" value="5" placeholder="e.g. 5" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none focus:border-blue-400 focus:ring-4 focus:ring-blue-100" /></div>
    </div>
    <div class="rounded-3xl bg-slate-950 p-5 text-white"><div class="flex items-center justify-between gap-3"><label for="loanResult" class="text-sm font-bold text-slate-300">Estimate</label><button id="copyLoanResult" type="button" class="rounded-full border border-slate-600 px-4 py-2 text-sm font-semibold text-slate-200 hover:border-blue-300 hover:text-white">Copy</button></div><textarea id="loanResult" readonly class="mt-2 min-h-48 w-full resize-y rounded-2xl border border-slate-700 bg-slate-900 p-4 font-mono text-base text-white outline-none" placeholder="Your estimate appears here"></textarea><p id="loanStatus" class="mt-2 min-h-5 text-sm font-semibold text-blue-200" aria-live="polite"></p></div>
  </div>
  <div class="mt-6 grid gap-4 md:grid-cols-3" aria-live="polite"><div class="rounded-3xl bg-blue-600 p-5 text-white"><p class="text-sm font-semibold text-blue-100">Monthly payment</p><p id="loanMonthly" class="mt-2 text-2xl font-black">—</p></div><div class="rounded-3xl bg-slate-100 p-5"><p class="text-sm font-semibold text-slate-500">Total repayment</p><p id="loanTotal" class="mt-2 text-2xl font-black text-slate-950">—</p></div><div class="rounded-3xl bg-emerald-100 p-5"><p class="text-sm font-semibold text-emerald-700">Total interest</p><p id="loanInterest" class="mt-2 text-2xl font-black text-slate-950">—</p></div></div>
</section>
<script>
  const amount = document.getElementById('loanAmount') as HTMLInputElement | null;
  const rate = document.getElementById('loanRate') as HTMLInputElement | null;
  const years = document.getElementById('loanYears') as HTMLInputElement | null;
  const result = document.getElementById('loanResult') as HTMLTextAreaElement | null;
  const status = document.getElementById('loanStatus');
  const monthly = document.getElementById('loanMonthly'); const total = document.getElementById('loanTotal'); const interest = document.getElementById('loanInterest');
  const money = (value: number) => new Intl.NumberFormat('en', { maximumFractionDigits: 2, minimumFractionDigits: 2 }).format(value);
  function setStatus(message = '') { if (status) status.textContent = message; }
  function calculate() {
    const principal = Number(amount?.value); const annualRate = Number(rate?.value); const term = Number(years?.value);
    if (![principal, annualRate, term].every(Number.isFinite) || principal <= 0 || annualRate < 0 || term <= 0) { if (result) result.value = ''; [monthly, total, interest].forEach((node) => { if (node) node.textContent = '—'; }); setStatus('Enter a positive loan amount and term, plus an interest rate of zero or more.'); return; }
    const months = Math.round(term * 12); const monthlyRate = annualRate / 100 / 12;
    const payment = monthlyRate === 0 ? principal / months : principal * (monthlyRate * Math.pow(1 + monthlyRate, months)) / (Math.pow(1 + monthlyRate, months) - 1);
    const repayment = payment * months; const interestPaid = repayment - principal;
    if (result) result.value = `Monthly payment: ${money(payment)}\nTotal repayment: ${money(repayment)}\nTotal interest: ${money(interestPaid)}\n\nBased on ${money(principal)} over ${months} months at ${annualRate}% annual interest.`;
    if (monthly) monthly.textContent = money(payment); if (total) total.textContent = money(repayment); if (interest) interest.textContent = money(interestPaid); setStatus('Updated loan estimate.');
  }
  [amount, rate, years].forEach((input) => input?.addEventListener('input', calculate));
  document.getElementById('sampleLoan')?.addEventListener('click', () => { if (amount) amount.value = '10000'; if (rate) rate.value = '6.5'; if (years) years.value = '5'; calculate(); });
  document.getElementById('clearLoan')?.addEventListener('click', () => { [amount, rate, years].forEach((input) => { if (input) input.value = ''; }); if (result) result.value = ''; [monthly, total, interest].forEach((node) => { if (node) node.textContent = '—'; }); setStatus(); });
  document.getElementById('copyLoanResult')?.addEventListener('click', async () => { if (!result) return; try { await navigator.clipboard.writeText(result.value); } catch { result.select(); document.execCommand('copy'); } setStatus(result.value ? 'Estimate copied to clipboard.' : 'Nothing to copy yet.'); });
  calculate();
</script>
