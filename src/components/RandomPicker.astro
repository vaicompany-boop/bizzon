<section class="rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm md:p-8" aria-labelledby="random-picker-app">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-700">Browser-only utility</p>
      <h2 id="random-picker-app" class="mt-2 text-2xl font-black tracking-tight text-slate-950 md:text-3xl">Pick a random item from a list</h2>
      <p class="mt-2 text-slate-600">Your list stays in your browser. Bizzon does not upload, store, or process it on a server.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <button id="samplePicker" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Sample</button>
      <button id="clearPicker" type="button" class="rounded-full bg-slate-950 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700">Clear</button>
    </div>
  </div>

  <div class="mt-6 grid gap-5 lg:grid-cols-2">
    <div>
      <label for="pickerInput" class="text-sm font-bold text-slate-700">Items to choose from</label>
      <textarea
        id="pickerInput"
        class="mt-2 min-h-80 w-full resize-y rounded-3xl border border-slate-200 bg-slate-50 p-5 text-base text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-400 focus:bg-white focus:ring-4 focus:ring-blue-100"
        placeholder="Add one item per line..."
        spellcheck="true"
      ></textarea>
      <p class="mt-2 text-sm text-slate-500">Add one item per line. Empty lines are ignored.</p>
    </div>

    <div>
      <div class="flex items-center justify-between gap-3">
        <label for="winnerOutput" class="text-sm font-bold text-slate-700">Result</label>
        <button id="copyPickerResult" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Copy result</button>
      </div>
      <textarea
        id="winnerOutput"
        class="mt-2 min-h-80 w-full resize-y rounded-3xl border border-slate-200 bg-slate-950 p-5 font-mono text-lg text-white outline-none placeholder:text-slate-400 focus:border-blue-300 focus:ring-4 focus:ring-blue-100"
        placeholder="Random pick appears here"
        readonly
      ></textarea>
      <p id="pickerStatus" class="mt-2 min-h-5 text-sm font-semibold text-blue-700" aria-live="polite"></p>
    </div>
  </div>

  <div class="mt-6 grid gap-4 md:grid-cols-[1fr_1fr_1fr]">
    <div class="rounded-3xl bg-slate-50 p-5">
      <label for="pickCount" class="text-sm font-bold text-slate-700">How many picks?</label>
      <input id="pickCount" type="number" min="1" value="3" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100" />
    </div>
    <label class="flex items-center gap-3 rounded-3xl bg-slate-50 p-5 text-sm font-bold text-slate-700">
      <input id="allowDuplicates" type="checkbox" class="h-5 w-5 rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
      Allow duplicate picks
    </label>
    <div class="grid grid-cols-2 gap-3">
      <button id="pickOne" type="button" class="rounded-3xl bg-blue-600 p-5 text-sm font-bold text-white transition hover:bg-blue-700">Pick one</button>
      <button id="pickMultiple" type="button" class="rounded-3xl border border-slate-300 bg-white p-5 text-sm font-bold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Pick multiple</button>
    </div>
  </div>

  <div class="mt-6 grid gap-4 sm:grid-cols-3" aria-live="polite">
    <div class="rounded-3xl bg-blue-600 p-5 text-white shadow-sm"><p class="text-sm font-semibold text-blue-100">Items found</p><p id="pickerItemCount" class="mt-2 text-4xl font-black">0</p></div>
    <div class="rounded-3xl bg-slate-100 p-5"><p class="text-sm font-semibold text-slate-500">Unique items</p><p id="pickerUniqueCount" class="mt-2 text-3xl font-black text-slate-950">0</p></div>
    <button id="shuffleList" type="button" class="rounded-3xl bg-amber-100 p-5 text-left transition hover:bg-amber-200"><p class="text-sm font-semibold text-amber-700">Need order?</p><p class="mt-2 text-lg font-black text-slate-950">Shuffle list</p></button>
  </div>
</section>

<script>
  const input = document.getElementById('pickerInput') as HTMLTextAreaElement | null;
  const output = document.getElementById('winnerOutput') as HTMLTextAreaElement | null;
  const pickCountInput = document.getElementById('pickCount') as HTMLInputElement | null;
  const allowDuplicates = document.getElementById('allowDuplicates') as HTMLInputElement | null;
  const pickOneButton = document.getElementById('pickOne');
  const pickMultipleButton = document.getElementById('pickMultiple');
  const shuffleButton = document.getElementById('shuffleList');
  const sampleButton = document.getElementById('samplePicker');
  const clearButton = document.getElementById('clearPicker');
  const copyButton = document.getElementById('copyPickerResult');
  const status = document.getElementById('pickerStatus');
  const countFields = {
    total: document.getElementById('pickerItemCount'),
    unique: document.getElementById('pickerUniqueCount'),
  };
  const sampleItems = ['Coffee shop', 'Bookstore', 'Long walk', 'Movie night', 'Cook dinner', 'Call a friend', 'Clean desk', 'Plan weekend'];

  function setStatus(message = '') {
    if (status) status.textContent = message;
  }

  function getItems() {
    return (input?.value || '').split(/\r?\n/).map((item) => item.trim()).filter(Boolean);
  }

  function randomIndex(max: number) {
    const values = new Uint32Array(1);
    window.crypto.getRandomValues(values);
    return values[0] % max;
  }

  function shuffle(items: string[]) {
    const copy = [...items];
    for (let index = copy.length - 1; index > 0; index -= 1) {
      const swapIndex = randomIndex(index + 1);
      [copy[index], copy[swapIndex]] = [copy[swapIndex], copy[index]];
    }
    return copy;
  }

  function updateCounts() {
    const items = getItems();
    if (countFields.total) countFields.total.textContent = String(items.length);
    if (countFields.unique) countFields.unique.textContent = String(new Set(items.map((item) => item.toLocaleLowerCase())).size);
  }

  function renderResult(results: string[]) {
    if (!output) return;
    output.value = results.map((item, index) => `${index + 1}. ${item}`).join('\n');
    setStatus(results.length ? `Picked ${results.length} item${results.length === 1 ? '' : 's'}.` : 'Add items first.');
  }

  function pick(count: number) {
    const items = getItems();
    updateCounts();
    if (!items.length) {
      renderResult([]);
      return;
    }
    if (allowDuplicates?.checked) {
      renderResult(Array.from({ length: count }, () => items[randomIndex(items.length)]));
      return;
    }
    renderResult(shuffle(items).slice(0, Math.min(count, items.length)));
  }

  function pickMultiple() {
    const requested = Math.max(1, Number(pickCountInput?.value || 1));
    pick(requested);
  }

  input?.addEventListener('input', () => { updateCounts(); setStatus(); });
  pickCountInput?.addEventListener('input', () => setStatus());
  pickOneButton?.addEventListener('click', () => pick(1));
  pickMultipleButton?.addEventListener('click', pickMultiple);
  shuffleButton?.addEventListener('click', () => {
    const items = getItems();
    if (!items.length) { renderResult([]); return; }
    renderResult(shuffle(items));
  });
  sampleButton?.addEventListener('click', () => { if (!input) return; input.value = sampleItems.join('\n'); updateCounts(); pick(1); input.focus(); });
  clearButton?.addEventListener('click', () => { if (!input || !output) return; input.value = ''; output.value = ''; updateCounts(); setStatus(); input.focus(); });
  copyButton?.addEventListener('click', async () => {
    if (!output) return;
    try {
      await navigator.clipboard.writeText(output.value);
      setStatus(output.value ? 'Copied to clipboard.' : 'Nothing to copy yet.');
    } catch {
      output.select();
      document.execCommand('copy');
      setStatus(output.value ? 'Copied to clipboard.' : 'Nothing to copy yet.');
    }
  });
  updateCounts();
</script>
