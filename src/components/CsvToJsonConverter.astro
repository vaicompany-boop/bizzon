<section class="rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm md:p-8" aria-labelledby="csv-json-app">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-700">Browser-only converter</p>
      <h2 id="csv-json-app" class="mt-2 text-2xl font-black tracking-tight text-slate-950 md:text-3xl">Convert CSV rows into JSON</h2>
      <p class="mt-2 text-slate-600">Paste CSV, TSV, semicolon, or pipe-separated data and get clean JSON without uploading anything.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <button id="sampleCsv" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Sample</button>
      <button id="copyJson" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Copy JSON</button>
      <button id="clearCsv" type="button" class="rounded-full bg-slate-950 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700">Clear</button>
    </div>
  </div>

  <div class="mt-6 grid gap-5 lg:grid-cols-2">
    <div>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <label for="csvInput" class="text-sm font-bold text-slate-700">CSV input</label>
        <div class="flex flex-wrap items-center gap-3 text-sm text-slate-600">
          <label class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3 py-2">
            <input id="hasHeader" type="checkbox" class="size-4 rounded border-slate-300 text-blue-600" checked />
            First row has headers
          </label>
          <label class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3 py-2">
            Delimiter
            <select id="delimiterSelect" class="bg-transparent font-semibold text-slate-800 outline-none">
              <option value="auto">Auto</option>
              <option value=",">Comma</option>
              <option value="tab">Tab</option>
              <option value=";">Semicolon</option>
              <option value="|">Pipe</option>
            </select>
          </label>
        </div>
      </div>
      <textarea
        id="csvInput"
        class="mt-3 min-h-[28rem] w-full resize-y rounded-3xl border border-slate-200 bg-slate-50 p-5 font-mono text-sm leading-6 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-400 focus:bg-white focus:ring-4 focus:ring-blue-100"
        placeholder="name,email,role&#10;Amina,amina@example.com,Editor&#10;Marko,marko@example.com,Developer"
        spellcheck="false"
      ></textarea>
    </div>

    <div>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm font-bold text-slate-700">JSON output</p>
        <p id="summary" class="text-sm font-semibold text-slate-500" aria-live="polite">Paste CSV to convert it.</p>
      </div>
      <pre class="mt-3 min-h-[28rem] overflow-auto rounded-3xl border border-slate-200 bg-slate-950 p-5 text-sm leading-6 text-slate-50"><code id="jsonOutput">[]</code></pre>
      <p id="status" class="mt-3 min-h-6 text-sm font-semibold text-blue-700" role="status"></p>
    </div>
  </div>

  <div class="mt-6 grid gap-4 rounded-3xl border border-blue-100 bg-blue-50 p-5 text-sm text-blue-950 md:grid-cols-3">
    <p><strong>Private:</strong> conversion runs locally in your browser.</p>
    <p><strong>Quoted cells:</strong> commas and line breaks inside quotes are supported.</p>
    <p><strong>Header mode:</strong> use the first row as keys, or turn it off for arrays.</p>
  </div>
</section>

<script>
  const csvInput = document.getElementById('csvInput') as HTMLTextAreaElement | null;
  const jsonOutput = document.getElementById('jsonOutput');
  const hasHeader = document.getElementById('hasHeader') as HTMLInputElement | null;
  const delimiterSelect = document.getElementById('delimiterSelect') as HTMLSelectElement | null;
  const sampleButton = document.getElementById('sampleCsv');
  const copyButton = document.getElementById('copyJson');
  const clearButton = document.getElementById('clearCsv');
  const status = document.getElementById('status');
  const summary = document.getElementById('summary');

  const sampleCsv = `name,email,role,notes\nAmina Hadzic,amina@example.com,Editor,"Writes, edits, and publishes"\nMarko Ilic,marko@example.com,Developer,"Handles CSV exports"\nLejla Basic,lejla@example.com,Analyst,"Checks \"quoted\" cells"`;

  function resolveDelimiter(text: string) {
    const selected = delimiterSelect?.value || 'auto';
    if (selected === 'tab') return '\t';
    if (selected !== 'auto') return selected;
    const firstLine = text.split(/\r?\n/).find((line) => line.trim().length > 0) || '';
    const candidates = [',', '\t', ';', '|'];
    return candidates
      .map((delimiter) => ({ delimiter, count: firstLine.split(delimiter).length - 1 }))
      .sort((a, b) => b.count - a.count)[0]?.delimiter || ',';
  }

  function parseCsv(text: string, delimiter: string) {
    const rows: string[][] = [];
    let row: string[] = [];
    let cell = '';
    let inQuotes = false;

    for (let index = 0; index < text.length; index += 1) {
      const char = text[index];
      const next = text[index + 1];

      if (char === '"') {
        if (inQuotes && next === '"') {
          cell += '"';
          index += 1;
        } else {
          inQuotes = !inQuotes;
        }
        continue;
      }

      if (char === delimiter && !inQuotes) {
        row.push(cell.trim());
        cell = '';
        continue;
      }

      if ((char === '\n' || char === '\r') && !inQuotes) {
        if (char === '\r' && next === '\n') index += 1;
        row.push(cell.trim());
        if (row.some((value) => value.length > 0)) rows.push(row);
        row = [];
        cell = '';
        continue;
      }

      cell += char;
    }

    if (inQuotes) throw new Error('There is an unclosed quoted field. Check quotation marks in the CSV.');
    row.push(cell.trim());
    if (row.some((value) => value.length > 0)) rows.push(row);
    return rows;
  }

  function makeUniqueHeaders(headers: string[]) {
    const seen = new Map<string, number>();
    return headers.map((header, index) => {
      const base = header.trim() || `column_${index + 1}`;
      const count = seen.get(base) || 0;
      seen.set(base, count + 1);
      return count === 0 ? base : `${base}_${count + 1}`;
    });
  }

  function convertCsv() {
    if (!csvInput || !jsonOutput || !summary) return;
    const text = csvInput.value.trim();
    if (!text) {
      jsonOutput.textContent = '[]';
      summary.textContent = 'Paste CSV to convert it.';
      if (status) status.textContent = '';
      return;
    }

    try {
      const delimiter = resolveDelimiter(text);
      const rows = parseCsv(text, delimiter);
      if (rows.length === 0) {
        jsonOutput.textContent = '[]';
        summary.textContent = 'No rows found.';
        return;
      }

      const headerMode = hasHeader?.checked ?? true;
      let data: unknown[];
      if (headerMode) {
        const headers = makeUniqueHeaders(rows[0] || []);
        data = rows.slice(1).map((row) => Object.fromEntries(headers.map((header, index) => [header, row[index] ?? ''])));
      } else {
        data = rows;
      }

      jsonOutput.textContent = JSON.stringify(data, null, 2);
      const visibleDelimiter = delimiter === '\t' ? 'tab' : delimiter;
      summary.textContent = `${data.length} ${data.length === 1 ? 'record' : 'records'} converted · delimiter: ${visibleDelimiter}`;
      if (status) status.textContent = '';
    } catch (error) {
      jsonOutput.textContent = '[]';
      summary.textContent = 'Could not parse CSV.';
      if (status) status.textContent = error instanceof Error ? error.message : 'Check the CSV format and try again.';
    }
  }

  csvInput?.addEventListener('input', convertCsv);
  hasHeader?.addEventListener('change', convertCsv);
  delimiterSelect?.addEventListener('change', convertCsv);

  sampleButton?.addEventListener('click', () => {
    if (!csvInput) return;
    csvInput.value = sampleCsv;
    convertCsv();
    csvInput.focus();
  });

  clearButton?.addEventListener('click', () => {
    if (!csvInput) return;
    csvInput.value = '';
    convertCsv();
    csvInput.focus();
  });

  copyButton?.addEventListener('click', async () => {
    if (!jsonOutput || !status) return;
    const output = jsonOutput.textContent || '[]';
    if (output === '[]') {
      status.textContent = 'Nothing to copy yet.';
      return;
    }
    try {
      status.textContent = 'Copying JSON...';
      await navigator.clipboard.writeText(output);
      status.textContent = 'JSON copied.';
    } catch {
      status.textContent = 'Copy blocked by browser. Select the JSON output and copy manually.';
    }
  });

  convertCsv();
</script>
