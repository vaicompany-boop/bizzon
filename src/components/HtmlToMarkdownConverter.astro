<section class="rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm md:p-8" aria-labelledby="html-markdown-tool-app">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-700">Browser-only converter</p>
      <h2 id="html-markdown-tool-app" class="mt-2 text-2xl font-black tracking-tight text-slate-950 md:text-3xl">Convert HTML to Markdown</h2>
      <p class="mt-2 text-slate-600">Paste HTML, turn common tags into readable Markdown, and copy the result locally in your browser.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <button id="sampleHtml" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Sample</button>
      <button id="convertHtml" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Convert</button>
      <button id="copyMarkdown" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700">Copy Markdown</button>
      <button id="clearHtml" type="button" class="rounded-full bg-slate-950 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700">Clear</button>
    </div>
  </div>

  <div class="mt-6 grid gap-5 lg:grid-cols-2">
    <div>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <label for="htmlInput" class="text-sm font-bold text-slate-700">HTML input</label>
        <p class="text-sm font-semibold text-slate-500">Headings, paragraphs, links, lists, quotes, code</p>
      </div>
      <textarea
        id="htmlInput"
        class="mt-3 min-h-[30rem] w-full resize-y rounded-3xl border border-slate-200 bg-slate-50 p-5 font-mono text-sm leading-6 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-400 focus:bg-white focus:ring-4 focus:ring-blue-100"
        placeholder="<h1>Page title</h1>\n<p>Paste HTML here...</p>"
        spellcheck="false"
      ></textarea>
    </div>

    <div>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm font-bold text-slate-700">Markdown output</p>
        <p id="htmlMarkdownSummary" class="text-sm font-semibold text-slate-500" aria-live="polite">Enter HTML to convert.</p>
      </div>
      <pre class="mt-3 min-h-[30rem] overflow-auto whitespace-pre-wrap break-words rounded-3xl border border-slate-200 bg-slate-950 p-5 text-sm leading-6 text-slate-50"><code id="htmlMarkdownOutput"></code></pre>
      <p id="htmlMarkdownStatus" class="mt-3 min-h-6 text-sm font-semibold text-blue-700" role="status"></p>
    </div>
  </div>

  <div class="mt-6 rounded-3xl border border-slate-200 bg-slate-50 p-5">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <h3 class="text-lg font-bold text-slate-950">Text preview</h3>
      <p class="text-sm font-semibold text-slate-500">Script, style, iframe, and form content is skipped.</p>
    </div>
    <div id="htmlMarkdownPreview" class="mt-4 min-h-36 whitespace-pre-wrap rounded-2xl border border-slate-200 bg-white p-5 text-sm leading-7 text-slate-800">
      Converted text preview will appear here.
    </div>
  </div>

  <div class="mt-6 grid gap-4 rounded-3xl border border-blue-100 bg-blue-50 p-5 text-sm text-blue-950 md:grid-cols-3">
    <p><strong>Private:</strong> HTML conversion runs locally in your browser; pasted content is not uploaded.</p>
    <p><strong>Practical subset:</strong> supports common article/document HTML first, including headings, links, lists, quotes, code and tables.</p>
    <p><strong>Safe output:</strong> active content such as scripts, styles, iframes and forms is ignored instead of copied into Markdown.</p>
  </div>
</section>

<script>
  const input = document.getElementById('htmlInput') as HTMLTextAreaElement | null;
  const output = document.getElementById('htmlMarkdownOutput');
  const summary = document.getElementById('htmlMarkdownSummary');
  const status = document.getElementById('htmlMarkdownStatus');
  const preview = document.getElementById('htmlMarkdownPreview');
  const sampleButton = document.getElementById('sampleHtml');
  const convertButton = document.getElementById('convertHtml');
  const copyButton = document.getElementById('copyMarkdown');
  const clearButton = document.getElementById('clearHtml');

  const sampleHtml = `<article>\n  <h1>Launch checklist</h1>\n  <p>Write copy that is <strong>clear</strong>, <em>short</em>, and useful.</p>\n  <h2>Steps</h2>\n  <ol>\n    <li>Paste HTML</li>\n    <li>Convert to Markdown</li>\n    <li>Copy the result</li>\n  </ol>\n  <blockquote>Bizzon keeps this conversion in your browser.</blockquote>\n  <p>Safe link: <a href="https://bizzon.app/tools">Bizzon tools</a></p>\n  <pre><code>npm run build</code></pre>\n  <script>alert('ignored')<\/script>\n</article>`;

  const blockTags = new Set(['ADDRESS', 'ARTICLE', 'ASIDE', 'DIV', 'FOOTER', 'HEADER', 'MAIN', 'NAV', 'SECTION']);
  const skipTags = new Set(['SCRIPT', 'STYLE', 'IFRAME', 'OBJECT', 'EMBED', 'NOSCRIPT', 'FORM', 'INPUT', 'BUTTON', 'SELECT', 'TEXTAREA', 'SVG', 'CANVAS']);

  function normalizeBlankLines(value: string) {
    return value
      .replace(/[ \t]+\n/g, '\n')
      .replace(/\n{3,}/g, '\n\n')
      .trim();
  }

  function escapeMarkdown(value: string) {
    return value.replace(/([\\`*_{}[\]()#+|>])/g, '\\$1');
  }

  function getHref(element: Element) {
    const href = element.getAttribute('href') || '';
    const trimmed = href.trim();
    if (/^(https?:|mailto:|tel:)/i.test(trimmed)) return trimmed;
    if (/^(\/|#)/.test(trimmed)) return trimmed;
    return '';
  }

  function inlineChildren(element: Element) {
    return Array.from(element.childNodes).map((child) => nodeToMarkdown(child, true)).join('').replace(/[ \t\n]+/g, ' ').trim();
  }

  function tableToMarkdown(table: Element) {
    const rows = Array.from(table.querySelectorAll('tr')).map((row) =>
      Array.from(row.querySelectorAll('th,td')).map((cell) => inlineChildren(cell).replace(/\|/g, '\\|')),
    ).filter((row) => row.length);
    if (!rows.length) return '';
    const width = Math.max(...rows.map((row) => row.length));
    const padded = rows.map((row) => [...row, ...Array(Math.max(0, width - row.length)).fill('')]);
    const header = padded[0];
    const separator = Array(width).fill('---');
    const body = padded.slice(1);
    return `\n\n| ${header.join(' | ')} |\n| ${separator.join(' | ')} |${body.length ? `\n${body.map((row) => `| ${row.join(' | ')} |`).join('\n')}` : ''}\n\n`;
  }

  function listToMarkdown(list: Element, ordered: boolean) {
    const items = Array.from(list.children).filter((child) => child.tagName === 'LI');
    const lines = items.map((item, index) => {
      const marker = ordered ? `${index + 1}.` : '-';
      const text = Array.from(item.childNodes).map((child) => nodeToMarkdown(child, true)).join('').replace(/[ \t\n]+/g, ' ').trim();
      return `${marker} ${text}`;
    });
    return `\n\n${lines.join('\n')}\n\n`;
  }

  function nodeToMarkdown(node: Node, inline = false): string {
    if (node.nodeType === Node.TEXT_NODE) {
      return escapeMarkdown(node.textContent || '');
    }
    if (node.nodeType !== Node.ELEMENT_NODE) return '';

    const element = node as Element;
    const tag = element.tagName;
    if (skipTags.has(tag)) return '';

    switch (tag) {
      case 'H1': return `\n\n# ${inlineChildren(element)}\n\n`;
      case 'H2': return `\n\n## ${inlineChildren(element)}\n\n`;
      case 'H3': return `\n\n### ${inlineChildren(element)}\n\n`;
      case 'H4': return `\n\n#### ${inlineChildren(element)}\n\n`;
      case 'H5': return `\n\n##### ${inlineChildren(element)}\n\n`;
      case 'H6': return `\n\n###### ${inlineChildren(element)}\n\n`;
      case 'P': return inline ? inlineChildren(element) : `\n\n${inlineChildren(element)}\n\n`;
      case 'BR': return inline ? '  \n' : '\n';
      case 'HR': return '\n\n---\n\n';
      case 'STRONG':
      case 'B': return `**${inlineChildren(element)}**`;
      case 'EM':
      case 'I': return `_${inlineChildren(element)}_`;
      case 'CODE': return `\`${(element.textContent || '').replace(/`/g, '\\`')}\``;
      case 'PRE': return `\n\n\`\`\`\n${element.textContent?.trim() || ''}\n\`\`\`\n\n`;
      case 'A': {
        const text = inlineChildren(element) || getHref(element);
        const href = getHref(element);
        return href ? `[${text}](${href})` : text;
      }
      case 'IMG': {
        const alt = element.getAttribute('alt') || 'image';
        const src = element.getAttribute('src') || '';
        return src ? `![${escapeMarkdown(alt)}](${src})` : `![${escapeMarkdown(alt)}]`;
      }
      case 'BLOCKQUOTE': {
        const quoted = normalizeBlankLines(Array.from(element.childNodes).map((child) => nodeToMarkdown(child)).join(''));
        return `\n\n${quoted.split('\n').map((line) => `> ${line}`).join('\n')}\n\n`;
      }
      case 'UL': return listToMarkdown(element, false);
      case 'OL': return listToMarkdown(element, true);
      case 'TABLE': return tableToMarkdown(element);
      case 'TR':
      case 'TD':
      case 'TH': return inlineChildren(element);
      default: {
        const content = Array.from(element.childNodes).map((child) => nodeToMarkdown(child, inline)).join('');
        if (!inline && blockTags.has(tag)) return `\n\n${content}\n\n`;
        return content;
      }
    }
  }

  function convertHtml(html: string) {
    const parser = new DOMParser();
    const documentHtml = parser.parseFromString(html, 'text/html');
    const markdown = normalizeBlankLines(Array.from(documentHtml.body.childNodes).map((child) => nodeToMarkdown(child)).join(''));
    const blocks = markdown ? markdown.split(/\n{2,}/).filter(Boolean).length : 0;
    const sourceNodes = documentHtml.body.querySelectorAll('*').length;
    return { markdown, blocks, sourceNodes };
  }

  function updateResult(markdown: string, message: string, tone: 'ok' | 'error' = 'ok') {
    if (output) output.textContent = markdown;
    if (preview) preview.textContent = markdown || 'Converted text preview will appear here.';
    if (summary) summary.textContent = message;
    if (status) {
      status.textContent = tone === 'error' ? message : '';
      status.className = `mt-3 min-h-6 text-sm font-semibold ${tone === 'error' ? 'text-red-700' : 'text-blue-700'}`;
    }
  }

  function convertInput() {
    if (!input) return;
    const html = input.value;
    if (!html.trim()) {
      updateResult('', 'Enter HTML to convert.', 'error');
      return;
    }
    const result = convertHtml(html);
    if (!result.markdown) {
      updateResult('', 'No readable HTML content found.', 'error');
      return;
    }
    updateResult(result.markdown, `Converted ${result.sourceNodes} HTML ${result.sourceNodes === 1 ? 'element' : 'elements'} into ${result.blocks} Markdown ${result.blocks === 1 ? 'block' : 'blocks'}.`);
  }

  sampleButton?.addEventListener('click', () => {
    if (!input) return;
    input.value = sampleHtml;
    convertInput();
    input.focus();
  });

  convertButton?.addEventListener('click', convertInput);
  input?.addEventListener('input', () => {
    if (input.value.trim()) convertInput();
    else updateResult('', 'Enter HTML to convert.');
  });

  clearButton?.addEventListener('click', () => {
    if (!input) return;
    input.value = '';
    updateResult('', 'Enter HTML to convert.');
    input.focus();
  });

  copyButton?.addEventListener('click', async () => {
    if (!output || !status) return;
    const markdown = output.textContent || '';
    if (!markdown) {
      status.textContent = 'Nothing to copy yet.';
      status.className = 'mt-3 min-h-6 text-sm font-semibold text-red-700';
      return;
    }
    try {
      status.textContent = 'Copying Markdown...';
      status.className = 'mt-3 min-h-6 text-sm font-semibold text-blue-700';
      await navigator.clipboard.writeText(markdown);
      status.textContent = 'Markdown copied.';
    } catch {
      status.textContent = 'Copy blocked by browser. Select the Markdown output and copy manually.';
      status.className = 'mt-3 min-h-6 text-sm font-semibold text-red-700';
    }
  });
</script>
