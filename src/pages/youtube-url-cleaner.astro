---
import YoutubeUrlCleaner from '../components/YoutubeUrlCleaner.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout
  title="YouTube URL Cleaner — Remove tracking parameters | Bizzon"
  description="Free browser-based YouTube URL cleaner by Bizzon. Remove si, feature, UTM, fbclid, gclid, and other tracking parameters while preserving useful video, playlist, Shorts, embed, live, and channel links."
  canonicalPath="/youtube-url-cleaner"
  heading="YouTube URL Cleaner"
  intro="Clean YouTube links before sharing. Remove tracking parameters while keeping the video ID, playlist ID, timestamp, Shorts, embed, live, playlist, channel, or handle path that actually matters."
>
  <YoutubeUrlCleaner />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">No backend or scraping</h2><p class="mt-3 text-slate-600">The cleaner runs entirely in your browser. It rewrites URL text only and never downloads videos, audio, thumbnails, comments, or private content.</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Keeps useful context</h2><p class="mt-3 text-slate-600">Video IDs, playlist IDs, index, timestamp, start time, and channel paths stay when they are part of the useful share link.</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Removes sharing noise</h2><p class="mt-3 text-slate-600">Common tracking parameters such as <code>si</code>, <code>feature</code>, <code>utm_*</code>, <code>fbclid</code>, <code>gclid</code>, and fragments are removed for a shorter link.</p></div>
  </section>
</ToolLayout>
