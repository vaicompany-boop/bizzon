---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools } from '../data/tools';
import { supportPageLinks } from '../data/supportPages';
const liveTools = tools.filter((tool) => tool.status === 'live');
const plannedTools = tools.filter((tool) => tool.status === 'planned');
const liveToolCount = liveTools.length;
const useCases = [
  { title: 'Need writing stats?', text: 'Use this if you need to count words, characters, lines, paragraphs, or reading time before publishing.', href: '/word-counter', cta: 'Open Word Counter' },
  { title: 'Need a character limit?', text: 'Use this if you need to fit a post, bio, title, description, or form field into a specific limit.', href: '/character-counter', cta: 'Open Character Counter' },
  { title: 'Need clean pasted text?', text: 'Use this if you need to remove extra spaces, empty lines, tabs, smart quotes, or messy formatting.', href: '/text-cleaner', cta: 'Open Text Cleaner' },
  { title: 'Need a different text case?', text: 'Use this if you need to convert text to title case, sentence case, camelCase, kebab-case, or snake_case.', href: '/case-converter', cta: 'Open Case Converter' },
  { title: 'Need a clean URL slug?', text: 'Use this if you need to turn a title, headline, filename, or phrase into a readable URL slug.', href: '/slug-generator', cta: 'Open Slug Generator' },
  { title: 'Need SEO snippet checks?', text: 'Use this if you need to preview and measure a meta title and description before publishing.', href: '/meta-title-description-checker', cta: 'Open Meta Checker' },
  { title: 'Need a strong password?', text: 'Use this if you need to generate a unique random password locally in your browser.', href: '/password-generator', cta: 'Open Password Generator' },
  { title: 'Need to pick from a list?', text: 'Use this if you need to choose a random winner, task, meal, name, or option from a list.', href: '/random-picker', cta: 'Open Random Picker' },
  { title: 'Need a quick unit conversion?', text: 'Use this if you need to convert length, weight, or temperature without a heavy calculator app.', href: '/unit-converter', cta: 'Open Unit Converter' },
  { title: 'Need date math?', text: 'Use this if you need to add days, subtract days, or count days between two dates.', href: '/date-calculator', cta: 'Open Date Calculator' },
  { title: 'Need percentage math?', text: 'Use this if you need to calculate discounts, increases, decreases, or percentage change quickly.', href: '/percentage-calculator', cta: 'Open Percentage Calculator' },
  { title: 'Need clean filenames?', text: 'Use this if you need to rename uploads, product images, archives, or shared files into readable web-friendly names.', href: '/filename-cleaner', cta: 'Open Filename Cleaner' },
  { title: 'Need to split a bill?', text: 'Use this if you need to calculate a tip, split a restaurant bill, or get a clean per-person total.', href: '/tip-calculator', cta: 'Open Tip Calculator' },
  { title: 'Need VAT or sales tax?', text: 'Use this if you need to add tax to a net price or remove included tax from a final price.', href: '/vat-sales-tax-calculator', cta: 'Open VAT Calculator' },
  { title: 'Need a QR code?', text: 'Use this if you need to turn a link, short text, or sharing detail into a downloadable QR code.', href: '/qr-code-generator', cta: 'Open QR Generator' },
  { title: 'Need to make an invoice?', text: 'Use this if you need to create an invoice with your business details, client details, line items, tax totals, and a PDF download.', href: '/invoice-maker', cta: 'Open Invoice Maker' },
];

const toolGroups = [
  { label: 'Text and publishing', links: liveTools.filter((tool) => ['/word-counter', '/character-counter', '/text-cleaner', '/case-converter', '/slug-generator', '/meta-title-description-checker'].includes(tool.href)) },
  { label: 'Decisions and security', links: liveTools.filter((tool) => ['/password-generator', '/random-picker', '/qr-code-generator'].includes(tool.href)) },
  { label: 'Calculators and invoices', links: liveTools.filter((tool) => ['/unit-converter', '/date-calculator', '/percentage-calculator', '/filename-cleaner', '/tip-calculator', '/vat-sales-tax-calculator', '/invoice-maker'].includes(tool.href)) },
];
---

<BaseLayout title="Tools — Bizzon" description="Browse Bizzon's free browser-based tools for text, SEO, invoices, passwords, random picking, unit conversion, date math, percentage math, filename cleanup, tip calculation, VAT or sales tax, QR codes, and everyday productivity." canonicalPath="/tools">
  <section class="mx-auto max-w-6xl px-5 py-14 md:py-20">
    <div class="grid gap-8 md:grid-cols-[1fr_18rem] md:items-end">
      <div class="max-w-3xl"><p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-700">Toolbox</p><h1 class="mt-4 text-4xl font-black tracking-tight text-slate-950 md:text-6xl">Useful tools for small everyday tasks.</h1><p class="mt-5 text-lg text-slate-600">Bizzon has <strong>{liveToolCount} live tools</strong> for text and publishing, invoices, passwords and random choices, conversions, date and percentage math, filenames, bill splitting, VAT or sales tax estimates, and QR codes. All tools are fast, private, and browser-based.</p></div>
      <div class="rounded-[2rem] border border-blue-100 bg-blue-50 p-6"><p class="text-4xl font-black text-blue-700">{liveToolCount}</p><p class="mt-2 font-bold text-slate-950">Live tools</p><p class="mt-2 text-sm text-slate-600">The toolbox now covers text, publishing, security, decisions, conversions, date math, bill-splitting, tax, and QR utilities.</p></div>
    </div>

    <section class="mt-10 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm md:p-8" aria-labelledby="categories-heading">
      <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between"><div><p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-700">Browse by category</p><h2 id="categories-heading" class="mt-3 text-3xl font-black text-slate-950">Find the right utility faster.</h2></div><p class="max-w-xl text-slate-600">Grouped internal links help people and search engines understand the toolbox.</p></div>
      <div class="mt-6 grid gap-5 md:grid-cols-3">
        {toolGroups.map((group) => (
          <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
            <h3 class="font-bold text-slate-950">{group.label}</h3>
            <div class="mt-4 grid gap-2 text-sm font-semibold text-blue-700">
              {group.links.map((tool) => <a href={tool.href}>{tool.title}</a>)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-12" aria-labelledby="live-tools-heading">
      <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between"><div><p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-700">Live tools</p><h2 id="live-tools-heading" class="mt-3 text-3xl font-black text-slate-950">Use one now.</h2></div><p class="max-w-xl text-slate-600">No login, no upload, no setup. Choose the tool that matches the job.</p></div>
      <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-4">{liveTools.map((tool) => <ToolCard tool={tool} />)}</div>
    </section>

    <section class="mt-14 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm md:p-8" aria-labelledby="use-cases-heading">
      <h2 id="use-cases-heading" class="text-3xl font-black text-slate-950">Which tool should I use?</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {useCases.map((item) => (
          <a class="rounded-3xl border border-slate-200 bg-slate-50 p-5 transition hover:-translate-y-1 hover:border-blue-200 hover:bg-blue-50" href={item.href}>
            <h3 class="text-lg font-bold text-slate-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">{item.text}</p>
            <p class="mt-4 text-sm font-bold text-blue-700">{item.cta} →</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-14 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm md:p-8" aria-labelledby="support-guides-heading">
      <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-700">Guides</p>
          <h2 id="support-guides-heading" class="mt-3 text-3xl font-black text-slate-950">Guides for choosing the right tool.</h2>
        </div>
        <p class="max-w-xl text-slate-600">Short practical pages connect common tasks to the fastest Bizzon tools.</p>
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {supportPageLinks.map((page) => (
          <a class="rounded-3xl border border-slate-200 bg-slate-50 p-5 transition hover:-translate-y-1 hover:border-blue-200 hover:bg-blue-50" href={page.href}>
            <h3 class="font-bold text-slate-950">{page.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">{page.description}</p>
            <p class="mt-4 text-sm font-bold text-blue-700">Read guide →</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-14" aria-labelledby="planned-tools-heading">
      <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between"><div><p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-700">Coming next</p><h2 id="planned-tools-heading" class="mt-3 text-3xl font-black text-slate-950">Planned utility roadmap.</h2></div><p class="max-w-xl text-slate-600">Next up: practical utilities such as loan estimates, small business naming tools, and more document helpers.</p></div>
      <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{plannedTools.map((tool) => <ToolCard tool={tool} />)}</div>
    </section>
  </section>
</BaseLayout>
