---
import MarkdownToHtmlConverter from '../components/MarkdownToHtmlConverter.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout
  title="Markdown to HTML Converter — Free browser tool | Bizzon"
  description="Free browser-based Markdown to HTML converter by Bizzon. Paste Markdown, preview safe HTML, and copy the result locally in your browser."
  canonicalPath="/markdown-to-html"
  heading="Markdown to HTML Converter"
  intro="Convert Markdown into clean HTML with a safe browser-only preview and copy-ready output."
>
  <MarkdownToHtmlConverter />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Preview before copying</h2><p class="mt-3 text-slate-600">Use the side-by-side output and preview to check headings, lists, links, quotes, and code before you paste HTML elsewhere.</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Safer by default</h2><p class="mt-3 text-slate-600">Raw HTML from your Markdown is escaped, so script tags and unsafe snippets show as text instead of running in the preview.</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Runs in your browser</h2><p class="mt-3 text-slate-600">Bizzon does not upload or store the drafts you paste. The conversion happens locally on your device.</p></div>
  </section>
</ToolLayout>
