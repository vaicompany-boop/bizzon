---
import FilenameCleaner from '../components/FilenameCleaner.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
import ToolSeoSections from '../components/ToolSeoSections.astro';
---

<ToolLayout
  title="Filename Cleaner — Clean filenames in bulk | Bizzon"
  description="Free browser-based Filename Cleaner by Bizzon. Turn messy filenames into clean, readable, web-friendly names locally in your browser."
  canonicalPath="/filename-cleaner"
  heading="Filename Cleaner"
  intro="Clean messy filenames before uploading, sharing, archiving, or publishing files online."
>
  <FilenameCleaner />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Bulk filename cleanup</h2>
      <p class="mt-3 text-slate-600">Paste one filename per line and clean spaces, special characters, accents, casing, and duplicates in one pass.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Web-friendly names</h2>
      <p class="mt-3 text-slate-600">Create readable names with hyphens or underscores for uploads, websites, product images, archives, and shared folders.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Private by default</h2>
      <p class="mt-3 text-slate-600">Your filenames stay in your browser. Bizzon does not upload, save, or process your list on a server.</p>
    </div>
  </section>
  <section class="mt-10 rounded-[2rem] border border-slate-200 bg-blue-50 p-6 md:p-8">
    <h2 class="text-2xl font-black text-slate-950">Related tools</h2>
    <p class="mt-4 text-slate-700">Need clean URL slugs? Try the <a class="font-bold text-blue-700" href="/slug-generator">Slug Generator</a>. Need to remove messy copy-paste formatting? Use the <a class="font-bold text-blue-700" href="/text-cleaner">Text Cleaner</a>. Need quick percentage math? Open the <a class="font-bold text-blue-700" href="/percentage-calculator">Percentage Calculator</a>.</p>
  </section>
  <ToolSeoSections slug="filename-cleaner" />
</ToolLayout>
