---
import TiktokCaptionHashtagCleaner from '../components/TiktokCaptionHashtagCleaner.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout
  title="TikTok Caption & Hashtag Cleaner — Dedupe tags locally | Bizzon"
  description="Free browser-based TikTok caption and hashtag cleaner by Bizzon. Clean spacing, dedupe hashtags, count caption length, and copy a ready-to-post caption locally."
  canonicalPath="/tiktok-caption-hashtag-cleaner"
  heading="TikTok Caption & Hashtag Cleaner"
  intro="Clean messy TikTok caption drafts before posting. Bizzon normalizes spacing, removes duplicate hashtags, counts the 2,200-character caption limit, and keeps everything local in your browser."
>
  <TiktokCaptionHashtagCleaner />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Clean short-form captions</h2>
      <p class="mt-3 text-slate-600">Remove repeated spaces and blank-line clutter while preserving useful line breaks for hooks, context, and calls to action.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Dedupe hashtags</h2>
      <p class="mt-3 text-slate-600">Repeated hashtags are removed case-insensitively. You can also lowercase tags for a consistent final caption.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">No scraping or downloads</h2>
      <p class="mt-3 text-slate-600">This is a text-only browser utility. There is no TikTok API, login, video downloader, audio downloader, or watermark remover.</p>
    </div>
  </section>
  <section class="mt-10 rounded-[2rem] border border-slate-200 bg-blue-50 p-6 md:p-8">
    <h2 class="text-2xl font-black text-slate-950">Related creator tools</h2>
    <p class="mt-4 text-slate-700">Preparing the same post for other platforms? Try the <a class="font-bold text-blue-700" href="/instagram-caption-formatter">Instagram Caption Formatter</a> or check length with the <a class="font-bold text-blue-700" href="/x-character-counter">X / Twitter Character Counter</a>.</p>
  </section>
</ToolLayout>
