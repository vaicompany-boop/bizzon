---
import ToolLayout from '../layouts/ToolLayout.astro';
import ToolSeoSections from '../components/ToolSeoSections.astro';

const invoiceAppUrl = 'https://invoice-maker-chi-lyart.vercel.app/';
---

<ToolLayout
  title="Invoice Maker — Create and download PDF invoices | Bizzon"
  description="Open Bizzon's dedicated Invoice Maker app to create invoices with business details, client details, line items, tax, totals, notes, and downloadable PDFs."
  canonicalPath="/invoice-maker"
  heading="Invoice Maker"
  intro="Create invoices in the dedicated Bizzon invoice app. It keeps the full invoice workflow intact: clients, invoices, settings, stats, PDF generation, and local browser storage."
>
  <section class="rounded-[2rem] border border-blue-100 bg-gradient-to-br from-blue-50 to-white p-6 shadow-sm md:p-8">
    <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div>
        <p class="text-sm font-black uppercase tracking-[0.24em] text-blue-700">Dedicated invoice workspace</p>
        <h2 class="mt-4 text-3xl font-black tracking-tight text-slate-950 md:text-5xl">Open the full Invoice Maker app.</h2>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-700">
          The invoice workflow now runs as its own app so the existing experience stays intact. Use it for creating invoices, managing clients, viewing stats, updating company settings, and downloading invoice PDFs.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            class="rounded-full bg-blue-600 px-6 py-3 text-sm font-black uppercase tracking-[0.14em] text-white shadow-sm transition hover:bg-blue-700 hover:text-white"
            href={invoiceAppUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Open Invoice Maker
          </a>
          <a
            class="rounded-full border border-slate-200 bg-white px-6 py-3 text-sm font-black uppercase tracking-[0.14em] text-slate-800 transition hover:border-blue-200 hover:text-blue-700"
            href={`${invoiceAppUrl}invoices/new`}
            target="_blank"
            rel="noopener noreferrer"
          >
            Create new invoice
          </a>
        </div>
        <p class="mt-4 text-sm text-slate-500">The app opens in a new tab at <a class="font-bold text-blue-700" href={invoiceAppUrl} target="_blank" rel="noopener noreferrer">invoice-maker-chi-lyart.vercel.app</a>.</p>
      </div>
      <div class="rounded-[1.75rem] border border-slate-200 bg-white p-5 shadow-sm">
        <h3 class="text-xl font-black text-slate-950">What is included</h3>
        <ul class="mt-4 grid gap-3 text-sm leading-6 text-slate-700">
          <li class="rounded-2xl bg-slate-50 p-3"><strong>Invoices:</strong> create, view, edit, and export PDF invoices.</li>
          <li class="rounded-2xl bg-slate-50 p-3"><strong>Clients:</strong> store client details locally in the app.</li>
          <li class="rounded-2xl bg-slate-50 p-3"><strong>Settings:</strong> company profile, language, and invoice defaults.</li>
          <li class="rounded-2xl bg-slate-50 p-3"><strong>Stats:</strong> quick overview of paid/unpaid invoice totals.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="mt-10 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Same app experience</h2>
      <p class="mt-3 text-slate-600">The Invoice Maker runs separately so its existing navigation, invoice pages, PDF export, and local state can stay as close as possible to the original app.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Bizzon entry point</h2>
      <p class="mt-3 text-slate-600">This page keeps Invoice Maker discoverable from Bizzon while sending users into the full dedicated invoice workspace.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Private by design</h2>
      <p class="mt-3 text-slate-600">Invoice data is handled in the browser app. Avoid entering sensitive information on shared devices and keep your own backups where needed.</p>
    </div>
  </section>

  <section class="mt-10 rounded-[2rem] border border-slate-200 bg-blue-50 p-6 md:p-8">
    <h2 class="text-2xl font-black text-slate-950">Related business tools</h2>
    <p class="mt-4 text-slate-700">Need tax math first? Try the <a class="font-bold text-blue-700" href="/vat-sales-tax-calculator">VAT / Sales Tax Calculator</a>. Need discounts or markups? Use the <a class="font-bold text-blue-700" href="/percentage-calculator">Percentage Calculator</a>. Need deadline math? Open the <a class="font-bold text-blue-700" href="/date-calculator">Date Calculator</a>.</p>
  </section>

  <ToolSeoSections slug="invoice-maker" />
</ToolLayout>
