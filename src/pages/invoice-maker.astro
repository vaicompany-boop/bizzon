---
import InvoiceMaker from '../components/InvoiceMaker.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
import ToolSeoSections from '../components/ToolSeoSections.astro';
---

<ToolLayout
  title="Invoice Maker — Create and download PDF invoices | Bizzon"
  description="Free browser-based Invoice Maker by Bizzon. Create invoices with business details, client details, line items, tax, totals, notes, and download a PDF."
  canonicalPath="/invoice-maker"
  heading="Invoice Maker"
  intro="Create a simple invoice in your browser, add your details and client details, enter line items, calculate tax and totals, then download a clean PDF."
>
  <InvoiceMaker />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Business and client details</h2>
      <p class="mt-3 text-slate-600">Enter your business name, address, payment details, client information, invoice number, invoice date, and due date.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Line items and tax totals</h2>
      <p class="mt-3 text-slate-600">Add services or products, quantity, unit price, currency, and tax rate. The subtotal, tax, and total update automatically.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">PDF download</h2>
      <p class="mt-3 text-slate-600">Preview the invoice and download it as a PDF from your browser. Your invoice details are not uploaded to Bizzon.</p>
    </div>
  </section>
  <section class="mt-10 rounded-[2rem] border border-slate-200 bg-blue-50 p-6 md:p-8">
    <h2 class="text-2xl font-black text-slate-950">Related business tools</h2>
    <p class="mt-4 text-slate-700">Need tax math first? Try the <a class="font-bold text-blue-700" href="/vat-sales-tax-calculator">VAT / Sales Tax Calculator</a>. Need discounts or markups? Use the <a class="font-bold text-blue-700" href="/percentage-calculator">Percentage Calculator</a>. Need deadline math? Open the <a class="font-bold text-blue-700" href="/date-calculator">Date Calculator</a>.</p>
  </section>
  <ToolSeoSections slug="invoice-maker" />
</ToolLayout>
