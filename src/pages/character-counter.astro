---
import CharacterCounter from '../components/CharacterCounter.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
import ToolSeoSections from '../components/ToolSeoSections.astro';
---

<ToolLayout
  title="Character Counter — Count characters, words, lines, and limits | Bizzon"
  description="Free browser-based Character Counter by Bizzon. Count total characters, characters without spaces, words, lines, paragraphs, and optional character limits without uploading your text."
  canonicalPath="/character-counter"
  heading="Character Counter"
  intro="Count characters, words, lines, paragraphs, and remaining characters against an optional limit. Everything runs in your browser for privacy."
>
  <CharacterCounter />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">What it counts</h2>
      <p class="mt-3 text-slate-600">Total characters, characters without spaces, words, lines, paragraphs, and remaining characters for an optional limit.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Private by default</h2>
      <p class="mt-3 text-slate-600">Your text stays in your browser. It is not uploaded, saved, or processed on a server.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Useful for limits</h2>
      <p class="mt-3 text-slate-600">Check social posts, bios, SEO titles, descriptions, form fields, product copy, and short messages before publishing.</p>
    </div>
  </section>
  <section class="mt-10 rounded-[2rem] border border-slate-200 bg-blue-50 p-6 md:p-8">
    <h2 class="text-2xl font-black text-slate-950">Related text tools</h2>
    <p class="mt-4 text-slate-700">Need broader writing stats? Try the <a class="font-bold text-blue-700" href="/word-counter">Word Counter</a>. Need to reformat text? Use the <a class="font-bold text-blue-700" href="/case-converter">Case Converter</a>.</p>
  </section>
  <ToolSeoSections slug="character-counter" />
</ToolLayout>
