---
import WordCounter from '../components/WordCounter.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
import ToolSeoSections from '../components/ToolSeoSections.astro';
---

<ToolLayout
  title="Word Counter — Count words, characters, paragraphs, and reading time | Bizzon"
  description="Free browser-based Word Counter by Bizzon. Count words, characters, characters without spaces, sentences, paragraphs, and reading time without uploading your text."
  canonicalPath="/word-counter"
  heading="Word Counter"
  intro="Count words, characters, sentences, paragraphs, and estimated reading time instantly. Everything runs in your browser for privacy."
>
  <WordCounter />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">What it counts</h2><p class="mt-3 text-slate-600">Words, all characters, characters without spaces, sentences, paragraphs, and reading time.</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Private by default</h2><p class="mt-3 text-slate-600">The tool runs locally in your browser. Your pasted text is not sent to a server.</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Useful for writing</h2><p class="mt-3 text-slate-600">Check articles, social posts, assignments, emails, SEO snippets, and drafts before publishing.</p></div>
  </section>
  <section class="mt-10 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm md:p-8" aria-labelledby="word-counter-writing-workflows-heading">
    <p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-700">Writing workflows</p>
    <h2 id="word-counter-writing-workflows-heading" class="mt-3 text-3xl font-black tracking-tight text-slate-950">When word count matters</h2>
    <div class="mt-6 grid gap-5 md:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <h3 class="font-bold text-slate-950">Essays and assignments</h3>
        <p class="mt-2 leading-7 text-slate-700">Check whether a school assignment, application answer, or essay is under a target word count while still watching paragraphs and reading time.</p>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <h3 class="font-bold text-slate-950">Blog drafts and newsletters</h3>
        <p class="mt-2 leading-7 text-slate-700">Use the reading-time estimate to keep blog posts, newsletters, tutorials, and scripts easy to scan before publishing.</p>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <h3 class="font-bold text-slate-950">Social copy and product text</h3>
        <p class="mt-2 leading-7 text-slate-700">Compare words, all characters, and characters without spaces when writing captions, product descriptions, bios, or short promotional copy.</p>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <h3 class="font-bold text-slate-950">SEO snippets and page copy</h3>
        <p class="mt-2 leading-7 text-slate-700">Draft landing-page sections, meta descriptions, and article intros here, then open the <a class="font-semibold text-blue-700 underline" href="/meta-title-description-checker">Meta Title & Description Checker</a> for snippet-specific guidance.</p>
      </article>
    </div>
  </section>
  <section class="mt-10 rounded-[2rem] border border-blue-100 bg-blue-50 p-6 md:p-8" aria-labelledby="word-counter-related-guides-heading">
    <p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-700">Plan the next edit</p>
    <h2 id="word-counter-related-guides-heading" class="mt-3 text-3xl font-black tracking-tight text-slate-950">Word count vs character count</h2>
    <p class="mt-4 max-w-3xl leading-7 text-slate-700">Word count helps with writing scope and reading time. Character count helps with strict limits in social profiles, ads, forms, titles, and descriptions. If your text came from a PDF, website, or AI draft, clean it before counting so the numbers are easier to trust.</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a class="rounded-full bg-white px-4 py-2 text-sm font-bold text-blue-700 shadow-sm" href="/word-count-vs-character-count">Read the word count vs character count guide</a>
      <a class="rounded-full bg-white px-4 py-2 text-sm font-bold text-blue-700 shadow-sm" href="/how-to-clean-pasted-text">Clean pasted text first</a>
      <a class="rounded-full bg-white px-4 py-2 text-sm font-bold text-blue-700 shadow-sm" href="/best-free-text-tools">Compare free text tools</a>
    </div>
  </section>
  <ToolSeoSections slug="word-counter" />
</ToolLayout>
