---
import InstagramCaptionFormatter from '../components/InstagramCaptionFormatter.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout
  title="Instagram Caption Formatter — Clean spacing and hashtags | Bizzon"
  description="Free browser-based Instagram caption formatter by Bizzon. Clean extra spaces and blank lines, dedupe hashtags, count caption length, and copy a formatted caption locally."
  canonicalPath="/instagram-caption-formatter"
  heading="Instagram Caption Formatter"
  intro="Turn messy caption drafts into clean, copy-ready Instagram captions. Bizzon cleans spacing, preserves intentional line breaks, deduplicates hashtags, and counts locally in your browser."
>
  <InstagramCaptionFormatter />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Clean pasted drafts</h2>
      <p class="mt-3 text-slate-600">Remove extra spaces and repeated blank lines while keeping useful paragraph breaks for readable captions.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Dedupe hashtags</h2>
      <p class="mt-3 text-slate-600">Repeated hashtags are removed case-insensitively, with the first version kept so your final caption stays tidy.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Private by default</h2>
      <p class="mt-3 text-slate-600">Everything runs in the browser. There is no Instagram scraping, API connection, account login, or server upload.</p>
    </div>
  </section>
  <section class="mt-10 rounded-[2rem] border border-slate-200 bg-blue-50 p-6 md:p-8">
    <h2 class="text-2xl font-black text-slate-950">Related creator tools</h2>
    <p class="mt-4 text-slate-700">Planning a wider post? Try the <a class="font-bold text-blue-700" href="/x-character-counter">X / Twitter Character Counter</a>. Cleaning a video link before sharing? Use the <a class="font-bold text-blue-700" href="/youtube-url-cleaner">YouTube URL Cleaner</a>.</p>
  </section>
</ToolLayout>
