---
import CaseConverter from '../components/CaseConverter.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
import ToolSeoSections from '../components/ToolSeoSections.astro';
---

<ToolLayout
  title="Case Converter — Convert text to uppercase, title case, camelCase, and more | Bizzon"
  description="Free browser-based Case Converter by Bizzon. Convert text to lowercase, uppercase, title case, sentence case, camelCase, PascalCase, kebab-case, and snake_case without uploading your text."
  canonicalPath="/case-converter"
  heading="Case Converter"
  intro="Convert text into the format you need: uppercase, lowercase, title case, sentence case, camelCase, PascalCase, kebab-case, or snake_case. Everything runs in your browser."
>
  <CaseConverter />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Eight useful formats</h2>
      <p class="mt-3 text-slate-600">Switch between common writing, SEO, URL, and code naming formats with one click.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Private by default</h2>
      <p class="mt-3 text-slate-600">Your text is converted locally in the browser. It is not sent to Bizzon or stored on a server.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Useful for publishing</h2>
      <p class="mt-3 text-slate-600">Clean up headlines, page titles, slugs, filenames, labels, variables, and quick drafts.</p>
    </div>
  </section>
  <section class="mt-10 rounded-[2rem] border border-slate-200 bg-blue-50 p-6 md:p-8">
    <h2 class="text-2xl font-black text-slate-950">When to use each case</h2>
    <div class="mt-5 grid gap-4 md:grid-cols-2">
      <p class="text-slate-700"><strong>Title Case</strong> is useful for headings, article titles, and labels.</p>
      <p class="text-slate-700"><strong>Sentence case</strong> is useful for natural paragraphs, UI copy, and descriptions.</p>
      <p class="text-slate-700"><strong>kebab-case</strong> is useful for URLs, slugs, and CSS-style names.</p>
      <p class="text-slate-700"><strong>camelCase, PascalCase, and snake_case</strong> are useful for code, filenames, and structured text.</p>
    </div>
    <p class="mt-6 text-slate-700">Need counts before converting? Try the <a class="font-bold text-blue-700" href="/word-counter">Word Counter</a>.</p>
  </section>
  <section class="mt-10 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm md:p-8">
    <p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-700">Search-focused examples</p>
    <h2 class="mt-3 text-2xl font-black text-slate-950">Case converter examples for common tasks</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <h3 class="font-bold text-slate-950">Title Case for headlines</h3>
        <p class="mt-2 text-slate-700">Turn lowercase notes into cleaner blog titles, email subjects, product names, labels, and section headings before publishing.</p>
      </div>
      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <h3 class="font-bold text-slate-950">camelCase and PascalCase for code</h3>
        <p class="mt-2 text-slate-700">Convert short phrases into variable names, component names, API labels, and structured values without retyping every word.</p>
      </div>
      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <h3 class="font-bold text-slate-950">snake_case and kebab-case for files and URLs</h3>
        <p class="mt-2 text-slate-700">Prepare readable filenames, slugs, CSS class ideas, and spreadsheet-style labels with consistent separators.</p>
      </div>
      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <h3 class="font-bold text-slate-950">Clean text before converting case</h3>
        <p class="mt-2 text-slate-700">If the source came from a PDF, email, or AI draft, clean spacing with <a class="font-bold text-blue-700" href="/text-cleaner">Text Cleaner</a> before applying the final case format.</p>
      </div>
    </div>
  </section>
  <ToolSeoSections slug="case-converter" />
</ToolLayout>
