---
import QrCodeGenerator from '../components/QrCodeGenerator.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
import ToolSeoSections from '../components/ToolSeoSections.astro';
---

<ToolLayout
  title="QR Code Generator — Create downloadable QR codes | Bizzon"
  description="Free browser-based QR Code Generator by Bizzon. Create downloadable PNG QR codes for links, text, email, phone numbers, and simple sharing tasks locally in your browser."
  canonicalPath="/qr-code-generator"
  heading="QR Code Generator"
  intro="Create a QR code for a link or short text, preview it instantly, and download a PNG without uploading your content."
>
  <QrCodeGenerator />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Links and short text</h2>
      <p class="mt-3 text-slate-600">Paste a URL, short message, email address, phone number, or Wi‑Fi text and generate a scannable QR code.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Download PNG</h2>
      <p class="mt-3 text-slate-600">Choose a practical image size and error correction level, then download a clean PNG for print or sharing.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Private by default</h2>
      <p class="mt-3 text-slate-600">Your QR content stays in your browser. Bizzon does not upload, save, or process the text on a server.</p>
    </div>
  </section>
  <section class="mt-10 rounded-[2rem] border border-slate-200 bg-blue-50 p-6 md:p-8">
    <h2 class="text-2xl font-black text-slate-950">Related tools</h2>
    <p class="mt-4 text-slate-700">Need a clean URL first? Try the <a class="font-bold text-blue-700" href="/slug-generator">Slug Generator</a>. Need SEO snippet checks? Open the <a class="font-bold text-blue-700" href="/meta-title-description-checker">Meta Title & Description Checker</a>. Need small business math? Use the <a class="font-bold text-blue-700" href="/vat-sales-tax-calculator">VAT / Sales Tax Calculator</a>.</p>
  </section>
  <ToolSeoSections slug="qr-code-generator" />
</ToolLayout>
