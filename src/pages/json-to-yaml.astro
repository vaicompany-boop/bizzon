---
import JsonToYamlConverter from '../components/JsonToYamlConverter.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout
  title="JSON to YAML Converter — Free browser tool | Bizzon"
  description="Free browser-based JSON to YAML converter by Bizzon. Convert valid JSON objects, arrays, strings, numbers, booleans, and nulls to readable YAML locally with copy-ready output."
  canonicalPath="/json-to-yaml"
  heading="JSON to YAML Converter"
  intro="Convert JSON into readable YAML locally in your browser for config files, docs snippets, and front matter drafts."
>
  <JsonToYamlConverter />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Browser-only conversion</h2><p class="mt-3 text-slate-600">Paste JSON and Bizzon converts it locally in your browser. Your config text is not uploaded to a server.</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Clean YAML output</h2><p class="mt-3 text-slate-600">Objects, arrays, strings, numbers, booleans, and null values are written with sensible indentation and safe quoting.</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Strict JSON input</h2><p class="mt-3 text-slate-600">The converter expects valid JSON. Comments, trailing commas, and JavaScript object syntax are rejected with a clear parser error.</p></div>
  </section>
</ToolLayout>
