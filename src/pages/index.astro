---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools } from '../data/tools';
import { supportPageLinks } from '../data/supportPages';
const liveTools = tools.filter((tool) => tool.status === 'live');
const plannedTools = tools.filter((tool) => tool.status === 'planned').slice(0, 3);
const liveToolCount = liveTools.length;
---

<BaseLayout title="Bizzon — simple browser tools that just work" description="Bizzon is a collection of fast, private, browser-based tools for text, SEO, passwords, random picks, conversions, date math, percentage math, filename cleanup, tip calculation, VAT, QR codes, and everyday tasks." canonicalPath="/">
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 md:grid-cols-[1.05fr_0.95fr] md:py-24">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-700">No login. No upload. No clutter.</p>
      <h1 class="mt-5 text-5xl font-black leading-tight tracking-tight text-slate-950 md:text-7xl">Simple browser tools for everyday tasks.</h1>
      <p class="mt-6 max-w-2xl text-lg text-slate-600 md:text-xl">Bizzon now has <strong>{liveToolCount} live browser tools</strong> for writing, publishing, passwords, random picks, conversions, date math, percentage math, filenames, restaurant bills, VAT or sales tax, and QR codes. Open a focused tool, finish the small task, and move on.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a class="rounded-full bg-blue-600 px-6 py-3 text-center font-bold text-white shadow-sm transition hover:bg-blue-700 hover:text-white" href="/tools">Explore all tools</a>
        <a class="rounded-full border border-slate-300 bg-white px-6 py-3 text-center font-bold text-slate-800 transition hover:border-blue-300 hover:text-blue-700" href="/text-cleaner">Try Text Cleaner</a>
      </div>
      <div class="mt-8 grid gap-3 sm:grid-cols-3">
        <div class="rounded-3xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-3xl font-black text-slate-950">{liveToolCount}</p><p class="mt-1 text-sm font-semibold text-slate-600">Live tools</p></div>
        <div class="rounded-3xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-3xl font-black text-slate-950">0</p><p class="mt-1 text-sm font-semibold text-slate-600">Accounts needed</p></div>
        <div class="rounded-3xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-3xl font-black text-slate-950">Fast</p><p class="mt-1 text-sm font-semibold text-slate-600">Static pages</p></div>
      </div>
    </div>
    <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="text-sm font-semibold text-slate-500">{liveToolCount} tools live now</p>
          <h2 class="mt-1 text-2xl font-black text-slate-950">Pick the job you need.</h2>
        </div>
        <span class="rounded-full bg-blue-50 px-4 py-2 text-sm font-bold text-blue-700">{liveToolCount} live</span>
      </div>
      <div class="mt-5 max-h-[34rem] space-y-4 overflow-y-auto pr-1">{liveTools.map((tool) => <ToolCard tool={tool} />)}</div>
      <p class="mt-6 rounded-2xl bg-blue-50 p-4 text-sm text-blue-900">All tools run locally in your browser. Bizzon does not upload or store your pasted text, lists, passwords, dates, conversions, percentage calculations, filenames, bill amounts, tax estimates, or QR content.</p>
    </div>
  </section>
  <section class="bg-white/70 py-14">
    <div class="mx-auto max-w-6xl px-5">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"><div><p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-700">Helpful guides</p><h2 class="mt-3 text-3xl font-black text-slate-950 md:text-4xl">Helpful guides for small tasks.</h2><p class="mt-3 max-w-2xl text-slate-600">Short support pages help visitors choose the right Bizzon tool for text cleanup, SEO snippets, filenames, calculators, and private browser workflows.</p></div><a class="font-bold text-blue-700" href="/best-free-text-tools">Start with text tools →</a></div>
      <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {supportPageLinks.slice(0, 3).map((page) => (
          <a class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-blue-200 hover:shadow-md" href={page.href}>
            <h3 class="text-lg font-bold text-slate-950">{page.title}</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">{page.description}</p>
            <p class="mt-4 text-sm font-bold text-blue-700">Read guide →</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="bg-white/70 py-14">
    <div class="mx-auto max-w-6xl px-5">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"><div><p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-700">MVP expansion</p><h2 class="mt-3 text-3xl font-black text-slate-950 md:text-4xl">A careful utility roadmap is planned.</h2><p class="mt-3 max-w-2xl text-slate-600">Bizzon now has a coherent toolbox. The next expansion stays practical: invoice help, simple loan estimates, and small business naming utilities.</p></div><a class="font-bold text-blue-700" href="/tools">See the tool roadmap →</a></div>
      <div class="mt-8 grid gap-5 md:grid-cols-3">{plannedTools.map((tool) => <ToolCard tool={tool} />)}</div>
    </div>
  </section>
</BaseLayout>
