---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools } from '../data/tools';
import { supportPageLinks } from '../data/supportPages';
const liveTools = tools.filter((tool) => tool.status === 'live');
const liveToolCount = liveTools.length;
const stations = [
  { code: 'A', title: 'Words in.', note: 'Count, clean, convert, format, and prepare text before it leaves your desk.', hrefs: ['/word-counter', '/text-cleaner', '/case-converter', '/slug-generator', '/filename-cleaner', '/character-counter'], tint: 'bg-[#e7f3f4]' },
  { code: 'B', title: 'Numbers out.', note: 'Check a date, price, percentage, tax amount, bill, or conversion without opening a sheet.', hrefs: ['/percentage-calculator', '/vat-sales-tax-calculator', '/tip-calculator', '/date-calculator', '/unit-converter', '/invoice-maker'], tint: 'bg-[#f4bf4f]' },
  { code: 'C', title: 'Make a thing.', note: 'Make a QR code, tidy data, format an image, or produce a small useful output.', hrefs: ['/qr-code-generator', '/password-generator', '/json-formatter', '/csv-to-json', '/image-to-webp', '/random-picker'], tint: 'bg-[#b9d8d4]' },
];
const byHref = new Map(liveTools.map((tool) => [tool.href, tool]));
const starters = ['/word-counter', '/vat-sales-tax-calculator', '/qr-code-generator'].map((href) => byHref.get(href)).filter(Boolean);
---

<BaseLayout title="Bizzon Free Browser Tools — no login, no upload" description="Bizzon is a no-login collection of fast, private browser tools for text cleanup, SEO snippets, invoices, passwords, random picks, conversions, date math, percentages, filenames, tips, VAT, QR codes, and everyday tasks." canonicalPath="/">
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Bizzon', url: 'https://bizzon.app/', description: 'Free no-login browser tools for everyday text, number, file, and sharing tasks.' })} />
  <section class="mx-auto max-w-6xl px-5 pb-11 pt-8 md:pb-16 md:pt-14">
    <div class="grid gap-7 md:grid-cols-[minmax(0,1fr)_17rem] md:gap-12">
      <div class="border-l-4 border-[#007d7a] pl-5 md:pl-7">
        <p class="orbit-kicker">Browser tools / no account required</p>
        <h1 class="orbit-display mt-5 max-w-4xl text-6xl leading-[.83] text-slate-950 md:text-8xl">A small task deserves a direct route.</h1>
        <p class="mt-7 max-w-xl text-lg leading-8 text-slate-600 md:text-xl">{liveToolCount} browser tools for the text, numbers, files, and sharing jobs that show up in a normal day. Pick a station, finish locally, move on.</p>
        <div class="mt-8 flex flex-wrap gap-3"><a class="bg-[#183b5b] px-5 py-3 font-bold text-white transition hover:bg-[#007d7a]" href="/tools">Choose a tool <span class="ml-2" aria-hidden="true">↗</span></a><a class="orbit-pill px-5 py-3 font-bold text-slate-950 transition hover:bg-[#b9d8d4]" href="/text-cleaner">Clean pasted text</a></div>
      </div>
      <aside class="orbit-cut border border-[#183b5b] bg-[#f8fbfd] p-6">
        <p class="orbit-kicker">Desk note / 01</p>
        <p class="orbit-display mt-7 text-3xl leading-[.9] text-slate-950">No login. No upload. No extra tab.</p>
        <p class="mt-6 border-t border-[#9db8c7] pt-4 text-sm leading-6 text-slate-600">The tool stays close to the job: browser-first controls, plain language, and a result you can use right away.</p>
      </aside>
    </div>
  </section>

  <section class="border-y border-[#9db8c7] bg-[#f8fbfd]">
    <div class="mx-auto grid max-w-6xl gap-6 px-5 py-8 md:grid-cols-[12rem_1fr] md:items-center md:py-10">
      <div><p class="orbit-kicker">Fast launch</p><h2 class="orbit-display mt-3 text-3xl leading-none text-slate-950">Three frequent stops.</h2></div>
      <div class="grid gap-3 sm:grid-cols-3">{starters.map((tool) => tool && <ToolCard tool={tool} />)}</div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-12 md:py-20">
    <div class="grid gap-12 md:gap-16">
      {stations.map((station, index) => (
        <section class:list={["grid gap-7 md:grid-cols-[minmax(0,1fr)_13rem] md:gap-10", index > 0 && 'orbit-rule pt-12 md:pt-16']}>
          <div>
            <div class="flex items-baseline justify-between gap-4"><h2 class="orbit-display text-4xl leading-none text-slate-950">{station.title}</h2><span class="orbit-mono text-sm font-bold text-[#007d7a]">STATION {station.code}</span></div>
            <p class="mt-4 max-w-2xl text-base leading-7 text-slate-600">{station.note}</p>
            <div class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{station.hrefs.map((href) => { const tool = byHref.get(href); return tool ? <ToolCard tool={tool} /> : null; })}</div>
          </div>
          <aside class:list={["orbit-cut self-start border border-[#183b5b] p-5", station.tint]}><p class="orbit-kicker !text-[#183b5b]">Route {station.code}</p><p class="orbit-display mt-5 text-2xl leading-[.92] text-[#183b5b]">Open a tool. Keep your work moving.</p><a class="mt-7 inline-block border-b-2 border-[#183b5b] pb-1 text-sm font-bold text-[#183b5b]" href="/tools">See all routes ↗</a></aside>
        </section>
      ))}
    </div>
  </section>

  <section class="border-t border-[#9db8c7] bg-[#f8fbfd] py-12 md:py-16">
    <div class="mx-auto max-w-6xl px-5">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"><div><p class="orbit-kicker">Field notes</p><h2 class="orbit-display mt-3 text-4xl leading-none text-slate-950">Helpful guides for small tasks.</h2><p class="mt-4 max-w-2xl text-slate-600">Short, practical pages to help you choose the right Bizzon tool and finish the job with less guesswork.</p></div><a class="orbit-pill px-4 py-2 text-sm font-bold text-slate-950 transition hover:bg-[#b9d8d4]" href="/tools">All tools ↗</a></div>
      <div class="mt-8 grid gap-3 md:grid-cols-2 lg:grid-cols-4">{supportPageLinks.map((page) => <a class="orbit-cut border border-[#9db8c7] bg-white p-5 transition hover:-translate-y-1 hover:border-[#007d7a] hover:bg-[#e7f3f4]" href={page.href}><p class="orbit-display text-lg leading-[.95] text-slate-950">{page.title}</p><p class="mt-3 text-sm leading-6 text-slate-600">{page.description}</p><p class="mt-5 text-sm font-bold text-[#007d7a]">Read guide ↗</p></a>)}</div>
    </div>
  </section>

  <section class="border-t border-[#9db8c7] bg-[#007d7a] py-7">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5"><p class="orbit-display text-2xl leading-none text-white">Private by default. Useful on purpose.</p><a class="orbit-pill bg-[#f4bf4f] px-4 py-2 text-sm font-bold text-slate-950 transition hover:bg-[#f8fbfd]" href="/tools">Browse every tool ↗</a></div>
  </section>
</BaseLayout>
