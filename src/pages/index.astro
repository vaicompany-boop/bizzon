---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools } from '../data/tools';
import { supportPageLinks } from '../data/supportPages';

const liveTools = tools.filter((tool) => tool.status === 'live');
const plannedTools = tools.filter((tool) => tool.status === 'planned').slice(0, 3);
const liveToolCount = liveTools.length;

const toolByHref = new Map(liveTools.map((tool) => [tool.href, tool]));
const guideByHref = new Map(supportPageLinks.map((page) => [page.href, page]));

const categoryGroups = [
  {
    title: 'Text',
    accent: 'blue',
    icon: 'T',
    description: 'Edit, clean, and analyze text quickly.',
    hrefs: ['/word-counter', '/text-cleaner'],
    allHref: '/tools#categories-heading',
    allLabel: 'See all text tools',
  },
  {
    title: 'Publish',
    accent: 'red',
    icon: '!',
    description: 'SEO, metadata, and content tools for publishers.',
    hrefs: ['/meta-title-description-checker', '/qr-code-generator'],
    allHref: '/tools#categories-heading',
    allLabel: 'See all publish tools',
  },
  {
    title: 'Calculate',
    accent: 'yellow',
    icon: '%',
    description: 'Business, finance, and everyday calculations.',
    hrefs: ['/percentage-calculator', '/vat-sales-tax-calculator'],
    allHref: '/tools#categories-heading',
    allLabel: 'See all calculate tools',
  },
  {
    title: 'Convert',
    accent: 'blue',
    icon: '{}',
    description: 'Convert files, data, and formats in seconds.',
    hrefs: ['/csv-to-json', '/json-to-csv'],
    allHref: '/tools#categories-heading',
    allLabel: 'See all convert tools',
  },
  {
    title: 'Create',
    accent: 'red',
    icon: '+',
    description: 'Generate secure, random, and shareable items.',
    hrefs: ['/password-generator', '/slug-generator'],
    allHref: '/tools#categories-heading',
    allLabel: 'See all create tools',
  },
];

const toolGroups = [
  {
    eyebrow: 'Popular text tools',
    title: 'Count and clean drafts',
    body: 'Use these when a draft, pasted note, headline, filename, or CMS field needs cleanup before publishing.',
    hrefs: ['/word-counter', '/character-counter', '/text-cleaner', '/case-converter', '/slug-generator', '/filename-cleaner'],
    guideHrefs: ['/best-free-text-tools', '/free-word-counter', '/character-limit-guide', '/how-to-clean-pasted-text', '/word-count-vs-character-count', '/how-to-create-clean-filenames', '/how-to-make-a-url-slug'],
  },
  {
    eyebrow: 'SEO and publishing tools',
    title: 'Prepare search snippets',
    body: 'Check title and description length, create clean slugs, and prepare QR destinations before a page or campaign goes live.',
    hrefs: ['/meta-title-description-checker', '/slug-generator', '/qr-code-generator', '/word-counter'],
    guideHrefs: ['/how-to-write-meta-descriptions', '/meta-description-length-guide', '/how-to-create-qr-codes', '/free-qr-code-generator', '/how-to-make-a-qr-code-for-a-link'],
  },
  {
    eyebrow: 'Business calculators',
    title: 'Check prices and percentages',
    body: 'Run quick estimates for discounts, increases, VAT or sales tax, loan payments, tips, invoice drafts, dates, and units without opening a spreadsheet.',
    hrefs: ['/percentage-calculator', '/vat-sales-tax-calculator', '/loan-calculator', '/tip-calculator', '/invoice-maker', '/date-calculator', '/unit-converter', '/business-name-generator'],
    guideHrefs: ['/quick-business-calculators', '/vat-vs-sales-tax-calculator-guide', '/vat-calculator-germany', '/vat-calculator-eu', '/percentage-increase-calculator', '/discount-calculator', '/tip-calculator-guide'],
  },
  {
    eyebrow: 'Private browser utilities',
    title: 'Create and share QR codes',
    body: 'Generate passwords, pick random names or winners, create QR codes, and handle everyday one-off tasks with local browser utilities.',
    hrefs: ['/password-generator', '/random-picker', '/qr-code-generator', '/date-calculator', '/unit-converter'],
    guideHrefs: ['/private-browser-tools', '/how-to-create-qr-codes', '/free-qr-code-generator', '/how-to-make-a-qr-code-for-a-link'],
  },
];

const searchTools = liveTools.map((tool) => ({
  title: tool.title,
  href: tool.href,
  description: tool.description,
}));

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Bizzon',
  url: 'https://bizzon.app/',
  description: 'Free no-login browser tools for text cleanup, SEO snippets, passwords, QR codes, calculators, converters, and everyday tasks.',
  hasPart: liveTools.slice(0, 12).map((tool) => ({
    '@type': 'WebApplication',
    name: tool.title,
    url: `https://bizzon.app${tool.href}`,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  })),
};
---

<BaseLayout title="Bizzon Free Browser Tools — no login, no upload" description="Bizzon is a no-login collection of fast, private browser tools for text cleanup, SEO snippets, invoices, passwords, random picks, conversions, date math, percentages, filenames, tips, VAT, QR codes, and everyday tasks." canonicalPath="/">
  <script type="application/ld+json" set:html={JSON.stringify(homeJsonLd)} />
  <script id="home-tool-search-data" type="application/json" set:html={JSON.stringify(searchTools)} />

  <section class="home-hero">
    <div class="home-hero__copy">
      <div class="tally-stack" aria-hidden="true"><span></span><span></span><span></span></div>
      <p class="home-kicker">No login. No upload. No clutter.</p>
      <h1>Simple browser tools for everyday tasks.</h1>
      <p class="home-value">No login. No upload. Runs in your browser.</p>
      <div class="home-actions">
        <a class="home-primary" href="/tools">Browse tools <span aria-hidden="true">→</span></a>
        <a class="home-secondary" href="/word-counter">Try Word Counter</a>
      </div>

      <form class="tool-finder" role="search" action="/tools">
        <label for="home-tool-search">Find a tool</label>
        <div class="tool-finder__box">
          <span class="tool-finder__icon" aria-hidden="true"></span>
          <input id="home-tool-search" name="q" type="search" placeholder="Search tools" autocomplete="off" aria-controls="home-tool-results" aria-expanded="false" />
        </div>
        <div id="home-tool-results" class="tool-finder__results" role="listbox" aria-label="Matching Bizzon tools" hidden></div>
        <p class="home-private">Private by design. Your data stays in your browser.</p>
      </form>
    </div>

    <div class="utility-collage" aria-hidden="true">
      <div class="paper-shape paper-shape--red"></div>
      <div class="paper-shape paper-shape--yellow"></div>
      <div class="paper-shape paper-shape--blue"></div>
      <div class="receipt">
        <p>messy text...</p>
        <p> extra spaces</p>
        <p>line breaks</p>
        <p>tabs\t...</p>
        <strong>cleaned!</strong>
      </div>
      <div class="receipt-roll"></div>
      <div class="paper-strip"><span></span><span></span><span></span></div>
      <div class="percent-dial"><span>%</span></div>
      <div class="decor-qr">
        {Array.from({ length: 49 }).map((_, index) => <span class:list={[index % 3 === 0 || [1, 5, 8, 12, 18, 23, 29, 33, 39, 44, 47].includes(index) ? 'is-ink' : '']} />)}
      </div>
      <div class="calculator">
        {[7, 8, 9, 4, 5, 6, 1, 2, 3, 0, '.', '='].map((key) => <span class={key === '=' ? 'is-red' : ''}>{key}</span>)}
      </div>
      <div class="blue-crosses"><span>+</span><span>+</span><span>+</span><span>+</span></div>
    </div>
  </section>

  <section id="categories" class="home-categories" aria-labelledby="category-title">
    <div class="home-categories__intro">
      <h2 id="category-title">Start with the kind of task.</h2>
      <p><strong>{liveToolCount} browser tools live now</strong> — across text work, SEO &amp; publishing, private utilities, business calculators, format converters, and social helpers.</p>
    </div>
    <div class="category-board">
      {categoryGroups.map((group) => (
        <article class={`category-panel category-panel--${group.accent}`}>
          <div class="category-panel__head">
            <span aria-hidden="true">{group.icon}</span>
            <h3>{group.title}</h3>
          </div>
          <p>{group.description}</p>
          <div class="category-panel__tools">
            {group.hrefs.map((href) => {
              const tool = toolByHref.get(href);
              return tool ? (
                <a href={tool.href}>
                  <strong>{tool.title}</strong>
                  <small>{tool.description}</small>
                  <span aria-hidden="true">-&gt;</span>
                </a>
              ) : null;
            })}
          </div>
          <a class="category-panel__all" href={group.allHref}>{group.allLabel} <span aria-hidden="true">-&gt;</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="home-band">
    <div class="home-band__inner home-band__inner--callout">
      <div>
        <p class="home-section-kicker">Account-free tools</p>
        <h2>Looking for a Bizzon login?</h2>
        <p>All tools run locally in your browser. Bizzon does not need an account or dashboard login. Open any tool, paste only the text or numbers needed for the task, copy the result, and leave when you are done. If a search brought you here for a Bizzon login, start with the tools hub instead.</p>
      </div>
      <div class="home-band__actions">
        <a class="home-primary" href="/tools">Explore all tools</a>
        <a class="home-secondary" href="/private-browser-tools">Read about private browser tools</a>
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="home-section__intro">
      <p class="home-section-kicker">Start with a focused workflow</p>
      <h2>Choose the tool cluster that matches the task.</h2>
      <p>Use grouped shortcuts to jump straight to text tools, SEO and publishing helpers, business calculators, or private browser utilities.</p>
    </div>
    <div class="workflow-grid">
      {toolGroups.map((group) => (
        <article class="workflow-card">
          <p class="home-section-kicker">{group.eyebrow}</p>
          <h3>{group.title}</h3>
          <p>{group.body}</p>
          <div class="workflow-card__links">
            {group.hrefs.map((href) => {
              const tool = toolByHref.get(href);
              return tool ? <a href={tool.href}>{tool.title}</a> : null;
            })}
          </div>
          <div class="workflow-card__guides">
            <p>Related guides</p>
            <div>
              {group.guideHrefs.map((href) => {
                const guide = guideByHref.get(href);
                return guide ? <a href={guide.href}>{guide.title} -&gt;</a> : null;
              })}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="home-section home-section--quiet">
    <div class="home-section__split">
      <div>
        <p class="home-section-kicker">Featured guide clusters</p>
        <h2>Helpful guides for small tasks.</h2>
        <p>Short support pages help visitors choose the right Bizzon tool for text cleanup, SEO snippets, filenames, calculators, private browser workflows, and QR sharing.</p>
      </div>
      <a href="/tools">Browse every Bizzon tool -&gt;</a>
    </div>
    <div class="guide-grid">
      {supportPageLinks.map((page) => (
        <a class="guide-card" href={page.href}>
          <h3>{page.title}</h3>
          <p>{page.description}</p>
          <strong>Read guide -&gt;</strong>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section">
    <div class="home-section__split">
      <div>
        <p class="home-section-kicker">Planned carefully</p>
        <h2>More utilities are queued only when they add clear value.</h2>
        <p>Bizzon already covers common text, publishing, privacy, conversion, QR, tax, tip, and invoice tasks. Planned tools stay practical and focused instead of adding clutter.</p>
      </div>
      <a href="/tools">See the tool roadmap -&gt;</a>
    </div>
    <div class="planned-grid">{plannedTools.map((tool) => <ToolCard tool={tool} />)}</div>
  </section>

  <script>
    const dataScript = document.getElementById('home-tool-search-data');
    const input = document.getElementById('home-tool-search');
    const results = document.getElementById('home-tool-results');
    const tools = dataScript?.textContent ? JSON.parse(dataScript.textContent) : [];

    function renderToolResults() {
      if (!(input instanceof HTMLInputElement) || !(results instanceof HTMLElement)) return;

      const query = input.value.trim().toLowerCase();
      results.innerHTML = '';

      if (!query) {
        input.setAttribute('aria-expanded', 'false');
        results.hidden = true;
        return;
      }

      const matches = tools
        .filter((tool) => `${tool.title} ${tool.description}`.toLowerCase().includes(query))
        .slice(0, 6);

      input.setAttribute('aria-expanded', matches.length > 0 ? 'true' : 'false');
      results.hidden = false;

      if (matches.length === 0) {
        const empty = document.createElement('p');
        empty.className = 'tool-finder__empty';
        empty.textContent = 'No matching live tools yet. Browse all tools instead.';
        results.append(empty);
        return;
      }

      matches.forEach((tool) => {
        const link = document.createElement('a');
        link.href = tool.href;
        link.setAttribute('role', 'option');

        const title = document.createElement('strong');
        title.textContent = tool.title;
        const desc = document.createElement('span');
        desc.textContent = tool.description;
        const arrow = document.createElement('em');
        arrow.setAttribute('aria-hidden', 'true');
        arrow.textContent = '->';

        link.append(title, desc, arrow);
        results.append(link);
      });
    }

    input?.addEventListener('input', renderToolResults);
    input?.addEventListener('keydown', (event) => {
      if (!(results instanceof HTMLElement)) return;
      const links = Array.from(results.querySelectorAll('a'));
      if (event.key === 'ArrowDown' && links[0]) {
        event.preventDefault();
        links[0].focus();
      }
      if (event.key === 'Escape') {
        input.value = '';
        renderToolResults();
      }
    });
    results?.addEventListener('keydown', (event) => {
      const links = Array.from(results.querySelectorAll('a'));
      const currentIndex = links.indexOf(document.activeElement);
      if (event.key === 'ArrowDown' && currentIndex < links.length - 1) {
        event.preventDefault();
        links[currentIndex + 1].focus();
      }
      if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (currentIndex <= 0) input?.focus();
        else links[currentIndex - 1].focus();
      }
      if (event.key === 'Escape' && input instanceof HTMLInputElement) {
        input.value = '';
        renderToolResults();
        input.focus();
      }
    });
  </script>
</BaseLayout>
