---
import YoutubeThumbnailDownloader from '../components/YoutubeThumbnailDownloader.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout
  title="YouTube Thumbnail Downloader — Public thumbnail URLs | Bizzon"
  description="Free browser-based YouTube thumbnail downloader by Bizzon. Paste a YouTube URL or video ID to extract public thumbnail image URLs for max, standard, high, medium, and default sizes."
  canonicalPath="/youtube-thumbnail-downloader"
  heading="YouTube Thumbnail Downloader"
  intro="Extract public YouTube thumbnail image URLs from watch, youtu.be, Shorts, embed, live URLs, or a raw video ID. No video or audio downloading."
>
  <YoutubeThumbnailDownloader />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Public image URLs only</h2><p class="mt-3 text-slate-600">The tool builds YouTube's public thumbnail image links from the video ID. It does not download videos, audio, captions, or private content.</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Works with common links</h2><p class="mt-3 text-slate-600">Paste standard watch URLs, youtu.be short links, Shorts, embed URLs, live URLs, or just the 11-character video ID.</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Check available sizes</h2><p class="mt-3 text-slate-600">YouTube may not provide every thumbnail resolution for every video. Open the image link to confirm the exact size served.</p></div>
  </section>
</ToolLayout>
