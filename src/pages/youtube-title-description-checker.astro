---
import YoutubeTitleDescriptionChecker from '../components/YoutubeTitleDescriptionChecker.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout
  title="YouTube Title & Description Checker — Length preview | Bizzon"
  description="Free browser-based YouTube title and description checker by Bizzon. Check title length, description length, hashtags, links, snippet preview, and a copy-ready checklist locally."
  canonicalPath="/youtube-title-description-checker"
  heading="YouTube Title & Description Checker"
  intro="Check YouTube title and description drafts before publishing. Bizzon counts the 100-character title limit, 5,000-character description limit, hashtags, links, and preview text locally in your browser."
>
  <YoutubeTitleDescriptionChecker />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Check text limits</h2>
      <p class="mt-3 text-slate-600">Measure the official YouTube title and description character limits while also flagging titles that may feel too short or too long in real feeds.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Preview the opening line</h2>
      <p class="mt-3 text-slate-600">See a simple search/share-style preview so the first useful description line does not get buried under links, chapters, or hashtags.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">No scraping or API calls</h2>
      <p class="mt-3 text-slate-600">This is a text-only checker. It does not fetch YouTube pages, download media, use YouTube APIs, or upload your draft text.</p>
    </div>
  </section>
  <section class="mt-10 rounded-[2rem] border border-slate-200 bg-blue-50 p-6 md:p-8">
    <h2 class="text-2xl font-black text-slate-950">Related creator tools</h2>
    <p class="mt-4 text-slate-700">Cleaning a full creator workflow? Try the <a class="font-bold text-blue-700" href="/youtube-url-cleaner">YouTube URL Cleaner</a>, get public thumbnails with the <a class="font-bold text-blue-700" href="/youtube-thumbnail-downloader">YouTube Thumbnail Downloader</a>, or format short social captions with the <a class="font-bold text-blue-700" href="/tiktok-caption-hashtag-cleaner">TikTok Caption Cleaner</a>.</p>
  </section>
</ToolLayout>
