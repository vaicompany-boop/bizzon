---
import XCharacterCounter from '../components/XCharacterCounter.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout
  title="X / Twitter Character Counter — Count post length and thread chunks | Bizzon"
  description="Free browser-based X / Twitter character counter by Bizzon. Count post length locally, estimate remaining characters, link length, emojis, line breaks, and rough thread chunks."
  canonicalPath="/x-character-counter"
  heading="X / Twitter Character Counter"
  intro="Draft X posts and threads with a clear character count. Bizzon counts locally in your browser, estimates t.co-style link length, and shows when you are under or over the selected limit."
>
  <XCharacterCounter />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Built for 280-character posts</h2>
      <p class="mt-3 text-slate-600">Use the default 280-character limit for normal posts, or switch to longer limits when planning premium-style long posts.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Link-aware estimate</h2>
      <p class="mt-3 text-slate-600">Detected links count as 23 characters to give a more realistic draft estimate for X/Twitter sharing.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Private by default</h2>
      <p class="mt-3 text-slate-600">Your draft stays in your browser. No account, upload, backend, or social API call is required.</p>
    </div>
  </section>
  <section class="mt-10 rounded-[2rem] border border-slate-200 bg-blue-50 p-6 md:p-8">
    <h2 class="text-2xl font-black text-slate-950">Related creator tools</h2>
    <p class="mt-4 text-slate-700">Cleaning links before posting? Try the <a class="font-bold text-blue-700" href="/youtube-url-cleaner">YouTube URL Cleaner</a>. Need broader text stats? Use the <a class="font-bold text-blue-700" href="/character-counter">Character Counter</a>.</p>
  </section>
</ToolLayout>
