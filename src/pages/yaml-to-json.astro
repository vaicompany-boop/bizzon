---
import YamlToJsonConverter from '../components/YamlToJsonConverter.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout
  title="YAML to JSON Converter — Free browser tool | Bizzon"
  description="Free browser-based YAML to JSON converter by Bizzon. Convert common YAML maps, lists, scalars, and simple config snippets to pretty JSON locally with copy-ready output."
  canonicalPath="/yaml-to-json"
  heading="YAML to JSON Converter"
  intro="Convert common YAML config, front matter, and docs snippets into pretty JSON locally in your browser."
>
  <YamlToJsonConverter />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Browser-only conversion</h2><p class="mt-3 text-slate-600">Paste YAML and Bizzon parses it locally in your browser. Your config text is not uploaded to a server.</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Useful subset</h2><p class="mt-3 text-slate-600">The converter supports common maps, nested objects, lists, quoted strings, booleans, nulls, numbers, and inline arrays or objects.</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Clear limits</h2><p class="mt-3 text-slate-600">Advanced YAML features such as anchors, aliases, tags, multi-document files, and block strings are rejected with an explanation.</p></div>
  </section>
</ToolLayout>
