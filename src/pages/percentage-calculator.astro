---
import PercentageCalculator from '../components/PercentageCalculator.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
import ToolSeoSections from '../components/ToolSeoSections.astro';
---

<ToolLayout
  title="Percentage Calculator — Discounts, increases, and percentage change | Bizzon"
  description="Free browser-based Percentage Calculator by Bizzon. Calculate percentages, discounts, increases, decreases, and percentage change locally in your browser."
  canonicalPath="/percentage-calculator"
  heading="Percentage Calculator"
  intro="Calculate percentages, discounts, increases, decreases, and percentage change without opening a spreadsheet."
>
  <PercentageCalculator />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Everyday percentage math</h2>
      <p class="mt-3 text-slate-600">Work out percentages for prices, discounts, tax estimates, grades, invoices, and quick planning notes.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Increase, decrease, and change</h2>
      <p class="mt-3 text-slate-600">Switch between percentage of a value, percent comparisons, percentage change, and simple discount calculations.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Private by default</h2>
      <p class="mt-3 text-slate-600">Your numbers stay in your browser. Bizzon does not upload, save, or process your calculations on a server.</p>
    </div>
  </section>
  <section class="mt-10 rounded-[2rem] border border-slate-200 bg-blue-50 p-6 md:p-8">
    <h2 class="text-2xl font-black text-slate-950">Related tools</h2>
    <p class="mt-4 text-slate-700">Need date math? Try the <a class="font-bold text-blue-700" href="/date-calculator">Date Calculator</a>. Need quick measurements? Use the <a class="font-bold text-blue-700" href="/unit-converter">Unit Converter Mini</a>. Need to count text? Open the <a class="font-bold text-blue-700" href="/character-counter">Character Counter</a>.</p>
  </section>
  <ToolSeoSections slug="percentage-calculator" />
</ToolLayout>
