---
import SocialLinkCleaner from '../components/SocialLinkCleaner.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout
  title="Social Link Cleaner — Remove tracking from social URLs | Bizzon"
  description="Free browser-based social link cleaner by Bizzon. Remove tracking parameters from YouTube, X/Twitter, TikTok, Instagram, Facebook, and LinkedIn links locally."
  canonicalPath="/social-link-cleaner"
  heading="Social Link Cleaner"
  intro="Clean public social share URLs before you paste them into posts, docs, newsletters, or chats. Bizzon removes tracking clutter while keeping useful IDs and paths in your browser."
>
  <SocialLinkCleaner />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Remove share tracking clutter</h2>
      <p class="mt-3 text-slate-600">Strip common noise such as utm parameters, fbclid, gclid, igsh, si, feature, share flags, and other copied-link clutter.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Keep useful social URLs</h2>
      <p class="mt-3 text-slate-600">Supports common public YouTube, X/Twitter, TikTok, Instagram, Facebook, and LinkedIn links. YouTube video, playlist, index, and timestamp parameters are preserved.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Browser-only and safe</h2>
      <p class="mt-3 text-slate-600">The tool does not scrape platforms, download media, log in, call APIs, or upload links to a server. It only rewrites pasted URLs locally.</p>
    </div>
  </section>
  <section class="mt-10 rounded-[2rem] border border-slate-200 bg-blue-50 p-6 md:p-8">
    <h2 class="text-2xl font-black text-slate-950">Related creator tools</h2>
    <p class="mt-4 text-slate-700">Cleaning creator text too? Try the <a class="font-bold text-blue-700" href="/hashtag-deduplicator">Hashtag Deduplicator</a>, <a class="font-bold text-blue-700" href="/social-bio-formatter">Social Bio Formatter</a>, or <a class="font-bold text-blue-700" href="/youtube-url-cleaner">YouTube URL Cleaner</a>.</p>
  </section>
</ToolLayout>
