---
import PasswordGenerator from '../components/PasswordGenerator.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout
  title="Password Generator — Create strong random passwords | Bizzon"
  description="Free browser-based Password Generator by Bizzon. Create strong random passwords locally in your browser with length and character options."
  canonicalPath="/password-generator"
  heading="Password Generator"
  intro="Generate strong random passwords locally in your browser. Choose length, character types, and ambiguity options without uploading anything."
>
  <PasswordGenerator />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Strong random passwords</h2>
      <p class="mt-3 text-slate-600">Use browser crypto randomness, choose length from 8 to 64 characters, and include uppercase, lowercase, numbers, and symbols.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Private by default</h2>
      <p class="mt-3 text-slate-600">Your generated password stays in your browser. Bizzon does not upload, save, or process passwords on a server.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Useful for accounts</h2>
      <p class="mt-3 text-slate-600">Create unique passwords for apps, shops, admin accounts, Wi-Fi notes, test accounts, and password-manager entries.</p>
    </div>
  </section>
  <section class="mt-10 rounded-[2rem] border border-slate-200 bg-blue-50 p-6 md:p-8">
    <h2 class="text-2xl font-black text-slate-950">Related tools</h2>
    <p class="mt-4 text-slate-700">Need to count a limit? Try the <a class="font-bold text-blue-700" href="/character-counter">Character Counter</a>. Need a random choice next? The <a class="font-bold text-blue-700" href="/random-picker">Random Picker</a> is planned. Need text formatting? Use the <a class="font-bold text-blue-700" href="/case-converter">Case Converter</a>.</p>
  </section>
</ToolLayout>
