---
import Base64EncoderDecoder from '../components/Base64EncoderDecoder.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout
  title="Base64 Encoder / Decoder — Free browser tool | Bizzon"
  description="Free browser-based Base64 encoder and decoder by Bizzon. Encode text or a local text file to Base64, decode Base64 back to UTF-8 text, then copy or download the result locally in your browser."
  canonicalPath="/base64-encoder-decoder"
  heading="Base64 Encoder / Decoder"
  intro="Encode text or small local text files to Base64, decode Base64 back to readable UTF-8 text, and download the result with a private browser-only converter."
>
  <Base64EncoderDecoder />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Encode text or files</h2><p class="mt-3 text-slate-600">Turn pasted text, config snippets, JSON fixtures, Markdown notes, or small local text files into Base64 for quick sharing or debugging.</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Decode safely</h2><p class="mt-3 text-slate-600">Paste Base64 and get a clear UTF-8 text result or a useful error if the input is malformed or binary-only.</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Copy or download</h2><p class="mt-3 text-slate-600">Bizzon does not upload or store the text you paste or open. Copy the result or download it as a simple text file.</p></div>
  </section>
</ToolLayout>
