---
import CanonicalUrlChecker from '../components/CanonicalUrlChecker.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout
  title="Canonical URL Checker — Clean SEO canonical links | Bizzon"
  description="Free browser-based Canonical URL Checker by Bizzon. Validate and clean canonical URL candidates by spotting fragments, tracking parameters, protocol issues, and path formatting."
  canonicalPath="/canonical-url-checker"
  heading="Canonical URL Checker"
  intro="Paste a page URL to spot common canonical problems and copy a cleaner canonical candidate. The check runs locally in your browser."
>
  <CanonicalUrlChecker />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Clean URL candidates</h2><p class="mt-3 text-slate-600">Remove fragments and common campaign tracking parameters before placing a canonical URL in page metadata.</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Quick structure checks</h2><p class="mt-3 text-slate-600">Check for HTTPS, lowercase hostnames, readable paths, and URL formatting issues that are easy to miss while publishing.</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Private by default</h2><p class="mt-3 text-slate-600">The checker does not crawl the page or upload the URL. It only inspects the text you paste in the browser.</p></div>
  </section>
</ToolLayout>
