---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — Bizzon"
  description="Contact Bizzon about browser-based utility tools, feedback, and simple product questions."
  canonicalPath="/contact"
>
  <section class="mx-auto max-w-3xl px-5 py-14 md:py-20">
    <p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-700">Contact</p>
    <h1 class="mt-4 text-4xl font-black tracking-tight text-slate-950 md:text-6xl">Tell us what should work better.</h1>
    <p class="mt-5 text-lg text-slate-600 md:text-xl">
      Found a bug, missing a useful tool, or want to suggest a small improvement? Send a short note and include the tool name if it is about a specific page.
    </p>

    <div class="mt-8 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm md:p-8">
      <h2 class="text-2xl font-black tracking-tight text-slate-950">Email</h2>
      <p class="mt-3 text-slate-600">For now, contact is intentionally simple.</p>
      <a
        class="mt-5 inline-flex rounded-full bg-blue-600 px-6 py-3 font-bold text-white shadow-sm transition hover:bg-blue-700 hover:text-white focus:outline-none focus:ring-4 focus:ring-blue-100"
        href="mailto:hello@bizzon.app"
      >
        hello@bizzon.app
      </a>
    </div>
  </section>
</BaseLayout>