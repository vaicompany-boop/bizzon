---
import PngJpgConverter from '../components/PngJpgConverter.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout
  title="PNG/JPG Converter — Free browser tool | Bizzon"
  description="Free browser-based PNG and JPG converter by Bizzon. Convert PNG, JPG, WebP, GIF frame, BMP, or SVG images to PNG or JPG locally with preview, quality control, background color, and download."
  canonicalPath="/png-jpg-converter"
  heading="PNG/JPG Converter"
  intro="Convert images to PNG or JPG locally in your browser with preview, JPG quality, transparency background color, and download."
>
  <PngJpgConverter />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Convert locally</h2><p class="mt-3 text-slate-600">Pick an image and Bizzon uses your browser canvas to create the converted file without uploading the original.</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">PNG or JPG output</h2><p class="mt-3 text-slate-600">Choose PNG when you need transparency, or JPG when you want a photo-friendly file with quality control.</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Transparency control</h2><p class="mt-3 text-slate-600">When exporting to JPG, transparent pixels are flattened onto the background color you choose.</p></div>
  </section>
</ToolLayout>
