---
import CsvToJsonConverter from '../components/CsvToJsonConverter.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout
  title="CSV to JSON Converter — Free browser tool | Bizzon"
  description="Free browser-based CSV to JSON converter by Bizzon. Paste CSV, TSV, semicolon, or pipe-separated data and convert it to pretty JSON locally in your browser."
  canonicalPath="/csv-to-json"
  heading="CSV to JSON Converter"
  intro="Convert pasted CSV data into readable JSON with delimiter detection, optional header-row keys, and local browser-only processing."
>
  <CsvToJsonConverter />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Header row support</h2><p class="mt-3 text-slate-600">Keep the first row as object keys, or turn header mode off to export simple arrays of values.</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Delimiter detection</h2><p class="mt-3 text-slate-600">Auto-detect comma, tab, semicolon, or pipe-separated data, with a manual delimiter selector when needed.</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Private conversion</h2><p class="mt-3 text-slate-600">Your CSV stays in the browser. Bizzon does not upload, store, or inspect the data you paste.</p></div>
  </section>
</ToolLayout>
