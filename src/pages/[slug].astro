---
import BaseLayout from '../layouts/BaseLayout.astro';
import { supportPages, type SupportPage } from '../data/supportPages';

export function getStaticPaths() {
  return supportPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

type Props = { page: SupportPage };
const { page } = Astro.props;
const canonicalPath = `/${page.slug}`;

const howToJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: page.title,
  description: page.description,
  step: page.steps.map((step, index) => ({
    '@type': 'HowToStep',
    position: index + 1,
    text: step,
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Bizzon', item: 'https://bizzon.app/' },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://bizzon.app/tools' },
    { '@type': 'ListItem', position: 3, name: page.title, item: `https://bizzon.app/${page.slug}` },
  ],
};
---

<BaseLayout title={`${page.title} | Bizzon`} description={page.description} canonicalPath={canonicalPath}>
  <article class="mx-auto max-w-6xl px-5 py-14 md:py-20">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-700">{page.eyebrow}</p>
      <h1 class="mt-4 text-4xl font-black tracking-tight text-slate-950 md:text-6xl">{page.title}</h1>
      <p class="mt-5 text-lg leading-8 text-slate-600 md:text-xl">{page.intro}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a class="rounded-full bg-blue-600 px-6 py-3 text-center font-bold text-white shadow-sm transition hover:bg-blue-700 hover:text-white" href="/tools">Browse all tools</a>
        <a class="rounded-full border border-slate-300 bg-white px-6 py-3 text-center font-bold text-slate-800 transition hover:border-blue-300 hover:text-blue-700" href={page.relatedTools[0].href}>Open {page.relatedTools[0].label}</a>
      </div>
    </div>

    <section class="mt-12 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm md:p-8" aria-labelledby="quick-workflow-heading">
      <p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-700">Quick workflow</p>
      <h2 id="quick-workflow-heading" class="mt-3 text-3xl font-black tracking-tight text-slate-950">A simple way to do it</h2>
      <ol class="mt-6 grid gap-4 md:grid-cols-3">
        {page.steps.map((step, index) => (
          <li class="rounded-3xl border border-slate-200 bg-slate-50 p-5 text-slate-700">
            <p class="text-3xl font-black text-blue-700">{index + 1}</p>
            <p class="mt-3 leading-7">{step}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-12 grid gap-6 md:grid-cols-2" aria-label={`${page.title} guide sections`}>
      {page.sections.map((section) => (
        <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm md:p-8">
          <h2 class="text-2xl font-black tracking-tight text-slate-950">{section.heading}</h2>
          <p class="mt-4 leading-8 text-slate-700">{section.body}</p>
        </div>
      ))}
    </section>

    <section class="mt-12 rounded-[2rem] border border-blue-100 bg-blue-50 p-6 md:p-8" aria-labelledby="related-bizzon-tools-heading">
      <p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-700">Related Bizzon tools</p>
      <h2 id="related-bizzon-tools-heading" class="mt-3 text-3xl font-black tracking-tight text-slate-950">Open the tool that matches the job</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {page.relatedTools.map((tool) => (
          <a class="rounded-3xl border border-blue-100 bg-white p-5 transition hover:-translate-y-1 hover:border-blue-200 hover:shadow-sm" href={tool.href}>
            <h3 class="font-bold text-slate-950">{tool.label}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">Use it to {tool.reason}.</p>
            <p class="mt-4 text-sm font-bold text-blue-700">Open →</p>
          </a>
        ))}
      </div>
    </section>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(howToJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</BaseLayout>
