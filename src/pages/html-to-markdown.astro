---
import HtmlToMarkdownConverter from '../components/HtmlToMarkdownConverter.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout
  title="HTML to Markdown Converter — Free browser tool | Bizzon"
  description="Free browser-based HTML to Markdown converter by Bizzon. Paste HTML or open a local .html file, convert common document tags to Markdown, then copy or download the result locally."
  canonicalPath="/html-to-markdown"
  heading="HTML to Markdown Converter"
  intro="Convert common article and document HTML or local text files into clean downloadable Markdown with a private browser-only utility."
>
  <HtmlToMarkdownConverter />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Clean document Markdown</h2><p class="mt-3 text-slate-600">Turn headings, paragraphs, links, lists, quotes, code blocks, images, and simple tables into copy-ready Markdown.</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Skips active content</h2><p class="mt-3 text-slate-600">Scripts, styles, iframes, forms, and similar active elements are ignored so the output focuses on readable content.</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Runs in your browser</h2><p class="mt-3 text-slate-600">Bizzon does not upload or store the HTML you paste or open from a local file. The conversion happens locally on your device.</p></div>
  </section>
</ToolLayout>
