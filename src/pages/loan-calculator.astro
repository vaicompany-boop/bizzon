---
import LoanCalculator from '../components/LoanCalculator.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
---
<ToolLayout title="Loan Calculator — Estimate monthly loan payments | Bizzon" description="Free browser-based Loan Calculator by Bizzon. Estimate a fixed monthly payment, total repayment, and total interest from a loan amount, annual rate, and term." canonicalPath="/loan-calculator" heading="Loan Calculator" intro="Estimate monthly loan repayments and total interest from a loan amount, annual interest rate, and repayment term.">
  <LoanCalculator />
  <section class="mt-12 grid gap-6 md:grid-cols-3"><div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Simple payment estimate</h2><p class="mt-3 text-slate-600">See a monthly payment and total cost for a fixed-rate loan before comparing offers or planning a budget.</p></div><div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">No personal details</h2><p class="mt-3 text-slate-600">Calculations happen in your browser. Do not enter account numbers or sensitive financial information.</p></div><div class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-bold text-slate-950">Estimate only</h2><p class="mt-3 text-slate-600">Actual loans can include fees, insurance, changing rates, and lender-specific conditions not included here.</p></div></section>
  <section class="mt-10 rounded-[2rem] border border-blue-100 bg-blue-50 p-6 md:p-8"><h2 class="text-2xl font-black text-slate-950">Related tools</h2><p class="mt-4 text-slate-700">For rates and discounts, use the <a class="font-bold text-blue-700" href="/percentage-calculator">Percentage Calculator</a>. For tax estimates, try the <a class="font-bold text-blue-700" href="/vat-sales-tax-calculator">VAT Calculator</a>. Need an invoice after planning? Open <a class="font-bold text-blue-700" href="/invoice-maker">Invoice Maker</a>.</p></section>
</ToolLayout>
