---
import TextCleaner from '../components/TextCleaner.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
import ToolSeoSections from '../components/ToolSeoSections.astro';
---

<ToolLayout
  title="Text Cleaner — Remove extra spaces, empty lines, and messy formatting | Bizzon"
  description="Free browser-based Text Cleaner by Bizzon. Remove extra spaces, empty lines, tabs, smart quotes, and copy-paste clutter without uploading your text."
  canonicalPath="/text-cleaner"
  heading="Text Cleaner"
  intro="Clean messy pasted text instantly: fix extra spaces, remove empty lines, normalize smart quotes, and prepare text for publishing. Everything runs in your browser."
>
  <TextCleaner />
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Clean common clutter</h2>
      <p class="mt-3 text-slate-600">Fix extra spaces, tabs, empty lines, odd punctuation spacing, smart quotes, and long dash characters.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Private by default</h2>
      <p class="mt-3 text-slate-600">Your text stays in your browser. It is not sent to Bizzon or stored on a server.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-950">Useful for everyday writing</h2>
      <p class="mt-3 text-slate-600">Clean copy from PDFs, docs, emails, AI drafts, websites, forms, notes, and publishing tools.</p>
    </div>
  </section>
  <section class="mt-10 rounded-[2rem] border border-slate-200 bg-blue-50 p-6 md:p-8">
    <h2 class="text-2xl font-black text-slate-950">Related text tools</h2>
    <p class="mt-4 text-slate-700">Need counts after cleaning? Try the <a class="font-bold text-blue-700" href="/word-counter">Word Counter</a> or <a class="font-bold text-blue-700" href="/character-counter">Character Counter</a>. Need format changes? Use the <a class="font-bold text-blue-700" href="/case-converter">Case Converter</a>.</p>
  </section>
  <section class="mt-10 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm md:p-8">
    <p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-700">Cleanup examples</p>
    <h2 class="mt-3 text-2xl font-black text-slate-950">Text cleaner examples for pasted content</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <h3 class="font-bold text-slate-950">Clean PDF line breaks and email spacing</h3>
        <p class="mt-2 text-slate-700">Remove broken lines, repeated blank rows, tabs, doubled spaces, and punctuation spacing that often appears after copying from PDFs or email threads.</p>
      </div>
      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <h3 class="font-bold text-slate-950">Prepare AI drafts and CMS copy</h3>
        <p class="mt-2 text-slate-700">Normalize smart quotes, dashes, extra whitespace, and paragraph gaps before pasting content into a website editor, newsletter tool, or support document.</p>
      </div>
      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <h3 class="font-bold text-slate-950">Normalize whitespace before counting</h3>
        <p class="mt-2 text-slate-700">Clean text first, then check the result with <a class="font-bold text-blue-700" href="/word-counter">Word Counter</a> or <a class="font-bold text-blue-700" href="/character-counter">Character Counter</a> for more accurate publishing limits.</p>
      </div>
      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <h3 class="font-bold text-slate-950">Follow a repeatable cleanup workflow</h3>
        <p class="mt-2 text-slate-700">For step-by-step guidance, use the <a class="font-bold text-blue-700" href="/how-to-clean-pasted-text">How to Clean Pasted Text</a> guide before publishing important copy.</p>
      </div>
    </div>
  </section>
  <ToolSeoSections slug="text-cleaner" />
</ToolLayout>
